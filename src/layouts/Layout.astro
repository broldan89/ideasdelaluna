---
interface Props {
  title: string;
  pwa?: boolean;
}

const { title, pwa = false } = Astro.props;
import "../styles/global.css";
import GalleryModal from "../components/GalleryModal.astro";
---

<!doctype html>
<html lang="es" class="scroll-smooth overflow-x-hidden">
  <head>
    <!-- Google Tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-N7RNFFF620"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-N7RNFFF620');
</script>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Ideas de la Luna - Papelería y soluciones de impresión con alma."
    />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <link rel="icon" type="image/png" href="/logo.png" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="https://fonts.cdnfonts.com/css/moon-time" />
    {
      pwa && (
        <>
          <link rel="manifest" href="/manifest.webmanifest" />
          <meta name="theme-color" content="#4f46e5" />
          <meta name="apple-mobile-web-app-capable" content="yes" />
          <meta
            name="apple-mobile-web-app-status-bar-style"
            content="black-translucent"
          />
          <meta name="apple-mobile-web-app-title" content="Luna Admin" />
          <link rel="apple-touch-icon" href="/icon-192.png" />
          <style>
            html,
            body {
              overscroll-behavior-y: contain;
            }
          </style>
          <script is:inline>
            if ("serviceWorker" in navigator) {
              window.addEventListener("load", () => {
                navigator.serviceWorker
                  .register("/sw.js", { scope: "/admin/" })
                  .catch(() => {
                    // Si falla el registro, la app sigue funcionando normal, solo sin las mejoras offline
                  });
              });
            }
          </script>
        </>
      )
    }
  </head>

  <body
    class="fondo-pastel-animado min-h-screen relative w-full overflow-x-hidden text-slate-800 antialiased"
  >
    <slot />
    <GalleryModal />
  </body>
</html>

<style is:global>
  body {
    font-family: "Plus Jakarta Sans", sans-serif;
    position: relative;
    z-index: 0;
  }
  h1,
  h2,
  h3,
  .font-serif {
    font-family: "Playfair Display", serif;
  }

  /* ANIMACIÓN DE FONDOS PASTELES */
  @keyframes cambioPastel {
    0% {
      background-color: #fdf2f8; /* Rosa pastel */
    }
    33% {
      background-color: #f3e8ff; /* Lavanda pastel */
    }
    66% {
      background-color: #e0f2fe; /* Celeste pastel */
    }
    100% {
      background-color: #fdf2f8; /* Vuelve al Rosa pastel */
    }
  }

  .fondo-pastel-animado {
    animation: cambioPastel 14s ease-in-out infinite;
  }

  body,
  main {
    transition: background-color 1s ease-in-out;
  }

  /* TRAMA PUNTEADA UBICADA DETRÁS DEL CONTENIDO */
  body::before {
    content: "";
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-image: radial-gradient(
      rgba(99, 102, 241, 0.2) 1.5px,
      transparent 1.5px
    );
    background-size: 24px 24px;
    pointer-events: none;
    z-index: -1;
  }
</style>