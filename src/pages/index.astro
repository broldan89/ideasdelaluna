<script>
  // Modal de PDF
  const openBtn = document.getElementById("btn-open-pdf-modal");
  const closeBtn = document.getElementById("close-modal");
  const modal = document.getElementById("pdf-modal");

  if (openBtn && closeBtn && modal) {
    openBtn.addEventListener("click", (e) => {
      e.preventDefault();
      modal.classList.remove("hidden");
      modal.classList.add("flex");
    });

    closeBtn.addEventListener("click", () => {
      modal.classList.add("hidden");
      modal.classList.remove("flex");
    });

    modal.addEventListener("click", (e) => {
      if (e.target === modal) {
        modal.classList.add("hidden");
        modal.classList.remove("flex");
      }
    });
  }

  // Tracking events
  document.addEventListener("DOMContentLoaded", function () {
    const whatsappFooter = document.getElementById("footer-whatsapp-link");
    if (whatsappFooter) {
      whatsappFooter.addEventListener("click", function () {
        if (window.dataLayer) {
          window.dataLayer.push({
            event: "click_whatsapp_footer",
            link_location: "footer",
          });
        }
      });
    }

    const instagramFooter = document.getElementById("footer-instagram-link");
    if (instagramFooter) {
      instagramFooter.addEventListener("click", function () {
        if (window.dataLayer) {
          window.dataLayer.push({
            event: "click_instagram",
            link_location: "footer",
          });
        }
      });
    }

    const downloadPdf = document.getElementById("download-pdf-link");
    if (downloadPdf) {
      downloadPdf.addEventListener("click", function () {
        if (window.dataLayer) {
          window.dataLayer.push({
            event: "download_pdf_docente",
            file_name: "muestra-docente-ideas-de-la-luna.pdf",
            file_category: "docente",
          });
        }
      });
    }
  });
</script>

