---
import Layout from "../layouts/Layout.astro";
import TopBar from "../components/TopBar.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import Promociones from "../components/Promociones.astro";
import Cotizador from "../components/Cotizador.astro";
import ProductCard from "../components/ProductCard.astro";
import Faq from "../components/Faq.astro";
import GalleryModal from "../components/GalleryModal.astro";
---

<Layout title="Ideas de la Luna | Papelería de otro planeta">
  <TopBar />
  <Navbar />
  <Hero />

  <Promociones />

  <Cotizador />

  <main
    class="max-w-7xl mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-16 sm:space-y-24"
  >
    <section id="marcas" class="scroll-mt-24">
      <div class="max-w-xl mb-8">
        <h2 class="text-3xl font-normal text-indigo-950">
          El Universo <span class="italic text-indigo-600">Emprendedor</span>
        </h2>
        <p class="text-slate-500 text-sm mt-2 font-light">
          Packaging e identidad 100% personalizada para marcas que quieren dejar
          una huella imborrable al abrir sus cajas. Haz clic en la foto para ver
          las opciones disponibles.
        </p>
      </div>

      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6 w-full"
      >
        <ProductCard
          id="stickers"
          title="Stickers, Tags & QR's"
          description="Impresión por plancha A4 (mínimo 20 unidades). Papel fotográfico (200g), mate (260g) o papel filmilo resistente al agua. Corte troquelado listo para despegar."
          badge="100% Personalizado"
          imageSrc="/catalog/02_Mundo_Emprendedor/stickers_tags_qr/02_stickers_tags_qr_main.jpeg"
          hoverImageSrc="/catalog/02_Mundo_Emprendedor/stickers_tags_qr/02_stickers_tags_qr_galeria_01.jpeg"
          galleryImages={[
            "/catalog/02_Mundo_Emprendedor/stickers_tags_qr/02_stickers_tags_qr_main.jpeg",
            "/catalog/02_Mundo_Emprendedor/stickers_tags_qr/02_stickers_tags_qr_galeria_01.jpeg",
            "/catalog/02_Mundo_Emprendedor/stickers_tags_qr/02_stickers_tags_qr_galeria_02.jpeg",
            "/catalog/02_Mundo_Emprendedor/stickers_tags_qr/02_stickers_tags_qr_galeria_03.jpeg",
            "/catalog/02_Mundo_Emprendedor/stickers_tags_qr/02_stickers_tags_qr_galeria_04.jpeg",
            "/catalog/02_Mundo_Emprendedor/stickers_tags_qr/02_stickers_tags_qr_galeria_05.jpeg",
            "/catalog/02_Mundo_Emprendedor/stickers_tags_qr/02_stickers_tags_qr_galeria_06.jpeg",
            "/catalog/02_Mundo_Emprendedor/stickers_tags_qr/02_stickers_tags_qr_galeria_07.jpeg",
            "/catalog/02_Mundo_Emprendedor/stickers_tags_qr/02_stickers_tags_qr_galeria_08.jpeg",
          ]}
          subProducts={[
            {
              name: "Planchas de stickers con logo",
              desc: "Mínimo 20 unidades. La cantidad por plancha A4 depende del tamaño de tu diseño.",
            },
            {
              name: "Etiquetas con código QR",
              desc: "Listas para cobros por transferencia, Mercado Pago o redes sociales.",
            },
            {
              name: "Material Fílmico Waterproof",
              desc: "Resistente al agua y humedad, ideal para frascos, vasos o cosmética.",
            },
          ]}
        />

        <ProductCard
          id="tarjetas"
          title="Tarjetas Profesionales & Personales"
          description="Diseño 100% personalizado en medidas estándar (4x9 cm o 5x9 cm). Opción simple o doble faz en papel mate de excelente calidad y buen acabado."
          badge="Contacto"
          imageSrc="/catalog/02_Mundo_Emprendedor/tarjetas_profesionales/02_tarjetas_profecionales_main.jpeg"
          hoverImageSrc="/catalog/02_Mundo_Emprendedor/tarjetas_profesionales/02_tarjetas_profecionales_galeria_01.jpeg"
          galleryImages={[
            "/catalog/02_Mundo_Emprendedor/tarjetas_profesionales/02_tarjetas_profecionales_main.jpeg",
            "/catalog/02_Mundo_Emprendedor/tarjetas_profesionales/02_tarjetas_profecionales_galeria_01.jpeg",
            "/catalog/02_Mundo_Emprendedor/tarjetas_profesionales/02_tarjetas_profecionales_galeria_02.jpeg",
          ]}
          subProducts={[
            {
              name: "Tarjetas Estándar (4x9 cm / 5x9 cm)",
              desc: "Impresión simple o doble faz adaptada a tu identidad visual.",
            },
            {
              name: "Tarjetas de contacto corporativas",
              desc: "Presentación impecable con tus redes, datos de pago y QR.",
            },
            {
              name: "Tarjetas dobles desplegables",
              desc: "Mayor espacio para mostrar tus servicios o recomendaciones de uso.",
            },
          ]}
        />

        <ProductCard
          id="packaging"
          title="Packaging & Presentación de Marca"
          description="Detalles gráficos impresos para sellar y dar el toque final a tus paquetes antes de enviarlos."
          badge="Packaging"
          imageSrc="/catalog/02_Mundo_Emprendedor/packaging/02_packaging_main.jpeg"
          hoverImageSrc="/catalog/02_Mundo_Emprendedor/packaging/02_packaging_galeria_01.jpeg"
          galleryImages={[
            "/catalog/02_Mundo_Emprendedor/packaging/02_packaging_main.jpeg",
            "/catalog/02_Mundo_Emprendedor/packaging/02_packaging_galeria_01.jpeg",
            "/catalog/02_Mundo_Emprendedor/packaging/02_packaging_galeria_02.jpeg",
            "/catalog/02_Mundo_Emprendedor/packaging/02_packaging_galeria_03.jpeg",
            "/catalog/02_Mundo_Emprendedor/packaging/02_packaging_galeria_04.jpeg",
            "/catalog/02_Mundo_Emprendedor/packaging/02_packaging_galeria_05.jpeg",
          ]}
          subProducts={[
            {
              name: "Stickers cierrabolsas",
              desc: "Formatos rectangulares o circulares para asegurar tus envíos.",
            },
            {
              name: "Fajas térmicas para vasos",
              desc: "Sleeves en papel de 300g personalizables para vasos de café o bebidas.",
            },
            {
              name: "Tarjetas e instructivos (10x15 cm)",
              desc: "Agradecimientos, recomendaciones de uso o enlaces QR a tu catálogo.",
            },
            {
              name: "Tags y etiquetas colgantes",
              desc: "Con perforación para atar a prendas, regalos o packaging de autor.",
            },
          ]}
        />

        <ProductCard
          id="fidelizacion"
          title="Fidelización & Gift Cards"
          description="Tarjetas impresas 100% personalizadas en papel pesado diseñadas para premiar la lealtad e incentivar la recompra."
          badge="Clientes"
          imageSrc="/catalog/02_Mundo_Emprendedor/fidelizacion/02_fidelizacion_main.jpeg"
          hoverImageSrc="/catalog/02_Mundo_Emprendedor/fidelizacion/02_fidelizacion_galeria_01.jpeg"
          galleryImages={[
            "/catalog/02_Mundo_Emprendedor/fidelizacion/02_fidelizacion_main.jpeg",
            "/catalog/02_Mundo_Emprendedor/fidelizacion/02_fidelizacion_galeria_01.jpeg",
          ]}
          subProducts={[
            {
              name: "Tarjetas 'Gracias por tu compra' (5x5 cm)",
              desc: "Mensajes cálidos y recomendaciones impresas en formato cuadrado estándar.",
            },
            {
              name: "Tarjetas de fidelización",
              desc: "Sistema impreso de puntos o sellos simple o doble faz para premiar clientes.",
            },
            {
              name: "Gift Cards impresas",
              desc: "Tarjetas de regalo personalizadas con montos o servicios.",
            },
            {
              name: "Tarjetas de felicitaciones & días de celebración",
              desc: "Diseños especiales para fechas festivas, cumpleaños y reconocimientos.",
            },
          ]}
        />

        <ProductCard
          id="folleteria"
          title="Folletería & Material Promocional"
          description="Volantes, flyers y folletos impresos en alta calidad para difundir tus promociones o catálogo de servicios."
          badge="Difusión"
          imageSrc="/catalog/02_Mundo_Emprendedor/folleteria_papelería/02_folleteria_papeleria_main.jpeg"
          hoverImageSrc="/catalog/02_Mundo_Emprendedor/folleteria_papelería/02_folleteria_papeleria_galeria_01.jpeg"
          galleryImages={[
            "/catalog/02_Mundo_Emprendedor/folleteria_papelería/02_folleteria_papeleria_main.jpeg",
            "/catalog/02_Mundo_Emprendedor/folleteria_papelería/02_papeleria_folleteria_main.jpeg",
            "/catalog/02_Mundo_Emprendedor/folleteria_papelería/02_folleteria_papeleria_galeria_01.jpeg",
            "/catalog/02_Mundo_Emprendedor/folleteria_papelería/02_folleteria_papeleria_galeria_02.jpeg",
            "/catalog/02_Mundo_Emprendedor/folleteria_papelería/02_folleteria_papeleria_galeria_03.jpeg",
          ]}
          subProducts={[
            {
              name: "Flyers A6 / A5 promocionales",
              desc: "Formatos ideales para incluir en cada entrega o repartir.",
            },
            {
              name: "Volantes informativos",
              desc: "Papel liviano o pesado según la necesidad del proyecto.",
            },
            {
              name: "Cartas o menús desplegables",
              desc: "Para locales gastronómicos, servicios o catálogos impresos.",
            },
            {
              name: "Menús con QR o laminados",
              desc: "Opciones digitales con QR o totalmente impresos y laminados para mayor protección.",
            },
          ]}
        />
      </div>
    </section>

    <section
      id="docentes"
      class="scroll-mt-24 p-6 sm:p-12 rounded-3xl bg-gradient-to-br from-slate-950 via-indigo-950 to-slate-900 text-white shadow-2xl relative overflow-hidden border border-indigo-500/20"
    >
      <div
        class="absolute -right-20 -bottom-20 w-80 h-80 bg-purple-500/15 rounded-full blur-3xl pointer-events-none"
      >
      </div>
      <div
        class="absolute -left-20 -top-20 w-80 h-80 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"
      >
      </div>

      <div class="max-w-2xl mb-8 sm:mb-12 relative z-10">
        <span
          class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-widest px-3.5 py-1 rounded-full bg-amber-400/10 text-amber-300 border border-amber-400/30 mb-3 shadow-inner"
        >
          <span>✨</span> Espacio Exclusivo
        </span>
        <h2
          class="text-3xl sm:text-4xl font-serif font-normal text-white tracking-wide"
        >
          Órbita <span class="italic text-amber-300">Docente</span>
        </h2>
        <p class="text-indigo-200/80 text-sm mt-3 font-light leading-relaxed">
          Diseñado con amor para maestras y educadores. Herramientas físicas e
          imprimibles en PDF para organizar el aula, calificar con ternura e
          inspirar todos los días.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 relative z-10 w-full">
        <div
          class="bg-white/10 backdrop-blur-md rounded-2xl p-4 border border-white/15 hover:border-amber-300/40 transition-all duration-300 flex flex-col justify-between group hover:-translate-y-1 shadow-lg"
        >
          <div>
            <div class="relative overflow-hidden rounded-xl aspect-[4/3] mb-4">
              <span
                class="absolute top-2.5 left-2.5 z-10 text-[10px] font-bold uppercase tracking-wider bg-black/60 backdrop-blur-md text-amber-300 px-2.5 py-1 rounded-md border border-amber-300/20"
              >
                Impreso
              </span>
              <img
                src="/catalog/05_Orbita_Docente/planner_diplomas_agendas/05_planners_diplomas_agendas_main.jpeg"
                alt="Planificadores"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </div>
            <h3 class="text-lg font-serif font-medium text-white mb-2">
              Planificadores & Agendas
            </h3>
            <p
              class="text-indigo-200/70 text-xs font-light leading-relaxed mb-4"
            >
              Organización integral con asistencia, notas y grilla de clases.
              Tapa dura personalizada.
            </p>
          </div>
          <a
            href="#contacto"
            class="w-full text-center py-2.5 px-4 rounded-xl bg-amber-300/10 hover:bg-amber-300/20 text-amber-300 border border-amber-300/30 text-xs font-semibold tracking-wider uppercase transition-all"
          >
            Cotizar esta línea
          </a>
        </div>

        <div
          class="bg-white/10 backdrop-blur-md rounded-2xl p-4 border border-white/15 hover:border-amber-300/40 transition-all duration-300 flex flex-col justify-between group hover:-translate-y-1 shadow-lg"
        >
          <div>
            <div class="relative overflow-hidden rounded-xl aspect-[4/3] mb-4">
              <span
                class="absolute top-2.5 left-2.5 z-10 text-[10px] font-bold uppercase tracking-wider bg-black/60 backdrop-blur-md text-amber-300 px-2.5 py-1 rounded-md border border-amber-300/20"
              >
                Impreso
              </span>
              <img
                src="/catalog/05_Orbita_Docente/stickers/05_stickers_main.jpeg"
                alt="Stickers motivacionales"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </div>
            <h3 class="text-lg font-serif font-medium text-white mb-2">
              Stickers Motivacionales
            </h3>
            <p
              class="text-indigo-200/70 text-xs font-light leading-relaxed mb-4"
            >
              Planchas A4 impresas con mensajes hermosos para evaluar cuadernos
              con ternura.
            </p>
          </div>
          <a
            href="#contacto"
            class="w-full text-center py-2.5 px-4 rounded-xl bg-amber-300/10 hover:bg-amber-300/20 text-amber-300 border border-amber-300/30 text-xs font-semibold tracking-wider uppercase transition-all"
          >
            Cotizar esta línea
          </a>
        </div>

        <div
          class="bg-white/10 backdrop-blur-md rounded-2xl p-4 border border-white/15 hover:border-amber-300/40 transition-all duration-300 flex flex-col justify-between group hover:-translate-y-1 shadow-lg"
        >
          <div>
            <div class="relative overflow-hidden rounded-xl aspect-[4/3] mb-4">
              <div class="absolute top-2.5 left-2.5 z-10 flex flex-col gap-1.5">
                <span
                  class="text-[10px] font-bold uppercase tracking-wider bg-amber-400 text-slate-950 px-2.5 py-1 rounded-md"
                >
                  ⚡ Descarga PDF
                </span>
              </div>
              <img
                src="/catalog/05_Orbita_Docente/planner_diplomas_agendas/05_planners_diplomas_agendas_galeria_01.jpeg"
                alt="Recursos PDF"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-90"
              />
            </div>

            <h3 class="text-lg font-serif font-medium text-white mb-2">
              Recursos Digitales en PDF
            </h3>
            <p
              class="text-indigo-200/70 text-xs font-light leading-relaxed mb-4"
            >
              Archivos listos para descargar e imprimir. Efemérides, carteles de
              aula y fichas por grado.
            </p>
          </div>

          <button
            id="btn-open-pdf-modal"
            type="button"
            class="w-full text-center py-2.5 px-4 rounded-xl bg-amber-300/20 hover:bg-amber-300/30 text-amber-300 border border-amber-300/40 text-xs font-semibold tracking-wider uppercase transition-all cursor-pointer shadow-md"
          >
            <span>⚡</span> Ver Recursos PDF
          </button>
        </div>
      </div>
    </section>

    <section id="eventos" class="scroll-mt-24">
      <div class="max-w-xl mb-8">
        <h2 class="text-3xl font-normal text-indigo-950">
          Fases de <span class="italic text-indigo-600">Celebración</span>
        </h2>
        <p class="text-slate-500 text-sm mt-2 font-light">
          Papelería fina y detalles completamente personalizados para eventos
          que merecen ser recordados para siempre.
        </p>
      </div>

      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6 w-full"
      >
        <ProductCard
          id="souvenirs"
          title="Souvenirs"
          description="Pequeños complementos que hacen la diferencia: indicadores de sitio, menús impresos y tarjetas de recuerdo."
          badge="Eventos"
          imageSrc="/catalog/03_Fases_de_Celebracion/souvenirs/03_souvenirs_main.jpeg"
          hoverImageSrc="/catalog/03_Fases_de_Celebracion/souvenirs/03_souvenirs_galeria_01.jpeg"
          galleryImages={[
            "/catalog/03_Fases_de_Celebracion/souvenirs/03_souvenirs_main.jpeg",
            "/catalog/03_Fases_de_Celebracion/souvenirs/03_souvenirs_galeria_01.jpeg",
            "/catalog/03_Fases_de_Celebracion/souvenirs/03_souvenirs_galeria_02.jpeg",
          ]}
        />

        <ProductCard
          id="candybar"
          title="Candy Bar Temático"
          description="Kits de papelería para mesas dulces de cumpleaños, XV años y eventos. Diseños 100% a medida con los personajes o temática que elijas."
          badge="Popular"
          imageSrc="/catalog/03_Fases_de_Celebracion/candy_bar/03_candy_bar_main.jpeg"
          hoverImageSrc="/catalog/03_Fases_de_Celebracion/candy_bar/03_candy_bar_galeria_01.jpeg"
          galleryImages={[
            "/catalog/03_Fases_de_Celebracion/candy_bar/03_candy_bar_main.jpeg",
            "/catalog/03_Fases_de_Celebracion/candy_bar/03_candy_bar_galeria_01.jpeg",
            "/catalog/03_Fases_de_Celebracion/candy_bar/03_candy_bar_galeria_02.jpeg",
            "/catalog/03_Fases_de_Celebracion/candy_bar/03_candy_bar_galeria_03.jpeg",
          ]}
          subProducts={[
            {
              name: "Cajitas y Bolsitas golosineras",
              desc: "Formatos tipo milkbox, pochocleras o caladas para sorpresas y golosinas.",
            },
            {
              name: "Envoltorios y fajas personalizadas",
              desc: "Vestimos turrones, chocolates, alfajores, moneditas y jugos con la gráfica del evento.",
            },
            {
              name: "Cartelería y Banderines de mesa",
              desc: "Toppers para torta, nombres en relieve y cartelitos identificadores para la mesa dulce.",
            },
            {
              name: "Diseños y combos a pedido",
              desc: "¡Las opciones son infinitas! Consultanos con la temática de tu fiesta para cotizar tu kit ideal.",
            },
          ]}
        />

        <ProductCard
          id="papeleria-eventos"
          title="Papelería Especial para Eventos"
          description="Detalles impresos para ambientar y organizar las mesas de tu fiesta o evento corporativo con la mejor presentación."
          badge="Elegante"
          imageSrc="/catalog/03_Fases_de_Celebracion/papeleria_eventos/03_paperleria_eventos_main.jpeg"
          hoverImageSrc="/catalog/03_Fases_de_Celebracion/papeleria_eventos/03_papeleria_eventos_galeria_01.jpeg"
          galleryImages={[
            "/catalog/03_Fases_de_Celebracion/papeleria_eventos/03_paperleria_eventos_main.jpeg",
            "/catalog/03_Fases_de_Celebracion/papeleria_eventos/03_papeleria_eventos_galeria_01.jpeg",
            "/catalog/03_Fases_de_Celebracion/papeleria_eventos/03_papeleria_eventos_galeria_02.jpeg",
          ]}
          subProducts={[
            {
              name: "Menúes y Cartas individuales",
              desc: "Impresos en papeles especiales, vegetal o kraft para cada comensal o centro de mesa.",
            },
            {
              name: "Numeradores y Carteles QR",
              desc: "Identificadores de mesa, códigos para fotos colectivas o transferencia de regalos.",
            },
            {
              name: "Fajas para servilletas y cubiertos",
              desc: "Detalles personalizados para envolver la cubertería y servilleteros temáticos.",
            },
            {
              name: "Bandejas y Papelería de recepción",
              desc: "Bandejitas impresas para souvenir, cartel de bienvenida y seating chart.",
            },
          ]}
        />

        <ProductCard
          id="deco-eventos"
          title="Deco para Eventos"
          description="Guirnaldas, banderines y cartelería modular en formato A4. Todo lo necesario para vestir paredes y espacios con la identidad de tu festejo."
          badge="Tendencia"
          imageSrc="/catalog/03_Fases_de_Celebracion/deco_eventos/03_deco_eventos_main.jpeg"
          hoverImageSrc="/catalog/03_Fases_de_Celebracion/deco_eventos/03_deco_eventos_gakeria_01.jpeg"
          galleryImages={[
            "/catalog/03_Fases_de_Celebracion/deco_eventos/03_deco_eventos_main.jpeg",
            "/catalog/03_Fases_de_Celebracion/deco_eventos/03_deco_eventos_gakeria_01.jpeg",
            "/catalog/03_Fases_de_Celebracion/deco_eventos/03_deco_eventos_galeria_02.jpeg",
            "/catalog/03_Fases_de_Celebracion/deco_eventos/03_deco_eventos_galeria_03.jpeg",
            "/catalog/03_Fases_de_Celebracion/deco_eventos/03_deco_eventos_galeria_04.jpeg",
            "/catalog/03_Fases_de_Celebracion/deco_eventos/03_decp_eventos_galeria_05.jpeg",
          ]}
          subProducts={[
            {
              name: "Banderines y Guirnaldas",
              desc: "Cartelera 'Feliz Cumple', nombres o frases compuestas letra por letra en papel de alto gramaje.",
            },
            {
              name: "Stickers cierrabolsas temáticos",
              desc: "Adhesivos personalizados para cerrar las bolsitas de souvenirs o regalitos.",
            },
            {
              name: "Cartelería y Propagandas de pared",
              desc: "Pósters e ilustraciones en A4 para enmarcar, pegar o usar como fondo en la mesa principal.",
            },
            {
              name: "Carteles modulares ensamblables",
              desc: "Diseños divididos en varias hojas A4 que se unen fácilmente para formar carteles más grandes.",
            },
          ]}
        />
      </div>
    </section>

    <section id="tienda" class="scroll-mt-24 mb-12">
      <div class="max-w-xl mb-8">
        <h2 class="text-3xl font-normal text-indigo-950">
          La Tienda de la <span class="italic text-indigo-600">Luna</span>
        </h2>
        <p class="text-slate-500 text-sm mt-2 font-light">
          Nuestra línea exclusiva de papelería de diseño hecha a mano. Productos
          listos para usar, regalar o personalizar según tu estilo e ideas.
        </p>
      </div>

      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6 w-full"
      >
        <ProductCard
          id="cuadernos-journals"
          title="Encuadernación & Journals"
          description="Cuadernos artesanales y bitácoras con tapa dura laminada. Hojas punteadas, rayadas, lisas o temáticas para cada proyecto."
          badge="Línea Propia"
          imageSrc="/catalog/04_La_Tienda_de_la_Luna/cuadernos_journals/04_cuadernos_jounals_main.jpeg"
          hoverImageSrc="/catalog/04_La_Tienda_de_la_Luna/cuadernos_journals/04_cuadernos_journals_galeria_01.jpeg"
          galleryImages={[
            "/catalog/04_La_Tienda_de_la_Luna/cuadernos_journals/04_cuadernos_jounals_main.jpeg",
