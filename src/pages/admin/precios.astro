---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Precios del Cotizador | Ideas de la Luna" pwa={true}>
  <div
    class="sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-indigo-50 pt-[env(safe-area-inset-top)]"
  >
    <div class="max-w-3xl mx-auto px-4 py-4 flex items-center justify-between">
      <div>
        <span
          class="text-[10px] sm:text-xs font-semibold tracking-widest text-indigo-600 uppercase bg-indigo-50 px-2.5 py-1 rounded-full"
        >
          Panel privado
        </span>
        <h1
          class="text-xl sm:text-3xl font-serif text-indigo-950 font-medium mt-2 sm:mt-3"
        >
          Precios del Cotizador
        </h1>
      </div>
      <a
        href="/admin"
        class="text-xs font-medium text-slate-500 hover:text-indigo-600 active:scale-95 border border-slate-200 hover:border-indigo-300 rounded-full px-3 sm:px-4 py-2 transition-all"
      >
        ← Volver
      </a>
    </div>
  </div>

  <section class="max-w-3xl mx-auto px-4 py-6 sm:py-10 pb-28 sm:pb-16">
    <p class="text-sm text-slate-500 mb-6">
      Cambiá cualquier precio y guardalo — el cotizador de la página principal
      lo va a usar al instante, sin necesidad de tocar código ni de esperar un
      redeploy.
    </p>

    <!-- BARRA DE BÚSQUEDA Y FILTROS -->
    <div class="mb-6 space-y-3">
      <div class="relative">
        <input
          type="text"
          id="buscadorPrecios"
          placeholder="🔍 Buscar por concepto..."
          class="w-full px-4 py-2.5 pl-10 border border-indigo-100 rounded-xl focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 text-sm transition-all bg-white"
        />
        <svg
          class="absolute left-3 top-3 w-4 h-4 text-slate-400"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </div>

      <div class="flex flex-wrap gap-2">
        <button
          class="filtro-btn active px-3 py-1.5 text-xs font-medium rounded-full bg-indigo-600 text-white hover:bg-indigo-700 transition-all"
          data-filtro="todos"
        >
          Todos
        </button>
        <button
          class="filtro-btn px-3 py-1.5 text-xs font-medium rounded-full bg-slate-100 text-slate-600 hover:bg-indigo-100 hover:text-indigo-700 transition-all"
          data-filtro="simple"
        >
          Simple Faz
        </button>
        <button
          class="filtro-btn px-3 py-1.5 text-xs font-medium rounded-full bg-slate-100 text-slate-600 hover:bg-indigo-100 hover:text-indigo-700 transition-all"
          data-filtro="doble"
        >
          Doble Faz
        </button>
        <button
          class="filtro-btn px-3 py-1.5 text-xs font-medium rounded-full bg-slate-100 text-slate-600 hover:bg-indigo-100 hover:text-indigo-700 transition-all"
          data-filtro="anillado"
        >
          Anillado
        </button>
        <button
          class="filtro-btn px-3 py-1.5 text-xs font-medium rounded-full bg-slate-100 text-slate-600 hover:bg-indigo-100 hover:text-indigo-700 transition-all"
          data-filtro="papel"
        >
          Papeles
        </button>
      </div>

      <!-- Indicador de filtro activo -->
      <div class="text-xs text-slate-400 mt-2 flex items-center gap-3">
        <span
          >Mostrando: <span
            id="filtroActivoTexto"
            class="font-medium text-indigo-600">todos los precios</span
          ></span
        >
        <span id="resultadosCount" class="text-slate-400"></span>
      </div>
    </div>

    <p id="cargando" class="text-sm text-slate-500">Cargando precios...</p>

    <!-- CONTENEDOR DE TABLAS -->
    <div id="grupos" class="space-y-6 hidden"></div>

    <div id="seccionPapeles" class="mt-10 hidden">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h2 class="font-serif text-lg text-indigo-950 font-medium">
            Papeles
          </h2>
          <p class="text-xs text-slate-400">
            "Obra" es el papel estándar y usa los tramos por cantidad de hojas.
            Los demás tienen un precio fijo propio por hoja.
          </p>
        </div>
        <button
          id="btnNuevoPapel"
          class="shrink-0 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium px-4 py-2 rounded-lg transition-all active:scale-95"
        >
          + Nuevo papel
        </button>
      </div>
      <div id="listaPapeles" class="overflow-x-auto"></div>
    </div>
  </section>

  <!-- MODAL PARA NUEVO PAPEL -->
  <div
    id="modalNuevoPapel"
    class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 hidden p-4"
  >
    <div
      class="bg-white rounded-2xl p-6 max-w-md w-full mx-auto shadow-2xl max-h-[90vh] overflow-y-auto"
    >
      <div class="flex items-center justify-between mb-4">
        <h3 class="font-serif text-lg text-indigo-950 font-medium">
          Agregar nuevo papel
        </h3>
        <button
          id="modalCerrar"
          class="text-slate-400 hover:text-slate-600 transition-colors"
        >
          <svg
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <form id="modalForm" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1"
            >Nombre del papel *</label
          >
          <input
            type="text"
            id="modalNombre"
            placeholder="ej: Papel Ilustración"
            class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 transition-all"
            required
          />
        </div>

        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1"
            >Gramaje</label
          >
          <input
            type="text"
            id="modalGramaje"
            placeholder="ej: 300g"
            class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 transition-all"
          />
        </div>

        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1"
            >Código *</label
          >
          <input
            type="text"
            id="modalCodigo"
            placeholder="ej: ILU-300"
            class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 transition-all"
            required
          />
          <p class="text-[10px] text-slate-400 mt-1">
            Usá un código único para identificar este papel
          </p>
        </div>

        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1"
            >Precio por hoja ($) *</label
          >
          <input
            type="number"
            step="0.01"
            id="modalPrecio"
            placeholder="0.00"
            class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 transition-all"
            required
          />
        </div>

        <div class="flex items-center gap-2 pt-2">
          <input
            type="checkbox"
            id="modalEstandar"
            class="w-4 h-4 text-indigo-600 border-slate-300 rounded focus:ring-indigo-500"
          />
          <label for="modalEstandar" class="text-sm text-slate-700">
            Es papel estándar (usa tramos por cantidad)
          </label>
        </div>

        <div class="flex gap-2 pt-4 border-t border-slate-100">
          <button
            type="submit"
            class="flex-1 bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2.5 rounded-lg text-sm font-medium transition-all active:scale-95"
          >
            Agregar papel
          </button>
          <button
            type="button"
            id="modalCancelar"
            class="flex-1 bg-slate-100 hover:bg-slate-200 text-slate-600 px-4 py-2.5 rounded-lg text-sm font-medium transition-all active:scale-95"
          >
            Cancelar
          </button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<style>
  .precio-card {
    background: white;
    border: 1px solid rgba(99, 102, 241, 0.08);
    border-radius: 1rem;
    padding: 1rem;
  }

  /* Animación del modal */
  #modalNuevoPapel:not(.hidden) {
    animation: fadeIn 0.2s ease-out;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: scale(0.95);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* Scrollbar personalizada para la tabla */
  .overflow-x-auto::-webkit-scrollbar {
    height: 6px;
  }

  .overflow-x-auto::-webkit-scrollbar-track {
    background: #f1f5f9;
    border-radius: 3px;
  }

  .overflow-x-auto::-webkit-scrollbar-thumb {
    background: #c7d2fe;
    border-radius: 3px;
  }

  .overflow-x-auto::-webkit-scrollbar-thumb:hover {
    background: #818cf8;
  }

  /* Transición suave para ocultar/mostrar */
  .grupo-tabla,
  #seccionPapeles {
    transition: opacity 0.2s ease;
  }
</style>

<script>
  // @ts-nocheck
  import { supabase } from "../../lib/supabase.js";

  const GRUPOS = [
    {
      titulo: "Simple Faz — Blanco y Negro",
      claves: ["simple_bn_base", "simple_bn_medio", "simple_bn_alto"],
    },
    {
      titulo: "Simple Faz — Color",
      claves: ["simple_color_base", "simple_color_medio", "simple_color_alto"],
    },
    {
      titulo: "Doble Faz — Blanco y Negro",
      claves: ["doble_bn_base", "doble_bn_medio", "doble_bn_alto"],
    },
    {
      titulo: "Doble Faz — Color",
      claves: ["doble_color_base", "doble_color_medio", "doble_color_alto"],
    },
    {
      titulo: "Anillado",
      claves: ["anillado_base", "anillado_bulk"],
    },
  ];

  let precios = [];
  let papeles = [];

  // FUNCIÓN PARA APLICAR FILTROS - CORREGIDA
  function aplicarFiltros() {
    const termino =
      document.getElementById("buscadorPrecios")?.value?.toLowerCase() || "";
    const filtroActivo =
      document.querySelector(".filtro-btn.active")?.dataset?.filtro || "todos";

    // 1. FILTRAR GRUPOS DE PRECIOS
    document.querySelectorAll(".grupo-tabla").forEach((grupo) => {
      const filtroGrupo = grupo.dataset.filtro || "todos";

      // Determinar si mostrar este grupo
      let mostrarGrupo = false;

      if (filtroActivo === "todos") {
        mostrarGrupo = true;
      } else if (filtroActivo === "papel") {
        mostrarGrupo = false; // Los grupos no se muestran cuando filtramos por papel
      } else {
        mostrarGrupo = filtroActivo === filtroGrupo;
      }

      if (!mostrarGrupo) {
        grupo.style.display = "none";
        return;
      }

      // Filtrar filas dentro del grupo (búsqueda)
      let filasVisibles = 0;
      grupo.querySelectorAll(".precio-fila").forEach((fila) => {
        const descripcion = fila.dataset.descripcion || "";
        const coincide = descripcion.includes(termino);
        fila.style.display = coincide ? "" : "none";
        if (coincide) filasVisibles++;
      });

      // Ocultar grupo si no tiene filas visibles
      grupo.style.display = filasVisibles > 0 ? "" : "none";
    });

    // 2. FILTRAR SECCIÓN DE PAPELES
    const seccionPapeles = document.getElementById("seccionPapeles");
    if (seccionPapeles) {
      const mostrarPapeles =
        filtroActivo === "todos" || filtroActivo === "papel";
      seccionPapeles.style.display = mostrarPapeles ? "" : "none";

      if (mostrarPapeles && termino) {
        // Aplicar búsqueda en papeles
        document.querySelectorAll(".papel-fila").forEach((fila) => {
          const nombre = fila.dataset.nombre || "";
          const coincide = nombre.includes(termino);
          fila.style.display = coincide ? "" : "none";
        });
      } else if (mostrarPapeles) {
        // Mostrar todas las filas de papeles
        document.querySelectorAll(".papel-fila").forEach((fila) => {
          fila.style.display = "";
        });
      }
    }

    // 3. ACTUALIZAR INDICADORES
    const textoFiltro = document.getElementById("filtroActivoTexto");
    const textos = {
      todos: "todos los precios",
      simple: "precios de Simple Faz",
      doble: "precios de Doble Faz",
      anillado: "precios de Anillado",
      papel: "papeles disponibles",
    };
    if (textoFiltro) {
      textoFiltro.textContent = textos[filtroActivo] || "todos los precios";
    }

    // Contar resultados visibles
    const filasOcultas = document.querySelectorAll(
      '.precio-fila[style*="display: none"]',
    ).length;
    const totalFilas = document.querySelectorAll(".precio-fila").length;
    const countEl = document.getElementById("resultadosCount");
    if (countEl && totalFilas > 0) {
      const visibles = totalFilas - filasOcultas;
      countEl.textContent = `(${visibles} de ${totalFilas} conceptos)`;
    } else if (countEl) {
      countEl.textContent = "";
    }
  }

  function renderGrupos() {
    const cont = document.getElementById("grupos");

    cont.innerHTML = GRUPOS.map((grupo) => {
      const filas = grupo.claves
        .map((clave) => precios.find((p) => p.clave === clave))
        .filter(Boolean);

      if (filas.length === 0) return "";

      // ASIGNAR FILTRO CORRECTO
      let filtroTipo = "todos";
      const tituloLower = grupo.titulo.toLowerCase();
      if (tituloLower.includes("simple")) filtroTipo = "simple";
      else if (tituloLower.includes("doble")) filtroTipo = "doble";
      else if (tituloLower.includes("anillado")) filtroTipo = "anillado";

      return `
        <div class="grupo-tabla bg-white rounded-xl shadow-sm border border-indigo-50/50 overflow-hidden" data-filtro="${filtroTipo}">
          <div class="px-4 py-3 bg-gradient-to-r from-indigo-50 to-white border-b border-indigo-50">
            <h2 class="font-serif text-lg text-indigo-950 font-medium">${grupo.titulo}</h2>
          </div>
          <div class="p-4 overflow-x-auto">
            <table class="w-full min-w-[300px]">
              <thead>
                <tr class="border-b-2 border-indigo-100">
                  <th class="text-left text-xs font-medium text-indigo-600 py-2">Concepto</th>
                  <th class="text-right text-xs font-medium text-indigo-600 py-2">Precio</th>
                  <th class="w-16"></th>
                </tr>
              </thead>
              <tbody>
                ${filas
                  .map(
                    (p) => `
                  <tr class="border-b border-slate-50 hover:bg-indigo-50/30 transition-colors precio-fila" data-clave="${p.clave}" data-descripcion="${p.descripcion.toLowerCase()}">
                    <td class="py-2.5 text-sm text-indigo-950">${p.descripcion}</td>
                    <td class="py-2.5">
                      <div class="flex items-center justify-end gap-2">
                        <span class="text-slate-400 text-sm">$</span>
                        <input
                          type="number"
                          min="0"
                          step="1"
                          class="input-precio w-24 bg-transparent border-b-2 border-transparent hover:border-indigo-200 focus:border-indigo-500 text-indigo-950 text-sm p-1 text-right focus:outline-none transition-all"
                          value="${p.precio}"
                        />
                      </div>
                    </td>
                    <td class="py-2.5">
                      <span class="guardado-ok hidden text-xs text-emerald-600 font-medium">✓</span>
                    </td>
                  </tr>
                `,
                  )
                  .join("")}
              </tbody>
            </table>
          </div>
        </div>
      `;
    }).join("");

    // Event listeners para inputs de precios
    document.querySelectorAll("[data-clave]").forEach((row) => {
      const clave = row.getAttribute("data-clave");
      const input = row.querySelector(".input-precio");
      const guardadoOk = row.querySelector(".guardado-ok");

      const guardar = async () => {
        const nuevoPrecio = parseFloat(input.value);
        if (isNaN(nuevoPrecio) || nuevoPrecio < 0) return;

        const { error } = await supabase
          .from("precios_cotizador")
          .update({ precio: nuevoPrecio, updated_at: new Date().toISOString() })
          .eq("clave", clave);

        if (error) {
          alert(`No se pudo guardar el precio: ${error.message}`);
          return;
        }

        const precioLocal = precios.find((p) => p.clave === clave);
        if (precioLocal) precioLocal.precio = nuevoPrecio;

        guardadoOk.classList.remove("hidden");
        setTimeout(() => guardadoOk.classList.add("hidden"), 1500);
      };

      input.addEventListener("blur", guardar);
      input.addEventListener("keydown", (e) => {
        if (e.key === "Enter") input.blur();
      });
    });

    // Aplicar filtros después de renderizar
    aplicarFiltros();
  }

  function renderPapeles() {
    const cont = document.getElementById("listaPapeles");

    if (!papeles || papeles.length === 0) {
      cont.innerHTML = `
        <div class="bg-white rounded-xl shadow-sm border border-indigo-50/50 p-8 text-center">
          <p class="text-sm text-slate-500">No hay papeles cargados.</p>
          <p class="text-xs text-slate-400 mt-1">Hacé clic en "Nuevo papel" para agregar uno.</p>
        </div>
      `;
      return;
    }

    cont.innerHTML = `
      <table class="w-full min-w-[500px] bg-white rounded-xl shadow-sm border border-indigo-50/50 overflow-hidden">
        <thead>
          <tr class="bg-gradient-to-r from-indigo-50 to-white border-b border-indigo-50">
            <th class="text-left text-xs font-medium text-indigo-600 py-3 px-4">Papel</th>
            <th class="text-left text-xs font-medium text-indigo-600 py-3 px-4">Gramaje</th>
            <th class="text-center text-xs font-medium text-indigo-600 py-3 px-4">Tipo</th>
            <th class="text-right text-xs font-medium text-indigo-600 py-3 px-4">Precio por hoja</th>
            <th class="w-16"></th>
          </tr>
        </thead>
        <tbody>
          ${papeles
            .map(
              (p) => `
            <tr class="border-b border-slate-50 hover:bg-indigo-50/30 transition-colors papel-fila" data-codigo="${p.codigo}" data-nombre="${p.nombre.toLowerCase()}">
              <td class="py-2.5 px-4 text-sm text-indigo-950 font-medium">${p.nombre}</td>
              <td class="py-2.5 px-4 text-sm text-slate-500">${p.gramaje || "-"}</td>
              <td class="py-2.5 px-4 text-center">
                ${
                  p.es_estandar
                    ? '<span class="text-[10px] font-semibold uppercase tracking-wider text-indigo-600 bg-indigo-50 rounded-full px-2 py-0.5">Estándar</span>'
                    : '<span class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">Precio fijo</span>'
                }
              </td>
              <td class="py-2.5 px-4">
                <div class="flex items-center justify-end gap-2">
                  <span class="text-slate-400 text-sm">$</span>
                  <input
                    type="number"
                    min="0"
                    step="0.01"
                    class="input-papel w-24 bg-transparent border-b-2 border-transparent hover:border-indigo-200 focus:border-indigo-500 text-indigo-950 text-sm p-1 text-right focus:outline-none transition-all"
                    value="${p.precio_hoja}"
                  />
                </div>
              </td>
              <td class="py-2.5 px-4">
                <span class="guardado-ok hidden text-xs text-emerald-600 font-medium">✓</span>
              </td>
            </tr>
          `,
            )
            .join("")}
        </tbody>
      </table>
    `;

    // Event listeners para inputs de papeles
    document.querySelectorAll("[data-codigo]").forEach((row) => {
      const codigo = row.getAttribute("data-codigo");
      const input = row.querySelector(".input-papel");
      const guardadoOk = row.querySelector(".guardado-ok");

      const guardar = async () => {
        const nuevoPrecio = parseFloat(input.value);
        if (isNaN(nuevoPrecio) || nuevoPrecio < 0) return;

        const { error } = await supabase
          .from("papeles_cotizador")
          .update({
            precio_hoja: nuevoPrecio,
            updated_at: new Date().toISOString(),
          })
          .eq("codigo", codigo);

        if (error) {
          alert(`No se pudo guardar el precio del papel: ${error.message}`);
          return;
        }

        const papelLocal = papeles.find((p) => p.codigo === codigo);
        if (papelLocal) papelLocal.precio_hoja = nuevoPrecio;

        guardadoOk.classList.remove("hidden");
        setTimeout(() => guardadoOk.classList.add("hidden"), 1500);
      };

      input.addEventListener("blur", guardar);
      input.addEventListener("keydown", (e) => {
        if (e.key === "Enter") input.blur();
      });
    });
  }

  // MANEJADOR DE CLICK EN FILTROS
  function handleFiltroClick(e) {
    const btn = e.currentTarget;
    const filtro = btn.dataset.filtro;

    // Actualizar clases de todos los botones
    document.querySelectorAll(".filtro-btn").forEach((b) => {
      b.classList.remove("bg-indigo-600", "text-white");
      b.classList.add("bg-slate-100", "text-slate-600");
    });

    btn.classList.remove("bg-slate-100", "text-slate-600");
    btn.classList.add("bg-indigo-600", "text-white");

    // Aplicar filtros
    aplicarFiltros();
  }

  // CONFIGURAR FILTROS
  function setupFiltros() {
    const filtros = document.querySelectorAll(".filtro-btn");
    filtros.forEach((btn) => {
      btn.removeEventListener("click", handleFiltroClick);
      btn.addEventListener("click", handleFiltroClick);
    });
  }

  // FUNCIONES DEL MODAL
  function abrirModal() {
    const modal = document.getElementById("modalNuevoPapel");
    modal.classList.remove("hidden");
    document.body.style.overflow = "hidden";
    document.getElementById("modalForm").reset();
    setTimeout(() => document.getElementById("modalNombre").focus(), 100);
  }

  function cerrarModal() {
    const modal = document.getElementById("modalNuevoPapel");
    modal.classList.add("hidden");
    document.body.style.overflow = "";
  }

  async function agregarPapel(e) {
    e.preventDefault();

    const nombre = document.getElementById("modalNombre").value.trim();
    const gramaje = document.getElementById("modalGramaje").value.trim();
    const codigo = document
      .getElementById("modalCodigo")
      .value.trim()
      .toUpperCase();
    const precio = parseFloat(document.getElementById("modalPrecio").value);
    const esEstandar = document.getElementById("modalEstandar").checked;

    // Validaciones
    if (!nombre) {
      alert("El nombre del papel es obligatorio");
      document.getElementById("modalNombre").focus();
      return;
    }

    if (!codigo) {
      alert("El código es obligatorio");
      document.getElementById("modalCodigo").focus();
      return;
    }

    if (isNaN(precio) || precio < 0) {
      alert("Ingresá un precio válido");
      document.getElementById("modalPrecio").focus();
      return;
    }

    // Verificar si ya existe un papel con ese código
    const { data: existente, error: checkError } = await supabase
      .from("papeles_cotizador")
      .select("codigo")
      .eq("codigo", codigo)
      .maybeSingle();

    if (checkError) {
      alert(`Error al verificar el código: ${checkError.message}`);
      return;
    }

    if (existente) {
      alert(`Ya existe un papel con el código "${codigo}". Usá otro código.`);
      document.getElementById("modalCodigo").focus();
      return;
    }

    // Insertar nuevo papel
    const { error } = await supabase.from("papeles_cotizador").insert({
      nombre,
      gramaje: gramaje || null,
      codigo,
      precio_hoja: precio,
      es_estandar: esEstandar,
      formato: "A4",
      created_at: new Date().toISOString(),
      updated_at: new Date().toISOString(),
    });

    if (error) {
      alert(`Error al agregar el papel: ${error.message}`);
      return;
    }

    cerrarModal();
    alert(`¡"${nombre}" agregado correctamente!`);
    await cargarPapeles();
  }

  async function cargarPrecios() {
    const { data, error } = await supabase
      .from("precios_cotizador")
      .select("*")
      .order("clave", { ascending: true });

    document.getElementById("cargando").classList.add("hidden");

    if (error) {
      alert(`No se pudieron cargar los precios: ${error.message}`);
      return;
    }

    precios = data || [];
    document.getElementById("grupos").classList.remove("hidden");
    renderGrupos();
  }

  async function cargarPapeles() {
    const { data, error } = await supabase
      .from("papeles_cotizador")
      .select("*")
      .eq("formato", "A4")
      .order("es_estandar", { ascending: false })
      .order("precio_hoja", { ascending: true });

    if (error) {
      alert(`No se pudieron cargar los papeles: ${error.message}`);
      return;
    }

    papeles = data || [];
    document.getElementById("seccionPapeles").classList.remove("hidden");
    renderPapeles();
  }

  function conTimeout(promesa, ms) {
    return Promise.race([
      promesa,
      new Promise((_, reject) =>
        setTimeout(() => reject(new Error("timeout")), ms),
      ),
    ]);
  }

  document.addEventListener("DOMContentLoaded", async () => {
    let session = null;
    try {
      const resultado = await conTimeout(supabase.auth.getSession(), 8000);
      session = resultado.data.session;
    } catch (e) {
      // Si tarda demasiado, mandamos al login
    }

    if (!session) {
      window.location.href = "/admin/login";
      return;
    }

    await Promise.all([cargarPrecios(), cargarPapeles()]);

    // Configurar búsqueda
    const buscador = document.getElementById("buscadorPrecios");
    if (buscador) {
      buscador.addEventListener("input", aplicarFiltros);
    }

    // Configurar filtros
    setupFiltros();

    // Event listeners para el modal
    document
      .getElementById("btnNuevoPapel")
      .addEventListener("click", abrirModal);
    document
      .getElementById("modalCerrar")
      .addEventListener("click", cerrarModal);
    document
      .getElementById("modalCancelar")
      .addEventListener("click", cerrarModal);
    document
      .getElementById("modalForm")
      .addEventListener("submit", agregarPapel);

    // Cerrar modal con ESC
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") cerrarModal();
    });

    // Cerrar modal al hacer clic fuera
    document
      .getElementById("modalNuevoPapel")
      .addEventListener("click", (e) => {
        if (e.target === e.currentTarget) cerrarModal();
      });
  });
</script>
