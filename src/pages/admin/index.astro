---
/* src/pages/admin/index.astro - Panel Admin PWA Adaptativo */
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
    />
    <title>Luna Admin — Panel de Gestión</title>

    <!-- Configuración PWA / Modo App Móvil -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#4f46e5" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta
      name="apple-mobile-web-app-status-bar-style"
      content="black-translucent"
    />
    <meta name="apple-mobile-web-app-title" content="Luna Admin" />
  </head>

  <body
    class="bg-slate-100 text-slate-800 antialiased min-h-screen pb-12 select-none"
  >
    <!-- Navbar / Header Superior -->
    <header
      class="bg-indigo-950 text-white p-4 sticky top-0 z-50 shadow-md flex justify-between items-center"
    >
      <div>
        <h1 class="font-serif font-bold text-lg leading-tight">
          Ideas de la Luna
        </h1>
        <p class="text-[10px] text-indigo-300 font-light">
          Panel de Control PWA
        </p>
      </div>
      <button
        id="btnActualizar"
        class="bg-indigo-800 hover:bg-indigo-700 active:scale-95 text-white text-xs px-3 py-1.5 rounded-xl border border-indigo-700 transition-all"
      >
        🔄 Refrescar
      </button>
    </header>

    <main class="max-w-4xl mx-auto p-4 space-y-4">
      <!-- Filtros Rápidos de Estado -->
      <div class="flex gap-2 overflow-x-auto pb-1 text-xs no-scrollbar">
        <button
          data-filter="todos"
          class="btn-filtro active bg-indigo-600 text-white px-3.5 py-1.5 rounded-full font-medium whitespace-nowrap shadow-sm"
        >
          Todos
        </button>
        <button
          data-filter="Pendiente de Pago"
          class="btn-filtro bg-white text-slate-600 px-3.5 py-1.5 rounded-full font-medium border border-slate-200 whitespace-nowrap"
        >
          ⏳ Pendientes
        </button>
        <button
          data-filter="En Producción"
          class="btn-filtro bg-white text-slate-600 px-3.5 py-1.5 rounded-full font-medium border border-slate-200 whitespace-nowrap"
        >
          🖨️ En Producción
        </button>
        <button
          data-filter="Entregado"
          class="btn-filtro bg-white text-slate-600 px-3.5 py-1.5 rounded-full font-medium border border-slate-200 whitespace-nowrap"
        >
          ✅ Entregados
        </button>
      </div>

      <!-- Lista / Grilla de Pedidos -->
      <div id="listaPedidos" class="space-y-3">
        <div
          class="bg-white p-8 rounded-2xl text-center text-slate-400 text-xs shadow-sm"
        >
          Cargando pedidos...
        </div>
      </div>
    </main>

    <script>
      // @ts-nocheck
      import { supabase } from "../../lib/supabase.js";

      let todosLosPedidos = [];

      async function cargarPedidos() {
        const contenedor = document.getElementById("listaPedidos");
        contenedor.innerHTML =
          '<div class="bg-white p-8 rounded-2xl text-center text-slate-400 text-xs shadow-sm">Actualizando...</div>';

        if (!supabase) {
          contenedor.innerHTML =
            '<div class="bg-white p-8 rounded-2xl text-center text-red-500 text-xs shadow-sm">Error: No se pudo conectar con Supabase.</div>';
          return;
        }

        const { data, error } = await supabase
          .from("orders")
          .select("*")
          .order("created_at", { ascending: false });

        if (error) {
          contenedor.innerHTML = `<div class="bg-white p-8 rounded-2xl text-center text-red-500 text-xs shadow-sm">Error al cargar datos: ${error.message}</div>`;
          return;
        }

        todosLosPedidos = data || [];
        renderizarPedidos(todosLosPedidos);
      }

      function renderizarPedidos(pedidos) {
        const contenedor = document.getElementById("listaPedidos");
        if (pedidos.length === 0) {
          contenedor.innerHTML =
            '<div class="bg-white p-8 rounded-2xl text-center text-slate-400 text-xs shadow-sm">No se encontraron pedidos.</div>';
          return;
        }

        contenedor.innerHTML = pedidos
          .map((p) => {
            const fecha = new Date(p.created_at).toLocaleDateString("es-AR", {
              day: "2-digit",
              month: "2-digit",
              hour: "2-digit",
              minute: "2-digit",
            });

            return `
            <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-200/80 space-y-3 hover:border-indigo-200 transition-all">
              <div class="flex justify-between items-start gap-2">
                <div>
                  <span class="text-[10px] font-bold text-indigo-600 bg-indigo-50 px-2.5 py-0.5 rounded-full border border-indigo-100">
                    #${p.order_code || "SIN-CODIGO"}
                  </span>
                  <h3 class="font-bold text-slate-800 text-sm mt-1.5 line-clamp-1">${p.product_title || "Pedido de Impresión"}</h3>
                  <p class="text-[10px] text-slate-400">${fecha}</p>
                </div>
                <span class="text-base font-extrabold text-slate-900 whitespace-nowrap">$${(p.total_price || 0).toLocaleString("es-AR")}</span>
              </div>

              <!-- Selector de Estado Interactivo -->
              <div class="flex items-center justify-between bg-slate-50 p-2 rounded-xl border border-slate-100">
                <span class="text-[11px] font-medium text-slate-500">Estado:</span>
                <select data-id="${p.id}" class="select-estado bg-white text-xs font-semibold rounded-lg px-2 py-1 border border-slate-200 text-slate-700 outline-none focus:ring-2 focus:ring-indigo-500">
                  <option value="Pendiente de Pago" ${p.status === "Pendiente de Pago" ? "selected" : ""}>⏳ Pendiente</option>
                  <option value="En Producción" ${p.status === "En Producción" ? "selected" : ""}>🖨️ En Producción</option>
                  <option value="Entregado" ${p.status === "Entregado" ? "selected" : ""}>✅ Entregado</option>
                </select>
              </div>

              <!-- Acciones Rápidas -->
              <div class="flex gap-2 pt-1">
                ${
                  p.pdf_url
                    ? `
                  <a href="${p.pdf_url}" target="_blank" rel="noopener noreferrer" class="flex-1 bg-slate-100 hover:bg-slate-200 active:scale-95 text-slate-700 text-[11px] font-medium py-2 rounded-xl text-center transition-all flex items-center justify-center gap-1">
                    📄 Ver PDF
                  </a>
                `
                    : ""
                }
                ${
                  p.customer_phone
                    ? `
                  <a href="https://wa.me/${p.customer_phone}" target="_blank" rel="noopener noreferrer" class="flex-1 bg-emerald-500 hover:bg-emerald-600 active:scale-95 text-white text-[11px] font-semibold py-2 rounded-xl text-center transition-all flex items-center justify-center gap-1 shadow-sm">
                    💬 WhatsApp
                  </a>
                `
                    : ""
                }
              </div>
            </div>
          `;
          })
          .join("");

        // Listener para persistir cambios de estado en Supabase sin recargar la página
        document.querySelectorAll(".select-estado").forEach((sel) => {
          sel.addEventListener("change", async (e) => {
            const id = e.target.dataset.id;
            const nuevoEstado = e.target.value;
            const { error } = await supabase
              .from("orders")
              .update({ status: nuevoEstado })
              .eq("id", id);

            if (error) {
              alert("Error al actualizar el estado: " + error.message);
            }
          });
        });
      }

      // Manejo de Filtros
      document.querySelectorAll(".btn-filtro").forEach((btn) => {
        btn.addEventListener("click", () => {
          document.querySelectorAll(".btn-filtro").forEach((b) => {
            b.classList.remove("active", "bg-indigo-600", "text-white");
            b.classList.add("bg-white", "text-slate-600");
          });
          btn.classList.add("active", "bg-indigo-600", "text-white");
          btn.classList.remove("bg-white", "text-slate-600");

          const filtro = btn.dataset.filter;
          if (filtro === "todos") {
            renderizarPedidos(todosLosPedidos);
          } else {
            renderizarPedidos(
              todosLosPedidos.filter((p) => p.status === filtro),
            );
          }
        });
      });

      document
        .getElementById("btnActualizar")
        .addEventListener("click", cargarPedidos);
      document.addEventListener("DOMContentLoaded", cargarPedidos);
    </script>
  </body>
</html>
