---
import Layout from "../../layouts/Layout.astro";
import Greeting from "../../components/Greeting.astro";
---

<Layout title="Panel de Pedidos | Ideas de la Luna">
  <section class="max-w-5xl mx-auto px-4 py-10 sm:py-16">
    <div class="flex items-center justify-between mb-8">
      <div>
        <span
          class="text-[10px] sm:text-xs font-semibold tracking-widest text-indigo-600 uppercase bg-indigo-50 px-2.5 py-1 rounded-full"
        >
          Panel privado
        </span>
        <h1
          class="text-2xl sm:text-3xl font-serif text-indigo-950 font-medium mt-3"
        >
          Pedidos del <span class="italic text-indigo-600">Cotizador</span>
        </h1>
        <Greeting />
      </div>
      <div class="flex items-center gap-2">
        <button
          id="btnLimpiar"
          class="relative text-xs font-medium text-slate-500 hover:text-amber-600 border border-slate-200 hover:border-amber-300 rounded-full px-4 py-2 transition-all"
        >
          🧹 Limpiar archivos viejos
          <span
            id="badgeLimpiar"
            class="hidden absolute -top-2 -right-2 bg-amber-500 text-white text-[10px] font-bold rounded-full h-5 w-5 flex items-center justify-center"
          ></span>
        </button>
        <button
          id="btnLogout"
          class="text-xs font-medium text-slate-500 hover:text-indigo-600 border border-slate-200 hover:border-indigo-300 rounded-full px-4 py-2 transition-all"
        >
          Cerrar sesión
        </button>
      </div>
    </div>

    <div id="metricas" class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
      <div class="bg-white border border-indigo-50 rounded-xl p-3 text-center">
        <p
          id="metricaPendientes"
          class="text-xl font-serif font-bold text-amber-600"
        >
          0
        </p>
        <p class="text-[10px] uppercase tracking-wider text-slate-500 mt-1">
          Pendientes de pago
        </p>
      </div>
      <div class="bg-white border border-indigo-50 rounded-xl p-3 text-center">
        <p
          id="metricaPreparacion"
          class="text-xl font-serif font-bold text-indigo-600"
        >
          0
        </p>
        <p class="text-[10px] uppercase tracking-wider text-slate-500 mt-1">
          En preparación
        </p>
      </div>
      <div class="bg-white border border-indigo-50 rounded-xl p-3 text-center">
        <p
          id="metricaListos"
          class="text-xl font-serif font-bold text-emerald-600"
        >
          0
        </p>
        <p class="text-[10px] uppercase tracking-wider text-slate-500 mt-1">
          Listos para retirar
        </p>
      </div>
      <div class="bg-white border border-indigo-50 rounded-xl p-3 text-center">
        <p
          id="metricaFacturado"
          class="text-xl font-serif font-bold text-indigo-950"
        >
          $0
        </p>
        <p class="text-[10px] uppercase tracking-wider text-slate-500 mt-1">
          Facturado este mes
        </p>
      </div>
    </div>

    <input
      type="text"
      id="inputBuscar"
      placeholder="Buscar por código de pedido o archivo..."
      class="w-full bg-white border border-slate-200 text-slate-700 text-sm rounded-xl p-3 mb-4 focus:outline-none focus:border-indigo-500"
    />

    <div class="flex flex-wrap gap-2 mb-6" id="filtros">
      <button
        data-filtro="todos"
        class="filtro-estado active border border-indigo-600 bg-indigo-50/80 text-indigo-950 text-xs py-1.5 px-3 rounded-full font-medium transition-all"
        >Todos</button
      >
      <button
        data-filtro="Pendiente de Pago"
        class="filtro-estado border border-slate-200 bg-white text-slate-600 text-xs py-1.5 px-3 rounded-full font-medium transition-all"
        >Pendiente de Pago</button
      >
      <button
        data-filtro="Pago Confirmado"
        class="filtro-estado border border-slate-200 bg-white text-slate-600 text-xs py-1.5 px-3 rounded-full font-medium transition-all"
        >Pago Confirmado</button
      >
      <button
        data-filtro="En Preparación"
        class="filtro-estado border border-slate-200 bg-white text-slate-600 text-xs py-1.5 px-3 rounded-full font-medium transition-all"
        >En Preparación</button
      >
      <button
        data-filtro="Listo para Retirar"
        class="filtro-estado border border-slate-200 bg-white text-slate-600 text-xs py-1.5 px-3 rounded-full font-medium transition-all"
        >Listo para Retirar</button
      >
      <button
        data-filtro="Entregado"
        class="filtro-estado border border-slate-200 bg-white text-slate-600 text-xs py-1.5 px-3 rounded-full font-medium transition-all"
        >Entregado</button
      >
    </div>

    <p id="cargando" class="text-sm text-slate-500">Cargando pedidos...</p>
    <p id="vacio" class="text-sm text-slate-500 hidden">
      No hay pedidos en este estado.
    </p>

    <div id="listaPedidos" class="space-y-4"></div>
  </section>
</Layout>

<style>
  .pedido-card {
    background: white;
    border: 1px solid rgba(99, 102, 241, 0.08);
    border-radius: 1rem;
    padding: 1.25rem;
  }
</style>

<script>
  // @ts-nocheck
  import { supabase } from "../../lib/supabase.js";

  const ESTADOS = [
    "Pendiente de Pago",
    "Pago Confirmado",
    "En Preparación",
    "Listo para Retirar",
    "Entregado",
    "Cancelado",
  ];

  const MENSAJES_POR_ESTADO = {
    "Pendiente de Pago": (p) =>
      `¡Hola! Te escribimos de Ideas de la Luna sobre tu pedido #${p.order_code}. Todavía figura pendiente de pago, ¿nos podés enviar el comprobante de transferencia? Alias: ideas.de.la.luna`,
    "Pago Confirmado": (p) =>
      `¡Hola! Te confirmamos que recibimos el pago de tu pedido #${p.order_code}. Ya lo pasamos a preparación 🙌`,
    "En Preparación": (p) =>
      `¡Hola! Tu pedido #${p.order_code} está en preparación. Te avisamos apenas esté listo.`,
    "Listo para Retirar": (p) =>
      `¡Hola! Tu pedido #${p.order_code} ya está listo para retirar. Te esperamos 😊`,
    Entregado: (p) =>
      `¡Hola! Gracias por retirar tu pedido #${p.order_code}. ¡Cualquier cosa estamos a un mensaje de distancia!`,
    Cancelado: (p) =>
      `¡Hola! Te escribimos porque tu pedido #${p.order_code} quedó cancelado. Si fue un error o querés reactivarlo, avisanos.`,
  };

  let pedidos = [];
  let filtroActual = "todos";
  let busquedaActual = "";

  function badgeColor(status) {
    switch (status) {
      case "Pendiente de Pago":
        return "bg-amber-50 text-amber-700 border-amber-200";
      case "Pago Confirmado":
        return "bg-sky-50 text-sky-700 border-sky-200";
      case "En Preparación":
        return "bg-indigo-50 text-indigo-700 border-indigo-200";
      case "Listo para Retirar":
        return "bg-emerald-50 text-emerald-700 border-emerald-200";
      case "Entregado":
        return "bg-slate-100 text-slate-500 border-slate-200";
      case "Cancelado":
        return "bg-red-50 text-red-600 border-red-200";
      default:
        return "bg-slate-50 text-slate-600 border-slate-200";
    }
  }

  function calcularMetricas() {
    const ahora = new Date();
    const mesActual = ahora.getMonth();
    const anioActual = ahora.getFullYear();

    const pendientes = pedidos.filter(
      (p) => p.status === "Pendiente de Pago",
    ).length;
    const preparacion = pedidos.filter(
      (p) => p.status === "En Preparación",
    ).length;
    const listos = pedidos.filter(
      (p) => p.status === "Listo para Retirar",
    ).length;

    const facturado = pedidos
      .filter((p) => {
        if (p.status === "Cancelado" || !p.created_at) return false;
        const fecha = new Date(p.created_at);
        return (
          fecha.getMonth() === mesActual && fecha.getFullYear() === anioActual
        );
      })
      .reduce((acc, p) => acc + Number(p.total_price || 0), 0);

    document.getElementById("metricaPendientes").textContent = pendientes;
    document.getElementById("metricaPreparacion").textContent = preparacion;
    document.getElementById("metricaListos").textContent = listos;
    document.getElementById("metricaFacturado").textContent =
      `$${facturado.toLocaleString("es-AR")}`;
  }

  const DIAS_LIMITE_LIMPIEZA = 30;

  function extraerPathStorage(pdfUrl) {
    const marcador = "/pdfs-cotizador/";
    const idx = pdfUrl.indexOf(marcador);
    if (idx === -1) return null;
    return pdfUrl.slice(idx + marcador.length);
  }

  function pedidosParaLimpiar() {
    const limite = new Date();
    limite.setDate(limite.getDate() - DIAS_LIMITE_LIMPIEZA);

    return pedidos.filter((p) => {
      if (!p.pdf_url) return false;
      if (p.status !== "Entregado" && p.status !== "Cancelado") return false;
      if (!p.created_at) return false;
      return new Date(p.created_at) < limite;
    });
  }

  function actualizarBadgeLimpieza() {
    const badge = document.getElementById("badgeLimpiar");
    const cantidad = pedidosParaLimpiar().length;

    if (cantidad > 0) {
      badge.textContent = cantidad > 99 ? "99+" : cantidad;
      badge.classList.remove("hidden");
    } else {
      badge.classList.add("hidden");
    }
  }

  async function limpiarArchivosViejos() {
    const candidatos = pedidosParaLimpiar();

    if (candidatos.length === 0) {
      alert("No hay archivos para limpiar por ahora.");
      return;
    }

    const confirmar = confirm(
      `Se van a borrar ${candidatos.length} archivo(s) de pedidos Entregados/Cancelados con más de ${DIAS_LIMITE_LIMPIEZA} días. El registro del pedido se mantiene, solo se libera el archivo. ¿Confirmás?`,
    );
    if (!confirmar) return;

    const btnLimpiar = document.getElementById("btnLimpiar");
    btnLimpiar.disabled = true;

    let borrados = 0;
    let fallidos = 0;

    for (const pedido of candidatos) {
      const path = extraerPathStorage(pedido.pdf_url);
      if (!path) {
        fallidos++;
        continue;
      }

      const { error: errorStorage } = await supabase.storage
        .from("pdfs-cotizador")
        .remove([path]);

      if (errorStorage) {
        fallidos++;
        continue;
      }

      const { error: errorUpdate } = await supabase
        .from("orders")
        .update({ pdf_url: null })
        .eq("id", pedido.id);

      if (errorUpdate) {
        fallidos++;
        continue;
      }

      pedido.pdf_url = null;
      borrados++;
    }

    btnLimpiar.disabled = false;
    renderPedidos();
    actualizarBadgeLimpieza();

    alert(
      fallidos > 0
        ? `Se borraron ${borrados} archivo(s). ${fallidos} no se pudieron borrar (revisá la consola o probá de nuevo).`
        : `Se borraron ${borrados} archivo(s) correctamente.`,
    );
  }

  function renderPedidos() {
    const cont = document.getElementById("listaPedidos");
    const vacio = document.getElementById("vacio");

    const busqueda = busquedaActual.trim().toLowerCase();

    const visibles = pedidos.filter((p) => {
      const coincideEstado =
        filtroActual === "todos" || p.status === filtroActual;
      const coincideBusqueda =
        !busqueda ||
        (p.order_code || "").toLowerCase().includes(busqueda) ||
        (p.product_title || "").toLowerCase().includes(busqueda);
      return coincideEstado && coincideBusqueda;
    });

    if (visibles.length === 0) {
      cont.innerHTML = "";
      vacio.classList.remove("hidden");
      return;
    }
    vacio.classList.add("hidden");

    cont.innerHTML = visibles
      .map((p) => {
        const detalle = (p.subproducts || [])
          .map(
            (d) =>
              `<span class="text-slate-500">${d.label}:</span> <span class="font-medium text-indigo-950">${d.value}</span>`,
          )
          .join(" &nbsp;•&nbsp; ");

        const opciones = ESTADOS.map(
          (e) =>
            `<option value="${e}" ${e === p.status ? "selected" : ""}>${e}</option>`,
        ).join("");

        return `
          <div class="pedido-card" data-id="${p.id}">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div>
                <p class="font-serif text-indigo-950 font-medium text-base">
                  ${p.product_title || "Pedido"}
                  ${p.order_code ? `<span class="text-xs text-indigo-400 font-sans font-normal ml-1">#${p.order_code}</span>` : ""}
                </p>
                <p class="text-xs text-slate-500 mt-1">${detalle}</p>
                <p class="text-sm font-semibold text-indigo-950 mt-2">$${Number(p.total_price || 0).toLocaleString("es-AR")}</p>
              </div>
              <span class="text-[10px] font-semibold uppercase tracking-wider border rounded-full px-2.5 py-1 ${badgeColor(p.status)}">
                ${p.status || "Sin estado"}
              </span>
            </div>

            <div class="flex flex-wrap items-center gap-2 mt-4 pt-4 border-t border-indigo-50">
              <select class="select-estado bg-slate-50 border border-slate-200 text-slate-700 text-xs rounded-lg p-2 focus:outline-none">
                ${opciones}
              </select>

              <label class="flex items-center gap-1.5 text-xs text-slate-500 cursor-pointer ml-2">
                <input type="checkbox" class="check-demora" ${p.delayed ? "checked" : ""} />
                Con demora
              </label>

              <input
                type="text"
                placeholder="Motivo de la demora (opcional)"
                class="input-motivo bg-slate-50 border border-slate-200 text-slate-700 text-xs rounded-lg p-2 focus:outline-none flex-1 min-w-[160px] ${p.delayed ? "" : "hidden"}"
                value="${p.delay_reason ? p.delay_reason.replace(/"/g, "&quot;") : ""}"
              />

              ${p.pdf_url ? `<a href="${p.pdf_url}" target="_blank" class="text-xs font-medium bg-white hover:bg-indigo-50 text-indigo-700 border border-indigo-200 rounded-lg px-3 py-2 transition-colors">⬇️ Descargar archivo</a>` : ""}

              ${p.customer_phone ? `<button class="btn-notificar text-xs font-medium bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-200 rounded-lg px-3 py-2 transition-colors">📲 Notificar por WhatsApp</button>` : ""}

              <span class="guardado-ok hidden text-xs text-emerald-600 font-medium">✅ Guardado</span>
            </div>
          </div>
        `;
      })
      .join("");

    // Listeners por card
    cont.querySelectorAll(".pedido-card").forEach((card) => {
      const id = card.getAttribute("data-id");
      const selectEstado = card.querySelector(".select-estado");
      const checkDemora = card.querySelector(".check-demora");
      const inputMotivo = card.querySelector(".input-motivo");
      const guardadoOk = card.querySelector(".guardado-ok");
      const btnNotificar = card.querySelector(".btn-notificar");

      const guardarCambios = async () => {
        const cambios = {
          status: selectEstado.value,
          delayed: checkDemora.checked,
          delay_reason: checkDemora.checked ? inputMotivo.value.trim() : null,
        };

        const { error } = await supabase
          .from("orders")
          .update(cambios)
          .eq("id", id);

        if (error) {
          alert(`No se pudo guardar el cambio: ${error.message}`);
          return;
        }

        const pedido = pedidos.find((p) => String(p.id) === String(id));
        if (pedido) Object.assign(pedido, cambios);

        calcularMetricas();
        guardadoOk.classList.remove("hidden");
        setTimeout(() => guardadoOk.classList.add("hidden"), 1500);
      };

      selectEstado.addEventListener("change", guardarCambios);

      checkDemora.addEventListener("change", () => {
        inputMotivo.classList.toggle("hidden", !checkDemora.checked);
        guardarCambios();
      });

      inputMotivo.addEventListener("blur", () => {
        if (checkDemora.checked) guardarCambios();
      });

      if (btnNotificar) {
        btnNotificar.addEventListener("click", () => {
          const pedido = pedidos.find((p) => String(p.id) === String(id));
          if (!pedido) return;

          const armarMensaje =
            MENSAJES_POR_ESTADO[pedido.status] ||
            MENSAJES_POR_ESTADO["Pendiente de Pago"];
          const mensaje = armarMensaje(pedido);
          const telefono = pedido.customer_phone.replace(/[^0-9]/g, "");

          window.open(
            `https://wa.me/${telefono}?text=${encodeURIComponent(mensaje)}`,
            "_blank",
          );
        });
      }
    });
  }

  async function cargarPedidos() {
    const { data, error } = await supabase
      .from("orders")
      .select("*")
      .order("id", { ascending: false });

    document.getElementById("cargando").classList.add("hidden");

    if (error) {
      alert(`No se pudieron cargar los pedidos: ${error.message}`);
      return;
    }

    pedidos = data || [];
    calcularMetricas();
    actualizarBadgeLimpieza();
    renderPedidos();
  }

  document.addEventListener("DOMContentLoaded", async () => {
    const {
      data: { session },
    } = await supabase.auth.getSession();
    if (!session) {
      window.location.href = "/admin/login";
      return;
    }

    document
      .getElementById("btnLimpiar")
      .addEventListener("click", limpiarArchivosViejos);

    document.getElementById("btnLogout").addEventListener("click", async () => {
      await supabase.auth.signOut();
      window.location.href = "/admin/login";
    });

    document.getElementById("inputBuscar").addEventListener("input", (e) => {
      busquedaActual = e.target.value;
      renderPedidos();
    });

    document.querySelectorAll(".filtro-estado").forEach((btn) => {
      btn.addEventListener("click", () => {
        document.querySelectorAll(".filtro-estado").forEach((b) => {
          b.classList.remove(
            "active",
            "border-indigo-600",
            "bg-indigo-50/80",
            "text-indigo-950",
          );
          b.classList.add("border-slate-200", "bg-white", "text-slate-600");
        });
        btn.classList.add(
          "active",
          "border-indigo-600",
          "bg-indigo-50/80",
          "text-indigo-950",
        );
        btn.classList.remove("border-slate-200", "bg-white", "text-slate-600");

        filtroActual = btn.getAttribute("data-filtro");
        renderPedidos();
      });
    });

    await cargarPedidos();
  });
</script>
