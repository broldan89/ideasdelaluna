---
import Layout from "../../layouts/Layout.astro";
import Greeting from "../../components/Greeting.astro";
import NuevoPedidoPersonalizado from "../../components/NuevoPedidoPersonalizado.astro";
---

<Layout title="Panel de Pedidos | Ideas de la Luna" pwa={true}>
  <div
    class="sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-indigo-50 pt-[env(safe-area-inset-top)]"
  >
    <div class="max-w-7xl mx-auto px-4 py-4 flex items-center justify-between">
      <div>
        <span
          class="text-[10px] sm:text-xs font-semibold tracking-widest text-indigo-600 uppercase bg-indigo-50 px-2.5 py-1 rounded-full"
        >
          Panel privado
        </span>
        <h1
          class="text-xl sm:text-3xl font-serif text-indigo-950 font-medium mt-2 sm:mt-3"
        >
          Gestión de Pedidos
        </h1>
        <Greeting />
      </div>
      <div class="flex items-center gap-2">
        <a
          href="/admin/clientes"
          class="text-xs font-medium text-purple-700 hover:text-purple-900 active:scale-95 border border-purple-200 bg-purple-50 hover:bg-purple-100 rounded-full px-3 sm:px-4 py-2 transition-all flex items-center gap-1.5"
        >
          <span>👥 Clientes & WA Marketing</span>
        </a>
        <a
          href="/admin/precios"
          class="text-xs font-medium text-slate-500 hover:text-indigo-600 active:scale-95 border border-slate-200 hover:border-indigo-300 rounded-full px-3 sm:px-4 py-2 transition-all"
        >
          <span class="hidden sm:inline">💲 Precios</span>
          <span class="sm:hidden">💲</span>
        </a>
        <button
          id="btnLogout"
          class="text-xs font-medium text-slate-500 hover:text-indigo-600 active:scale-95 border border-slate-200 hover:border-indigo-300 rounded-full px-3 sm:px-4 py-2 transition-all"
        >
          Salir
        </button>
      </div>
    </div>
  </div>

  <section class="max-w-7xl mx-auto px-4 py-6 sm:py-10 pb-28 sm:pb-16">
    <div id="metricas" class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
      <div class="bg-white border border-indigo-50 rounded-xl p-3 text-center">
        <p
          id="metricaPendientes"
          class="text-xl font-serif font-bold text-purple-600"
        >
          0
        </p>
        <p class="text-[10px] uppercase tracking-wider text-slate-500 mt-1">
          En Diseño
        </p>
      </div>
      <div class="bg-white border border-indigo-50 rounded-xl p-3 text-center">
        <p
          id="metricaPreparacion"
          class="text-xl font-serif font-bold text-indigo-600"
        >
          0
        </p>
        <p class="text-[10px] uppercase tracking-wider text-slate-500 mt-1">
          En Preparación
        </p>
      </div>
      <div class="bg-white border border-indigo-50 rounded-xl p-3 text-center">
        <p
          id="metricaListos"
          class="text-xl font-serif font-bold text-emerald-600"
        >
          0
        </p>
        <p class="text-[10px] uppercase tracking-wider text-slate-500 mt-1">
          Listos para entregar
        </p>
      </div>
      <div class="bg-white border border-indigo-50 rounded-xl p-3 text-center">
        <p
          id="metricaFacturado"
          class="text-xl font-serif font-bold text-indigo-950"
        >
          $0
        </p>
        <p class="text-[10px] uppercase tracking-wider text-slate-500 mt-1">
          Facturado este mes
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
      <div class="lg:col-span-1">
        <NuevoPedidoPersonalizado />
      </div>

      <div class="lg:col-span-2">
        <input
          type="text"
          id="inputBuscar"
          placeholder="Buscar por código de pedido o archivo..."
          class="w-full bg-white border border-slate-200 text-slate-700 text-sm rounded-xl p-3 mb-4 focus:outline-none focus:border-indigo-500"
        />

        <div class="hidden sm:flex flex-wrap gap-2 mb-6" id="filtros">
          <button
            data-filtro="todos"
            class="filtro-estado active border border-indigo-600 bg-indigo-50/80 text-indigo-950 text-xs py-1.5 px-3 rounded-full font-medium active:scale-95 transition-all"
            >Todos</button
          >
          <button
            data-filtro="Diseño"
            class="filtro-estado border border-slate-200 bg-white text-slate-600 text-xs py-1.5 px-3 rounded-full font-medium active:scale-95 transition-all"
            >Diseño</button
          >
          <button
            data-filtro="Impresión"
            class="filtro-estado border border-slate-200 bg-white text-slate-600 text-xs py-1.5 px-3 rounded-full font-medium active:scale-95 transition-all"
            >Impresión</button
          >
          <button
            data-filtro="Preparación"
            class="filtro-estado border border-slate-200 bg-white text-slate-600 text-xs py-1.5 px-3 rounded-full font-medium active:scale-95 transition-all"
            >Preparación</button
          >
          <button
            data-filtro="Listo para entregar"
            class="filtro-estado border border-slate-200 bg-white text-slate-600 text-xs py-1.5 px-3 rounded-full font-medium active:scale-95 transition-all"
            >Listo para entregar</button
          >
          <button
            data-filtro="Entregado"
            class="filtro-estado border border-slate-200 bg-white text-slate-600 text-xs py-1.5 px-3 rounded-full font-medium active:scale-95 transition-all"
            >Entregado</button
          >
        </div>

        <p class="sm:hidden text-xs text-slate-400 mb-4">
          Elegí un estado en la barra de abajo para filtrar.
        </p>

        <p id="cargando" class="text-sm text-slate-500">Cargando pedidos...</p>
        <p id="vacio" class="text-sm text-slate-500 hidden">
          No hay pedidos en este estado.
        </p>

        <div id="listaPedidos" class="space-y-4"></div>
      </div>
    </div>
  </section>

  <nav
    class="sm:hidden fixed bottom-0 left-0 right-0 z-40 bg-white/95 backdrop-blur-md border-t border-indigo-100 pb-[env(safe-area-inset-bottom)]"
  >
    <div class="grid grid-cols-5 text-center">
      <button
        data-filtro="todos"
        class="filtro-estado active flex flex-col items-center justify-center gap-0.5 py-2 mx-1 my-1 rounded-xl active:scale-95 transition-all text-slate-500"
      >
        <span class="text-lg">📋</span>
        <span class="text-[9px] font-medium">Todos</span>
      </button>
      <button
        data-filtro="Diseño"
        class="filtro-estado flex flex-col items-center justify-center gap-0.5 py-2 mx-1 my-1 rounded-xl active:scale-95 transition-all text-slate-500"
      >
        <span class="text-lg">🎨</span>
        <span class="text-[9px] font-medium">Diseño</span>
      </button>
      <button
        data-filtro="Impresión"
        class="filtro-estado flex flex-col items-center justify-center gap-0.5 py-2 mx-1 my-1 rounded-xl active:scale-95 transition-all text-slate-500"
      >
        <span class="text-lg">🖨️</span>
        <span class="text-[9px] font-medium">Impresión</span>
      </button>
      <button
        data-filtro="Listo para entregar"
        class="filtro-estado flex flex-col items-center justify-center gap-0.5 py-2 mx-1 my-1 rounded-xl active:scale-95 transition-all text-slate-500"
      >
        <span class="text-lg">📦</span>
        <span class="text-[9px] font-medium">Listos</span>
      </button>
      <button
        data-filtro="Entregado"
        class="filtro-estado flex flex-col items-center justify-center gap-0.5 py-2 mx-1 my-1 rounded-xl active:scale-95 transition-all text-slate-500"
      >
        <span class="text-lg">🎉</span>
        <span class="text-[9px] font-medium">Entregado</span>
      </button>
    </div>
  </nav>
</Layout>

<style>
  .pedido-card {
    background: white;
    border: 1px solid rgba(99, 102, 241, 0.08);
    border-radius: 1rem;
    padding: 1.25rem;
  }
</style>

<script>
  // @ts-nocheck
  import { supabase } from "../../lib/supabase.js";

  function escapeHtml(texto) {
    if (texto === null || texto === undefined) return "";
    return String(texto)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  function formatearFechaHora(fechaStr) {
    const d = fechaStr ? new Date(fechaStr) : new Date();
    const pad = (n) => String(n).padStart(2, "0");
    const dia = pad(d.getDate());
    const mes = pad(d.getMonth() + 1);
    const anio = String(d.getFullYear()).slice(-2);
    const hs = pad(d.getHours());
    const min = pad(d.getMinutes());
    const seg = pad(d.getSeconds());
    return `${dia}/${mes}/${anio} ${hs}:${min}:${seg}`;
  }

  const ESTADOS = [
    "Diseño",
    "Impresión",
    "Preparación",
    "Listo para entregar",
    "Entregado",
  ];

  let pedidos = [];
  let filtroActual = "todos";
  let busquedaActual = "";

  function badgeColor(status) {
    switch (status) {
      case "Diseño":
        return "bg-purple-50 text-purple-700 border-purple-200";
      case "Impresión":
        return "bg-amber-50 text-amber-700 border-amber-200";
      case "Preparación":
        return "bg-sky-50 text-sky-700 border-sky-200";
      case "Listo para entregar":
        return "bg-emerald-50 text-emerald-700 border-emerald-200";
      case "Entregado":
        return "bg-slate-100 text-slate-500 border-slate-200";
      default:
        return "bg-slate-50 text-slate-600 border-slate-200";
    }
  }

  function calcularMetricas() {
    const ahora = new Date();
    const mesActual = ahora.getMonth();
    const anioActual = ahora.getFullYear();

    const disenos = pedidos.filter((p) => p.status === "Diseño").length;
    const preparacion = pedidos.filter((p) => p.status === "Preparación").length;
    const listos = pedidos.filter((p) => p.status === "Listo para entregar").length;

    const facturado = pedidos
      .filter((p) => {
        if (p.status === "Entregado" && !p.created_at) return false;
        const fecha = new Date(p.created_at);
        return (
          fecha.getMonth() === mesActual && fecha.getFullYear() === anioActual
        );
      })
      .reduce((acc, p) => acc + Number(p.monto_total || p.total_price || 0), 0);

    document.getElementById("metricaPendientes").textContent = disenos;
    document.getElementById("metricaPreparacion").textContent = preparacion;
    document.getElementById("metricaListos").textContent = listos;
    document.getElementById("metricaFacturado").textContent =
      `$${facturado.toLocaleString("es-AR")}`;
  }

  function armarReciboFormato(pedido) {
    const total = Number(pedido.monto_total || pedido.total_price || 0);
    const cliente = pedido.customer_name || "Cliente Manual";
    const fechaImp = formatearFechaHora();
    const fechaEmision = new Date().toLocaleDateString("es-AR");
    const nota = pedido.comprobante_nota || "Sin observaciones / Factura A/B";

    return `RECIBO EFECTUADO
--------------------------------
FEC.IMP: ${fechaImp}
--------------------------------
Ideas de la Luna
CLIENTE: ${cliente}
IMPORTE RECIBO: $ ${total.toLocaleString("es-AR")}
SALDO ACTUAL: $ 0,00
FECHA EMISION: ${fechaEmision}
--------------------------------
Detalle:
${nota}
  Imputado: $ ${total.toLocaleString("es-AR")}
--------------------------------`;
  }

  async function ejecutarAutolimpieza() {
    try {
      const { data, error } = await supabase.rpc("archive_and_purge_completed_orders");
      if (!error && data > 0) {
        console.log(`Se archivaron y eliminaron ${data} pedidos viejos con saldo $0.`);
      }
    } catch (e) {
      console.error("Error al ejecutar autolimpieza:", e);
    }
  }

  function renderPedidos() {
    const cont = document.getElementById("listaPedidos");
    const vacio = document.getElementById("vacio");

    const busqueda = busquedaActual.trim().toLowerCase();

    const visibles = pedidos.filter((p) => {
      const coincideEstado =
        filtroActual === "todos" || p.status === filtroActual;
      const coincideBusqueda =
        !busqueda ||
        (p.order_code || "").toLowerCase().includes(busqueda) ||
        (p.product_title || "").toLowerCase().includes(busqueda);
      return coincideEstado && coincideBusqueda;
    });

    if (visibles.length === 0) {
      cont.innerHTML = "";
      vacio.classList.remove("hidden");
      return;
    }
    vacio.classList.add("hidden");

    cont.innerHTML = visibles
      .map((p) => {
        const detalle = (p.subproducts || [])
          .map(
            (d) =>
              `<span class="text-slate-500">${escapeHtml(d.label)}:</span> <span class="font-medium text-indigo-950">${escapeHtml(d.value)}</span>`,
          )
          .join(" &nbsp;•&nbsp; ");

        const opciones = ESTADOS.map(
          (e) =>
            `<option value="${e}" ${e === p.status ? "selected" : ""}>${e}</option>`,
        ).join("");

        const total = Number(p.monto_total || p.total_price || 0);
        const senaInicial = Number(p.monto_sena || 0);
        const listaPagos = p.pagos || [];
        const sumaPagosParciales = listaPagos.reduce((sum, item) => sum + Number(item.monto || 0), 0);
        
        const totalAbonado = senaInicial + sumaPagosParciales;
        const saldo = Math.max(0, total - totalAbonado);

        return `
          <div class="pedido-card" data-id="${p.id}">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div>
                <p class="font-serif text-indigo-950 font-medium text-base">
                  ${escapeHtml(p.product_title) || "Pedido"}
                  ${p.order_code ? `<span class="text-xs text-indigo-400 font-sans font-normal ml-1">#${escapeHtml(p.order_code)}</span>` : ""}
                </p>
                <p class="text-xs text-slate-500 mt-1">${detalle}</p>
                
                <div class="mt-3 bg-slate-50 border border-slate-100 p-2.5 rounded-xl text-xs text-slate-600 font-medium space-y-1">
                  <div class="flex justify-between">
                    <span>Total:</span>
                    <strong class="text-slate-900">$${total.toLocaleString("es-AR")}</strong>
                  </div>
                  <div class="flex justify-between">
                    <span>Abonado hasta la fecha:</span>
                    <strong class="text-emerald-600">$${totalAbonado.toLocaleString("es-AR")}</strong>
                  </div>
                  <div class="flex justify-between border-t border-slate-200 pt-1 font-bold">
                    <span>Saldo pendiente:</span>
                    <strong class="${saldo > 0 ? 'text-amber-600' : 'text-emerald-600'}">
                      ${saldo > 0 ? `$${saldo.toLocaleString("es-AR")}` : '✅ $0 (TOTALMENTE ABONADO)'}
                    </strong>
                  </div>
                </div>
              </div>
              <span class="text-[10px] font-semibold uppercase tracking-wider border rounded-full px-2.5 py-1 ${badgeColor(p.status)}">
                ${escapeHtml(p.status) || "Sin estado"}
              </span>
            </div>

            ${saldo > 0 ? `
              <div class="mt-3 p-3 bg-indigo-50/50 border border-indigo-100 rounded-xl space-y-2">
                <p class="text-[11px] font-bold text-indigo-900">💵 Registrar nuevo pago / entrega a cuenta:</p>
                <div class="flex flex-wrap sm:flex-nowrap gap-2">
                  <input
                    type="number"
                    placeholder="Monto ($)"
                    class="input-monto-pago w-full sm:w-32 bg-white border border-slate-200 rounded-lg p-2 text-xs outline-none focus:ring-1 focus:ring-indigo-500"
                  />
                  <input
                    type="text"
                    placeholder="Detalle Fiscal / Factura / Remito (opcional)"
                    class="input-nota-pago w-full bg-white border border-slate-200 rounded-lg p-2 text-xs outline-none focus:ring-1 focus:ring-indigo-500"
                    value="${escapeHtml(p.comprobante_nota || '')}"
                  />
                  <button class="btn-agregar-pago w-full sm:w-auto bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs px-3 py-2 rounded-lg transition-all active:scale-95 whitespace-nowrap">
                    ＋ Cargar Pago
                  </button>
                </div>
              </div>
            ` : ''}

            <div class="flex flex-wrap items-center gap-2 mt-4 pt-4 border-t border-indigo-50">
              <select class="select-estado bg-slate-50 border border-slate-200 text-slate-700 text-xs rounded-lg p-2 focus:outline-none">
                ${opciones}
              </select>

              <label class="flex items-center gap-1.5 text-xs text-slate-500 cursor-pointer ml-2">
                <input type="checkbox" class="check-demora" ${p.delayed ? "checked" : ""} />
                Con demora
              </label>

              <input
                type="text"
                placeholder="Motivo de la demora (opcional)"
                class="input-motivo bg-slate-50 border border-slate-200 text-slate-700 text-xs rounded-lg p-2 focus:outline-none flex-1 min-w-[160px] ${p.delayed ? "" : "hidden"}"
                value="${escapeHtml(p.delay_reason)}"
              />

              ${p.pdf_url ? `<a href="${p.pdf_url}" target="_blank" class="text-xs font-medium bg-white hover:bg-indigo-50 text-indigo-700 border border-indigo-200 rounded-lg px-3 py-2 active:scale-95 transition-all">⬇️ Descargar archivo</a>` : ""}

              ${p.customer_phone ? `
                <button class="btn-recibo text-xs font-medium ${saldo === 0 ? 'bg-indigo-600 text-white hover:bg-indigo-700 font-bold' : 'bg-emerald-50 text-emerald-700 hover:bg-emerald-100'} border border-emerald-200 rounded-lg px-3 py-2 active:scale-95 transition-all">
                  ${saldo === 0 ? '🧾 Enviar Recibo por WA' : '📲 Notificar por WA'}
                </button>
              ` : ""}

              <button class="btn-borrar text-xs font-medium bg-red-50 hover:bg-red-100 text-red-600 border border-red-200 rounded-lg px-3 py-2 active:scale-95 transition-all ml-auto">🗑️ Borrar</button>

              <span class="guardado-ok hidden text-xs text-emerald-600 font-medium">✅ Guardado</span>
            </div>
          </div>
        `;
      })
      .join("");

    cont.querySelectorAll(".pedido-card").forEach((card) => {
      const id = card.getAttribute("data-id");
      const selectEstado = card.querySelector(".select-estado");
      const checkDemora = card.querySelector(".check-demora");
      const inputMotivo = card.querySelector(".input-motivo");
      const btnRecibo = card.querySelector(".btn-recibo");
      const btnBorrar = card.querySelector(".btn-borrar");
      const btnAgregarPago = card.querySelector(".btn-agregar-pago");

      const guardarCambios = async (cambios) => {
        const { error } = await supabase
          .from("orders")
          .update(cambios)
          .eq("id", id);

        if (error) {
          alert(`No se pudo guardar el cambio: ${error.message}`);
          return false;
        }

        const pedido = pedidos.find((p) => String(p.id) === String(id));
        if (pedido) Object.assign(pedido, cambios);

        calcularMetricas();
        renderPedidos();
        return true;
      };

      selectEstado?.addEventListener("change", () => {
        guardarCambios({ status: selectEstado.value });
      });

      checkDemora?.addEventListener("change", () => {
        inputMotivo.classList.toggle("hidden", !checkDemora.checked);
        guardarCambios({
          delayed: checkDemora.checked,
          delay_reason: checkDemora.checked ? inputMotivo.value.trim() : null
        });
      });

      inputMotivo?.addEventListener("blur", () => {
        if (checkDemora.checked) {
          guardarCambios({ delay_reason: inputMotivo.value.trim() });
        }
      });

      if (btnAgregarPago) {
        btnAgregarPago.addEventListener("click", async () => {
          const inputMonto = card.querySelector(".input-monto-pago");
          const inputNota = card.querySelector(".input-nota-pago");

          const montoNuevo = parseFloat(inputMonto.value) || 0;
          const nota = inputNota.value.trim();

          if (montoNuevo <= 0) {
            alert("Ingresá un monto válido para el pago.");
            return;
          }

          const pedido = pedidos.find((p) => String(p.id) === String(id));
          if (!pedido) return;

          const listaPagosVieja = pedido.pagos || [];
          const listaPagosNueva = [...listaPagosVieja, { monto: montoNuevo, fecha: new Date().toISOString() }];

          btnAgregarPago.disabled = true;
          btnAgregarPago.textContent = "Guardando...";

          const ok = await guardarCambios({
            pagos: listaPagosNueva,
            comprobante_nota: nota || pedido.comprobante_nota || ""
          });

          if (ok) {
            const total = Number(pedido.monto_total || pedido.total_price || 0);
            const senaInicial = Number(pedido.monto_sena || 0);
            const sumaPagos = listaPagosNueva.reduce((s, item) => s + Number(item.monto || 0), 0);
            
            if ((senaInicial + sumaPagos) >= total && pedido.customer_phone) {
              alert("🎉 ¡Saldo completado al 100%! Se abrirá WhatsApp con el Recibo de Pago listo para enviar.");
              const mensaje = armarReciboFormato(pedido);
              const telefono = pedido.customer_phone.replace(/[^0-9]/g, "");
              window.open(`https://wa.me/${telefono}?text=${encodeURIComponent(mensaje)}`, "_blank");
            }
          }
        });
      }

      if (btnRecibo) {
        btnRecibo.addEventListener("click", () => {
          const pedido = pedidos.find((p) => String(p.id) === String(id));
          if (!pedido) return;

          const total = Number(pedido.monto_total || pedido.total_price || 0);
          const senaInicial = Number(pedido.monto_sena || 0);
          const listaPagos = pedido.pagos || [];
          const sumaPagos = listaPagos.reduce((s, item) => s + Number(item.monto || 0), 0);
          const saldo = Math.max(0, total - (senaInicial + sumaPagos));

          let mensaje = "";
          if (saldo === 0) {
            mensaje = armarReciboFormato(pedido);
          } else {
            mensaje = `¡Hola! Te escribimos de Ideas de la Luna sobre tu pedido #${pedido.order_code}.\nEtapa actual: *${pedido.status}*\nSaldo pendiente: *$${saldo.toLocaleString("es-AR")}*`;
          }

          const telefono = pedido.customer_phone.replace(/[^0-9]/g, "");
          window.open(`https://wa.me/${telefono}?text=${encodeURIComponent(mensaje)}`, "_blank");
        });
      }

      if (btnBorrar) {
        btnBorrar.addEventListener("click", async () => {
          const pedido = pedidos.find((p) => String(p.id) === String(id));
          if (!pedido) return;

          const confirmar = confirm(
            `¿Estás seguro de borrar el pedido #${pedido.order_code || id}? Esta acción eliminará el pedido permanentemente.`,
          );
          if (!confirmar) return;

          const { error } = await supabase.from("orders").delete().eq("id", id);

          if (error) {
            alert(`No se pudo borrar el pedido: ${error.message}`);
            return;
          }

          pedidos = pedidos.filter((p) => String(p.id) !== String(id));
          calcularMetricas();
          renderPedidos();
        });
      }
    });
  }

  async function cargarPedidos() {
    const { data, error } = await supabase
      .from("orders")
      .select("*")
      .order("id", { ascending: false });

    document.getElementById("cargando")?.classList.add("hidden");

    if (error) {
      alert(`No se pudieron cargar los pedidos: ${error.message}`);
      return;
    }

    pedidos = data || [];
    calcularMetricas();
    renderPedidos();
  }

  function conTimeout(promesa, ms) {
    return Promise.race([
      promesa,
      new Promise((_, reject) =>
        setTimeout(() => reject(new Error("timeout")), ms),
      ),
    ]);
  }

  document.addEventListener("DOMContentLoaded", async () => {
    let session = null;
    try {
      const resultado = await conTimeout(supabase.auth.getSession(), 8000);
      session = resultado.data.session;
    } catch (e) {}

    if (!session) {
      window.location.href = "/admin/login";
      return;
    }

    // Ejecutar autolimpieza de pedidos viejos totalmente abonados (>30 días)
    await ejecutarAutolimpieza();

    document.getElementById("btnLogout")?.addEventListener("click", async () => {
      await supabase.auth.signOut();
      localStorage.removeItem("supabase.auth.token");
      window.location.replace("/admin/login");
    });

    document.getElementById("inputBuscar")?.addEventListener("input", (e) => {
      busquedaActual = e.target.value;
      renderPedidos();
    });

    document.querySelectorAll(".filtro-estado").forEach((btn) => {
      btn.addEventListener("click", () => {
        document.querySelectorAll(".filtro-estado").forEach((b) => {
          b.classList.remove(
            "active",
            "border-indigo-600",
            "bg-indigo-50/80",
            "text-indigo-950",
          );
          b.classList.add("border-slate-200", "bg-white", "text-slate-600");
        });
        btn.classList.add(
          "active",
          "border-indigo-600",
          "bg-indigo-50/80",
          "text-indigo-950",
        );
        btn.classList.remove("border-slate-200", "bg-white", "text-slate-600");

        filtroActual = btn.getAttribute("data-filtro");
        renderPedidos();
      });
    });

    await cargarPedidos();
  });
</script>