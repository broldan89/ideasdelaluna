---
import Layout from "../../layouts/Layout.astro";
export function getStaticPaths() {
  return [{ params: { codigo: undefined } }];
}
---

<Layout title="Seguimiento de pedido | Ideas de la Luna">
  <section class="max-w-md mx-auto px-4 py-20 sm:py-28">
    <div class="text-center mb-8">
      <span
        class="text-[10px] sm:text-xs font-semibold tracking-widest text-indigo-600 uppercase bg-indigo-50 px-2.5 py-1 rounded-full"
      >
        Seguimiento de pedido
      </span>
      <h1
        id="tituloCodigo"
        class="text-2xl sm:text-3xl font-serif text-indigo-950 font-medium mt-3"
      >
        Tu pedido
      </h1>
    </div>

    <div
      id="contenido"
      class="bg-white p-6 sm:p-8 rounded-2xl border border-indigo-50 shadow-sm text-center"
    >
      <p id="cargando" class="text-sm text-slate-500">Buscando tu pedido...</p>

      <div id="resultado" class="hidden space-y-5">
        <div>
          <p
            id="tituloPedido"
            class="font-serif text-indigo-950 font-medium text-base mb-3"
          >
          </p>
          <span
            id="badgeEstado"
            class="inline-block text-xs font-semibold uppercase tracking-wider border rounded-full px-3 py-1.5"
          ></span>
        </div>

        <div class="bg-slate-50 border border-slate-100 rounded-xl p-4 text-left space-y-2.5">
          <h3 class="text-[11px] font-bold text-slate-400 uppercase tracking-wider text-center">
            Estado de Cuenta
          </h3>
          <div class="flex justify-between text-xs text-slate-600">
            <span>Monto Total:</span>
            <span id="outMontoTotal" class="font-semibold text-slate-800">$0</span>
          </div>
          <div class="flex justify-between text-xs text-slate-600">
            <span>Abonado / Seña:</span>
            <span id="outMontoSena" class="font-semibold text-emerald-600">$0</span>
          </div>
          <div class="border-t border-slate-200 pt-2 flex justify-between text-xs font-bold">
            <span class="text-slate-700">Saldo restante:</span>
            <span id="outSaldoRestante" class="text-indigo-600">$0</span>
          </div>
        </div>

        <p
          id="avisoDemora"
          class="hidden text-xs text-amber-600 bg-amber-50 border border-amber-200 rounded-xl p-3"
        >
        </p>
      </div>

      <div id="noEncontrado" class="hidden">
        <p class="text-sm text-slate-500">
          No encontramos ningún pedido con ese código. Revisá que esté bien
          escrito o consultanos por WhatsApp.
        </p>
      </div>
    </div>
  </section>
</Layout>

<script>
  // @ts-nocheck
  import { supabase } from "../../lib/supabase.js";

  // Colores para los nuevos estados de producción
  function badgeColor(status) {
    switch (status) {
      case "En proceso de diseño":
        return "bg-purple-50 text-purple-700 border-purple-200";
      case "Diseño aprobado":
        return "bg-sky-50 text-sky-700 border-sky-200";
      case "En producción":
        return "bg-amber-50 text-amber-700 border-amber-200";
      case "Listo para retirar":
        return "bg-emerald-50 text-emerald-700 border-emerald-200";
      case "Entregado":
        return "bg-slate-100 text-slate-500 border-slate-200";
      default:
        return "bg-slate-50 text-slate-600 border-slate-200";
    }
  }

  document.addEventListener("DOMContentLoaded", async () => {
    const codigo = window.location.pathname.split("/").filter(Boolean).pop();

    if (!codigo || codigo.toLowerCase() === "seguimiento") {
      document.getElementById("cargando").classList.add("hidden");
      document.getElementById("noEncontrado").classList.remove("hidden");
      return;
    }

    const tituloCodigo = document.getElementById("tituloCodigo");
    tituloCodigo.textContent = "Pedido ";
    const spanCodigo = document.createElement("span");
    spanCodigo.className = "italic text-indigo-600";
    spanCodigo.textContent = `#${codigo}`;
    tituloCodigo.appendChild(spanCodigo);

    // Consulta enviando las columnas de montos
    const { data, error } = await supabase
      .from("orders")
      .select("product_title, status, delayed, delay_reason, total_price, monto_total, monto_sena")
      .eq("order_code", codigo);

    document.getElementById("cargando").classList.add("hidden");

    const pedido = !error && data && data.length > 0 ? data[0] : null;

    if (!pedido) {
      document.getElementById("noEncontrado").classList.remove("hidden");
      return;
    }

    document.getElementById("resultado").classList.remove("hidden");
    document.getElementById("tituloPedido").textContent =
      pedido.product_title || "Tu pedido";

    const badge = document.getElementById("badgeEstado");
    badge.textContent = pedido.status || "Sin estado";
    badge.className = `inline-block text-xs font-semibold uppercase tracking-wider border rounded-full px-3 py-1.5 ${badgeColor(pedido.status)}`;

    // Montos y cálculo de saldo
    const total = pedido.monto_total || pedido.total_price || 0;
    const sena = pedido.monto_sena || 0;
    const saldo = Math.max(0, total - sena);

    document.getElementById("outMontoTotal").textContent = `$${total.toLocaleString("es-AR")}`;
    document.getElementById("outMontoSena").textContent = `$${sena.toLocaleString("es-AR")}`;
    
    const elemSaldo = document.getElementById("outSaldoRestante");
    elemSaldo.textContent = `$${saldo.toLocaleString("es-AR")}`;
    
    if (saldo === 0 && total > 0) {
      elemSaldo.className = "text-emerald-600 font-bold";
      elemSaldo.textContent = "¡Pago Completo!";
    } else {
      elemSaldo.className = "text-amber-600 font-bold";
    }

    if (pedido.delayed) {
      const aviso = document.getElementById("avisoDemora");
      aviso.textContent = pedido.delay_reason
        ? `⚠️ Hay una demora: ${pedido.delay_reason}`
        : "⚠️ Este pedido tiene una demora.";
      aviso.classList.remove("hidden");
    }
  });
</script>