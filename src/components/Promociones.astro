---
// Banner de Promociones — Estilo Pastel Mágico
---

<section
  id="seccionPromociones"
  class="hidden max-w-7xl mx-auto px-4 sm:px-6 pt-6 pb-2"
>
  <div
    class="relative rounded-3xl bg-gradient-to-br from-indigo-50/80 via-white to-pink-50/80 p-6 sm:p-8 border border-indigo-100/80 shadow-sm overflow-hidden"
  >
    <!-- Luces pastel de fondo -->
    <div
      class="absolute -top-16 -left-16 w-52 h-52 bg-pink-100/50 rounded-full blur-2xl pointer-events-none"
    >
    </div>
    <div
      class="absolute -bottom-16 -right-16 w-52 h-52 bg-indigo-100/50 rounded-full blur-2xl pointer-events-none"
    >
    </div>

    <!-- Encabezado -->
    <div
      class="flex flex-col sm:flex-row items-center justify-between gap-3 mb-5 pb-3 border-b border-indigo-100/60 relative z-10"
    >
      <div class="flex items-center gap-2.5">
        <span
          class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-[10px] font-bold tracking-widest uppercase bg-pink-100 text-pink-700 border border-pink-200/60"
        >
          <span>✨</span> Oportunidades
        </span>
        <h2 class="text-xl sm:text-2xl font-serif text-indigo-950 font-medium">
          Promociones <span class="italic text-indigo-600">Fuera de Órbita</span
          >
        </h2>
      </div>
      <p class="text-slate-500 text-xs font-light text-center sm:text-right">
        Aprovechá estos beneficios exclusivos por tiempo limitado.
      </p>
    </div>

    <!-- Contenedor dinámico de Promociones -->
    <div
      id="listaPromociones"
      class="flex flex-wrap justify-center gap-4 relative z-10"
    >
    </div>
  </div>
</section>

<script>
  // @ts-nocheck

  const CSV_URL_PROMOCIONES =
    "https://docs.google.com/spreadsheets/d/e/2PACX-1vQRVnI_RqxCSt1wAfQthb5aG1m1NVIbiyjF6rovbmM0hUk2ZoNrLSWkDIlTsRTn2B3PbUXv_NFq8l3q/pub?gid=116458534&single=true&output=csv";

  // Defensa en profundidad: aunque hoy solo Natalia edita esta planilla,
  // escapamos igual por si algún día se copia contenido de otro lado.
  function escapeHtml(texto) {
    if (texto === null || texto === undefined) return "";
    return String(texto)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  function parsearCSV(texto) {
    const filas = [];
    let fila = [];
    let campo = "";
    let dentroComillas = false;

    for (let i = 0; i < texto.length; i++) {
      const c = texto[i];

      if (dentroComillas) {
        if (c === '"' && texto[i + 1] === '"') {
          campo += '"';
          i++;
        } else if (c === '"') {
          dentroComillas = false;
        } else {
          campo += c;
        }
      } else {
        if (c === '"') {
          dentroComillas = true;
        } else if (c === ",") {
          fila.push(campo);
          campo = "";
        } else if (c === "\n" || c === "\r") {
          if (c === "\r" && texto[i + 1] === "\n") i++;
          fila.push(campo);
          filas.push(fila);
          fila = [];
          campo = "";
        } else {
          campo += c;
        }
      }
    }
    if (campo.length > 0 || fila.length > 0) {
      fila.push(campo);
      filas.push(fila);
    }
    return filas.filter((f) => f.some((c) => c.trim() !== ""));
  }

  function esActiva(promo, hoy) {
    const activa = (promo.Activa || "").trim().toUpperCase();
    if (activa !== "SI" && activa !== "SÍ" && activa !== "TRUE") return false;

    if (promo.FechaInicio) {
      const inicio = new Date(promo.FechaInicio);
      if (!isNaN(inicio) && hoy < inicio) return false;
    }
    if (promo.FechaFin) {
      const fin = new Date(promo.FechaFin);
      if (!isNaN(fin) && hoy > fin) return false;
    }
    return true;
  }

  document.addEventListener("DOMContentLoaded", async () => {
    try {
      const response = await fetch(CSV_URL_PROMOCIONES);
      const texto = await response.text();
      const filas = parsearCSV(texto);

      if (filas.length < 2) return;

      const encabezados = filas[0].map((h) => h.trim());
      const promociones = filas.slice(1).map((fila) => {
        const obj = {};
        encabezados.forEach((h, i) => (obj[h] = (fila[i] || "").trim()));
        return obj;
      });

      const hoy = new Date();
      const activas = promociones.filter((p) => esActiva(p, hoy));

      if (activas.length === 0) return;

      const cont = document.getElementById("listaPromociones");
      cont.innerHTML = activas
        .map((p) => {
          const contenido = `
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class="text-[9px] font-bold tracking-wider text-pink-700 uppercase bg-pink-100 border border-pink-200/60 px-2 py-0.5 rounded-full">
                🔥 Promo
              </span>
              ${p.Link ? '<span class="text-[11px] text-indigo-600 font-medium group-hover:translate-x-0.5 transition-transform">Ver →</span>' : ""}
            </div>

            <h3 class="font-serif text-indigo-950 font-medium text-base leading-tight group-hover:text-indigo-600 transition-colors">
              ${escapeHtml(p.Titulo)}
            </h3>

            <p class="text-xs text-slate-600 mt-1 font-light leading-relaxed">
              ${escapeHtml(p.Descripcion)}
            </p>
          `;

          const claseCard =
            "group block flex-1 min-w-[260px] max-w-sm bg-white/90 backdrop-blur-md border border-indigo-100/80 rounded-xl p-4 hover:border-pink-300 hover:bg-white hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 relative overflow-hidden";

          if (p.Link && /^https?:\/\//i.test(p.Link.trim())) {
            return `<a href="${escapeHtml(p.Link)}" target="_blank" rel="noopener noreferrer" class="${claseCard}">${contenido}</a>`;
          }
          return `<div class="${claseCard}">${contenido}</div>`;
        })
        .join("");

      document.getElementById("seccionPromociones").classList.remove("hidden");
    } catch (e) {
      // Oculto por defecto si falla la carga
    }
  });
</script>
