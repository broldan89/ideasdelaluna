---
// Promociones.astro
---

<!-- Banner de Promociones — Estilo Pastel Mágico -->
<section
  id="seccionPromociones"
  class="hidden max-w-7xl mx-auto px-4 sm:px-6 pt-6 pb-2"
>
  <div
    class="relative rounded-3xl bg-gradient-to-br from-indigo-50/80 via-white to-pink-50/80 p-6 sm:p-8 border border-indigo-100/80 shadow-sm overflow-hidden"
  >
    <!-- Luces pastel de fondo -->
    <div
      class="absolute -top-16 -left-16 w-52 h-52 bg-pink-100/50 rounded-full blur-2xl pointer-events-none"
    >
    </div>
    <div
      class="absolute -bottom-16 -right-16 w-52 h-52 bg-indigo-100/50 rounded-full blur-2xl pointer-events-none"
    >
    </div>

    <!-- Encabezado -->
    <div
      class="flex flex-col sm:flex-row items-center justify-between gap-3 mb-5 pb-3 border-b border-indigo-100/60 relative z-10"
    >
      <div class="flex items-center gap-2.5">
        <span
          class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-[10px] font-bold tracking-widest uppercase bg-pink-100 text-pink-700 border border-pink-200/60"
        >
          <span>✨</span> Oportunidades
        </span>
        <h2 class="text-xl sm:text-2xl font-serif text-indigo-950 font-medium">
          Promociones <span class="italic text-indigo-600">Fuera de Órbita</span
          >
        </h2>
      </div>
      <p class="text-slate-500 text-xs font-light text-center sm:text-right">
        Aprovechá estos beneficios exclusivos por tiempo limitado.
      </p>
    </div>

    <!-- Contenedor dinámico de Promociones -->
    <div
      id="listaPromociones"
      class="flex flex-wrap justify-center gap-4 relative z-10"
    >
    </div>
  </div>
</section>

<!-- Modal de Detalle de Promoción con Formulario en 2 Columnas -->
<div
  id="modal-detalle-promo"
  class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-slate-950/80 backdrop-blur-sm transition-opacity duration-300"
>
  <div
    class="bg-white rounded-3xl p-6 sm:p-8 max-w-3xl w-full text-slate-800 shadow-2xl relative overflow-hidden border border-indigo-100 bg-[radial-gradient(#e5e7eb_1px,transparent_1px)] [background-size:16px_16px]"
  >
    <!-- Botón Cerrar -->
    <button
      id="btn-cerrar-modal-promo"
      type="button"
      class="absolute top-4 right-4 text-slate-400 hover:text-slate-600 bg-slate-100/80 hover:bg-slate-200 w-8 h-8 rounded-full flex items-center justify-center transition-all cursor-pointer z-20"
    >
      ✕
    </button>

    <!-- Header del Modal -->
    <div class="mb-4 relative z-10">
      <span
        class="text-[10px] font-bold tracking-wider text-pink-700 uppercase bg-pink-100 border border-pink-200/60 px-3 py-1 rounded-full"
      >
        🔥 Detalle de Promoción
      </span>
      <h3
        id="modal-promo-titulo"
        class="text-2xl font-serif font-medium mt-3 text-indigo-950 leading-tight"
      >
      </h3>
    </div>

    <!-- Grid de 2 Columnas para Escritorio -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 relative z-10">
      <!-- Columna Izquierda: Descripción de la Promoción -->
      <div
        class="flex flex-col justify-between bg-indigo-50/50 p-4 sm:p-5 rounded-2xl border border-indigo-100/80"
      >
        <div>
          <h4
            class="text-xs font-bold uppercase tracking-wider text-indigo-900 mb-2"
          >
            Incluye
          </h4>
          <div
            id="modal-promo-body"
            class="text-slate-600 text-sm leading-relaxed max-h-[35vh] md:max-h-[45vh] overflow-y-auto pr-1"
          >
          </div>
        </div>
        <p class="text-[11px] text-slate-400 mt-4 italic">
          * Personalizamos la gráfica según la temática que elijas.
        </p>
      </div>

      <!-- Columna Derecha: Formulario de Datos -->
      <form
        id="form-pedido-promo"
        onsubmit="return false;"
        class="flex flex-col justify-between space-y-4"
      >
        <div>
          <h4
            class="text-xs font-bold uppercase tracking-wider text-indigo-950 mb-3"
          >
            Datos para el pedido
          </h4>

          <div class="space-y-3">
            <div>
              <label
                for="promo-cliente-nombre"
                class="block text-xs font-medium text-slate-700 mb-1"
              >
                Nombre y Apellido <span class="text-pink-600">*</span>
              </label>
              <input
                type="text"
                id="promo-cliente-nombre"
                placeholder="Ej: María Pérez"
                class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-slate-200 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 outline-none transition-all bg-white text-slate-800"
                required
              />
            </div>

            <div>
              <label
                for="promo-cliente-telefono"
                class="block text-xs font-medium text-slate-700 mb-1"
              >
                Teléfono / WhatsApp <span class="text-pink-600">*</span>
              </label>
              <input
                type="tel"
                id="promo-cliente-telefono"
                placeholder="Ej: 3412141732"
                class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-slate-200 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 outline-none transition-all bg-white text-slate-800"
                required
              />
            </div>

            <div>
              <label
                for="promo-cliente-direccion"
                class="block text-xs font-medium text-slate-700 mb-1"
              >
                Dirección / Localidad <span class="text-slate-400 font-normal"
                  >(Opcional)</span
                >
              </label>
              <input
                type="text"
                id="promo-cliente-direccion"
                placeholder="Ej: Av. Pellegrini 1234, Rosario"
                class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-slate-200 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 outline-none transition-all bg-white text-slate-800"
              />
            </div>
          </div>
        </div>

        <!-- Alerta de validación en tiempo real -->
        <p
          id="msg-error-promo"
          class="hidden text-[11px] text-red-500 font-medium"
        >
          ⚠️ Por favor, ingresá un nombre válido y teléfono completo.
        </p>

        <button
          type="button"
          id="btn-pedir-whatsapp"
          disabled
          class="w-full inline-flex items-center justify-center bg-[#10B981] text-white text-xs font-semibold px-5 py-3.5 rounded-xl transition-all shadow-sm gap-2 disabled:opacity-50 disabled:cursor-not-allowed disabled:bg-slate-300 hover:enabled:bg-[#059669] hover:enabled:shadow-md cursor-pointer mt-2"
        >
          <span>💬</span> Confirmar y Pedir por WhatsApp
        </button>
      </form>
    </div>
  </div>
</div>

<script>
  // @ts-nocheck
  import { supabase } from "../lib/supabase.js";

  function escapeHtml(texto) {
    if (!texto) return "";
    return String(texto)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  // Función para formatear dinámicamente la lista de la promo y destacar el precio
  function renderizarDetallePromo(textoRaw) {
    const contenedor = document.getElementById("modal-promo-body");
    if (!contenedor) return;

    if (!textoRaw) {
      contenedor.innerHTML = `<p class="text-xs text-slate-500 italic">Sin detalles adicionales disponibles.</p>`;
      return;
    }

    // Separar el total si existe la palabra TOTAL
    const partes = textoRaw.split(/TOTAL/i);
    const textoItems = partes[0];
    const precio = partes[1] ? `TOTAL ${partes[1].trim()}` : "";

    // Separar los productos por comas, signos '+' o saltos de línea
    const items = textoItems
      .split(/,|\+|\n/)
      .map((i) => i.trim())
      .filter((i) => i.length > 0);

    let html = `<ul class="space-y-2 mb-3">`;
    items.forEach((item) => {
      html += `
        <li class="flex items-start gap-2 text-xs text-slate-700">
          <span class="text-pink-500 font-bold mt-0.5">•</span>
          <span>${escapeHtml(item)}</span>
        </li>`;
    });
    html += `</ul>`;

    if (precio) {
      html += `
        <div class="mt-3 pt-2.5 border-t border-indigo-100 flex justify-between items-center bg-indigo-50/60 p-2.5 rounded-xl">
          <span class="text-[11px] font-semibold text-indigo-900 uppercase tracking-wider">Valor total:</span>
          <span class="text-sm font-bold text-indigo-950 bg-white px-2.5 py-1 rounded-lg border border-indigo-200/60 shadow-sm">${escapeHtml(
            precio.replace(/^:\s*/, ""),
          )}</span>
        </div>`;
    }

    contenedor.innerHTML = html;
  }

  const validarFormularioPromo = () => {
    const inputNombre = document.getElementById("promo-cliente-nombre");
    const inputTelefono = document.getElementById("promo-cliente-telefono");
    const btnWhatsapp = document.getElementById("btn-pedir-whatsapp");
    const msgError = document.getElementById("msg-error-promo");

    if (!inputNombre || !inputTelefono || !btnWhatsapp) return false;

    const nombreValido = inputNombre.value.trim().length >= 3;
    const soloNumeros = inputTelefono.value.replace(/\D/g, "");
    const telefonoValido = soloNumeros.length >= 7;

    if (nombreValido && telefonoValido) {
      btnWhatsapp.removeAttribute("disabled");
      msgError?.classList.add("hidden");
      return true;
    } else {
      btnWhatsapp.setAttribute("disabled", "true");
      return false;
    }
  };

  async function cargarPromociones() {
    try {
      const hoy = new Date().toISOString().split("T")[0];

      const { data: promociones, error } = await supabase
        .from("promociones")
        .select("*")
        .eq("activa", true)
        .or(`fecha_inicio.is.null,fecha_inicio.lte.${hoy}`)
        .or(`fecha_fin.is.null,fecha_fin.gte.${hoy}`)
        .order("orden", { ascending: true })
        .limit(6);

      if (error) {
        console.error("Error Supabase:", error);
        return;
      }

      if (!promociones || promociones.length === 0) {
        document.getElementById("seccionPromociones")?.classList.add("hidden");
        return;
      }

      const cont = document.getElementById("listaPromociones");
      cont.innerHTML = promociones
        .map((p) => {
          const detalleCompleto =
            p.descripcion_detallada || p.descripcion || "";
          const contenido = `
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class="text-[9px] font-bold tracking-wider text-pink-700 uppercase bg-pink-100 border border-pink-200/60 px-2 py-0.5 rounded-full">
                🔥 Promo
              </span>
              <button 
                type="button" 
                class="btn-ver-detalle-promo text-[11px] text-indigo-600 font-medium hover:underline cursor-pointer transition-transform group-hover:translate-x-0.5"
                data-titulo="${escapeHtml(p.titulo)}"
                data-detalle="${escapeHtml(detalleCompleto)}"
              >
                Ver →
              </button>
            </div>

            <h3 class="font-serif text-indigo-950 font-medium text-base leading-tight group-hover:text-indigo-600 transition-colors">
              ${escapeHtml(p.titulo)}
            </h3>

            <p class="text-xs text-slate-600 mt-1 font-light leading-relaxed">
              ${escapeHtml(p.descripcion)}
            </p>
          `;

          const claseCard =
            "group block flex-1 min-w-[260px] max-w-sm bg-white/90 backdrop-blur-md border border-indigo-100/80 rounded-xl p-4 hover:border-pink-300 hover:bg-white hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 relative overflow-hidden";

          return `<div class="${claseCard}">${contenido}</div>`;
        })
        .join("");

      document.getElementById("seccionPromociones")?.classList.remove("hidden");

      // Asignación de eventos a botones "Ver ->"
      document.querySelectorAll(".btn-ver-detalle-promo").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          e.stopPropagation();
          const titulo = btn.getAttribute("data-titulo");
          const detalle = btn.getAttribute("data-detalle");

          const modal = document.getElementById("modal-detalle-promo");
          const modalTitulo = document.getElementById("modal-promo-titulo");
          const msgError = document.getElementById("msg-error-promo");

          if (msgError) msgError.classList.add("hidden");

          if (modal && modalTitulo) {
            modalTitulo.textContent = titulo;
            renderizarDetallePromo(detalle);
            validarFormularioPromo();
            modal.classList.remove("hidden");
            modal.classList.add("flex");
          }
        });
      });
    } catch (error) {
      console.error("Error cargando promociones:", error);
      document.getElementById("seccionPromociones")?.classList.add("hidden");
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    cargarPromociones();

    const inputNombre = document.getElementById("promo-cliente-nombre");
    const inputTelefono = document.getElementById("promo-cliente-telefono");

    inputNombre?.addEventListener("input", validarFormularioPromo);
    inputTelefono?.addEventListener("input", validarFormularioPromo);

    // Botón para cerrar el modal
    document
      .getElementById("btn-cerrar-modal-promo")
      ?.addEventListener("click", () => {
        const modal = document.getElementById("modal-detalle-promo");
        modal?.classList.add("hidden");
        modal?.classList.remove("flex");
      });

    document
      .getElementById("modal-detalle-promo")
      ?.addEventListener("click", (e) => {
        const modal = document.getElementById("modal-detalle-promo");
        if (e.target === modal) {
          modal.classList.add("hidden");
          modal.classList.remove("flex");
        }
      });
  });

  // Función para generar un número de seguimiento único
  function generarTrackingCode() {
    const chars = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
    let code = "";
    for (let i = 0; i < 5; i++) {
      code += chars.charAt(Math.floor(Math.random() * chars.length));
    }
    return `IDL-${code}`;
  }

  // Escuchador del botón para enviar el pedido a WhatsApp
  document
    .getElementById("btn-pedir-whatsapp")
    ?.addEventListener("click", async () => {
      const btn = document.getElementById("btn-pedir-whatsapp");
      const modalTitulo =
        document.getElementById("modal-promo-titulo")?.textContent || "";
      const modalBody =
        document.getElementById("modal-promo-body")?.innerText || "";

      const nombreCliente =
        document.getElementById("promo-cliente-nombre")?.value.trim() || "";
      const telefonoCliente =
        document.getElementById("promo-cliente-telefono")?.value.trim() || "";
      const direccionCliente =
        document.getElementById("promo-cliente-direccion")?.value.trim() || "";
      const msgError = document.getElementById("msg-error-promo");

      if (!validarFormularioPromo()) {
        if (msgError) msgError.classList.remove("hidden");
        return;
      }

      if (msgError) msgError.classList.add("hidden");

      btn.disabled = true;
      btn.innerText = "Procesando pedido...";

      const trackingCode = generarTrackingCode();
      const linkSeguimiento = `https://ideasdelaluna.netlify.app/seguimiento/${trackingCode}`;

      try {
        // Guardar la Orden en Supabase
        const { error } = await supabase.from("orders").insert([
          {
            order_code: trackingCode,
            product_title: `Promo: ${modalTitulo}`,
            subproducts: [{ label: "Detalle de Promo", value: modalBody }],
            total_price: 0,
            customer_name: nombreCliente,
            customer_phone: telefonoCliente,
            address: direccionCliente,
            status: "Pendiente de Pago",
          },
        ]);

        if (error) {
          console.error("Error al registrar el pedido en Supabase:", error);
        }

        // Armar mensaje para WhatsApp
        let mensajeTexto = `Hola! Mi nombre es *${nombreCliente}*.\n`;
        mensajeTexto += `Quisiera realizar el pedido de la *${modalTitulo}*.\n\n`;
        mensajeTexto += `📌 *Número de seguimiento:* ${trackingCode}\n`;
        mensajeTexto += `🔗 *Link de seguimiento:* ${linkSeguimiento}\n`;

        if (direccionCliente) {
          mensajeTexto += `📍 *Dirección:* ${direccionCliente}\n`;
        }

        mensajeTexto += `\n🎨 Quisiera personalizar el diseño de mi pedido.`;

        const mensajeWA = encodeURIComponent(mensajeTexto);
        const telefonoEmpresa = "5493412141732";
        const urlWA = `https://api.whatsapp.com/send?phone=${telefonoEmpresa}&text=${mensajeWA}`;

        window.open(urlWA, "_blank");

        const modal = document.getElementById("modal-detalle-promo");
        modal?.classList.add("hidden");
        modal?.classList.remove("flex");

        // Limpiar inputs
        document.getElementById("promo-cliente-nombre").value = "";
        document.getElementById("promo-cliente-telefono").value = "";
        document.getElementById("promo-cliente-direccion").value = "";
      } catch (err) {
        console.error("Error en el proceso:", err);
      } finally {
        btn.disabled = false;
        btn.innerHTML = `<span>💬</span> Confirmar y Pedir por WhatsApp`;
      }
    });
</script>
