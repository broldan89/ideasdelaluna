---
// Banner de Promociones — se alimenta de una pestaña dedicada en la misma
// planilla de Sheets que usa el Cotizador. Se lee directo desde el navegador
// (no pasa por un endpoint del sitio) para que actualizar la planilla alcance,
// sin necesidad de un nuevo deploy.
---

<section
  id="seccionPromociones"
  class="hidden max-w-7xl mx-auto px-6 pt-10 pb-4 sm:pt-14"
>
  <div id="listaPromociones" class="flex flex-wrap justify-center gap-4"></div>
</section>

<script>
  // @ts-nocheck

  // TODO: reemplazar por el link publicado de la pestaña "Promociones".
  // Cómo obtenerlo: en la planilla → Archivo → Compartir → Publicar en la web
  // → elegís la hoja "Promociones" (no "Toda la planilla") → formato CSV →
  // Publicar → copiás el link que te da y lo pegás acá abajo.
  const CSV_URL_PROMOCIONES =
    "https://docs.google.com/spreadsheets/d/e/2PACX-1vQRVnI_RqxCSt1wAfQthb5aG1m1NVIbiyjF6rovbmM0hUk2ZoNrLSWkDIlTsRTn2B3PbUXv_NFq8l3q/pub?gid=116458534&single=true&output=csv";

  // Parser de CSV simple que respeta comillas (para que las descripciones
  // puedan tener comas sin romper las columnas).
  function parsearCSV(texto) {
    const filas = [];
    let fila = [];
    let campo = "";
    let dentroComillas = false;

    for (let i = 0; i < texto.length; i++) {
      const c = texto[i];

      if (dentroComillas) {
        if (c === '"' && texto[i + 1] === '"') {
          campo += '"';
          i++;
        } else if (c === '"') {
          dentroComillas = false;
        } else {
          campo += c;
        }
      } else {
        if (c === '"') {
          dentroComillas = true;
        } else if (c === ",") {
          fila.push(campo);
          campo = "";
        } else if (c === "\n" || c === "\r") {
          if (c === "\r" && texto[i + 1] === "\n") i++;
          fila.push(campo);
          filas.push(fila);
          fila = [];
          campo = "";
        } else {
          campo += c;
        }
      }
    }
    if (campo.length > 0 || fila.length > 0) {
      fila.push(campo);
      filas.push(fila);
    }
    return filas.filter((f) => f.some((c) => c.trim() !== ""));
  }

  function esActiva(promo, hoy) {
    const activa = (promo.Activa || "").trim().toUpperCase();
    if (activa !== "SI" && activa !== "SÍ" && activa !== "TRUE") return false;

    if (promo.FechaInicio) {
      const inicio = new Date(promo.FechaInicio);
      if (!isNaN(inicio) && hoy < inicio) return false;
    }
    if (promo.FechaFin) {
      const fin = new Date(promo.FechaFin);
      if (!isNaN(fin) && hoy > fin) return false;
    }
    return true;
  }

  document.addEventListener("DOMContentLoaded", async () => {
    try {
      const response = await fetch(CSV_URL_PROMOCIONES);
      const texto = await response.text();
      const filas = parsearCSV(texto);

      if (filas.length < 2) return;

      const encabezados = filas[0].map((h) => h.trim());
      const promociones = filas.slice(1).map((fila) => {
        const obj = {};
        encabezados.forEach((h, i) => (obj[h] = (fila[i] || "").trim()));
        return obj;
      });

      const hoy = new Date();
      const activas = promociones.filter((p) => esActiva(p, hoy));

      if (activas.length === 0) return;

      const cont = document.getElementById("listaPromociones");
      cont.innerHTML = activas
        .map((p) => {
          const contenido = `
            <span class="text-[10px] font-semibold tracking-widest text-pink-600 uppercase bg-pink-50 px-2.5 py-1 rounded-full">
              Promo
            </span>
            <p class="font-serif text-indigo-950 font-medium text-lg mt-3">${p.Titulo || ""}</p>
            <p class="text-sm text-slate-600 mt-1.5">${p.Descripcion || ""}</p>
          `;

          const claseCard =
            "block w-full sm:w-72 bg-gradient-to-br from-indigo-50 via-white to-pink-50 border border-indigo-100 rounded-2xl p-6 hover:shadow-md hover:-translate-y-0.5 transition-all";

          if (p.Link) {
            return `<a href="${p.Link}" target="_blank" class="${claseCard}">${contenido}</a>`;
          }
          return `<div class="${claseCard}">${contenido}</div>`;
        })
        .join("");

      document.getElementById("seccionPromociones").classList.remove("hidden");
    } catch (e) {
      // Si falla la carga de promociones, el sitio sigue funcionando normal
      // y la sección simplemente no aparece.
    }
  });
</script>
