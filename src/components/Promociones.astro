---
// Banner de Promociones — Glam & Cosmic Style
---

<section
  id="seccionPromociones"
  class="hidden max-w-7xl mx-auto px-4 sm:px-6 pt-6 pb-2"
>
  <div
    class="relative rounded-3xl bg-gradient-to-r from-slate-950 via-indigo-950 to-slate-900 p-6 sm:p-10 border border-pink-500/30 shadow-[0_0_35px_rgba(236,72,153,0.15)] overflow-hidden"
  >
    <!-- Glows y luces de fondo -->
    <div
      class="absolute -top-24 -left-24 w-72 h-72 bg-pink-500/20 rounded-full blur-3xl pointer-events-none"
    >
    </div>
    <div
      class="absolute -bottom-24 -right-24 w-72 h-72 bg-purple-500/20 rounded-full blur-3xl pointer-events-none"
    >
    </div>

    <!-- Encabezado Glam -->
    <div class="text-center max-w-lg mx-auto mb-8 relative z-10">
      <span
        class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full text-[11px] font-bold tracking-widest uppercase bg-gradient-to-r from-pink-500 to-purple-500 text-white shadow-md shadow-pink-500/20 animate-pulse"
      >
        <span>✨</span> Oportunidades Especiales
      </span>
      <h2 class="text-2xl sm:text-3xl font-serif text-white font-normal mt-2.5">
        Promociones <span
          class="italic text-transparent bg-clip-text bg-gradient-to-r from-pink-300 via-purple-300 to-indigo-200"
          >Fuera de Órbita</span
        >
      </h2>
      <p class="text-indigo-200/70 text-xs sm:text-sm font-light mt-1">
        Aprovechá nuestros beneficios exclusivos por tiempo limitado.
      </p>
    </div>

    <!-- Contenedor dinámico de Promociones -->
    <div
      id="listaPromociones"
      class="flex flex-wrap justify-center gap-6 relative z-10"
    >
    </div>
  </div>
</section>

<script>
  // @ts-nocheck

  const CSV_URL_PROMOCIONES =
    "https://docs.google.com/spreadsheets/d/e/2PACX-1vQRVnI_RqxCSt1wAfQthb5aG1m1NVIbiyjF6rovbmM0hUk2ZoNrLSWkDIlTsRTn2B3PbUXv_NFq8l3q/pub?gid=116458534&single=true&output=csv";

  function parsearCSV(texto) {
    const filas = [];
    let fila = [];
    let campo = "";
    let dentroComillas = false;

    for (let i = 0; i < texto.length; i++) {
      const c = texto[i];

      if (dentroComillas) {
        if (c === '"' && texto[i + 1] === '"') {
          campo += '"';
          i++;
        } else if (c === '"') {
          dentroComillas = false;
        } else {
          campo += c;
        }
      } else {
        if (c === '"') {
          dentroComillas = true;
        } else if (c === ",") {
          fila.push(campo);
          campo = "";
        } else if (c === "\n" || c === "\r") {
          if (c === "\r" && texto[i + 1] === "\n") i++;
          fila.push(campo);
          filas.push(fila);
          fila = [];
          campo = "";
        } else {
          campo += c;
        }
      }
    }
    if (campo.length > 0 || fila.length > 0) {
      fila.push(campo);
      filas.push(fila);
    }
    return filas.filter((f) => f.some((c) => c.trim() !== ""));
  }

  function esActiva(promo, hoy) {
    const activa = (promo.Activa || "").trim().toUpperCase();
    if (activa !== "SI" && activa !== "SÍ" && activa !== "TRUE") return false;

    if (promo.FechaInicio) {
      const inicio = new Date(promo.FechaInicio);
      if (!isNaN(inicio) && hoy < inicio) return false;
    }
    if (promo.FechaFin) {
      const fin = new Date(promo.FechaFin);
      if (!isNaN(fin) && hoy > fin) return false;
    }
    return true;
  }

  document.addEventListener("DOMContentLoaded", async () => {
    try {
      const response = await fetch(CSV_URL_PROMOCIONES);
      const texto = await response.text();
      const filas = parsearCSV(texto);

      if (filas.length < 2) return;

      const encabezados = filas[0].map((h) => h.trim());
      const promociones = filas.slice(1).map((fila) => {
        const obj = {};
        encabezados.forEach((h, i) => (obj[h] = (fila[i] || "").trim()));
        return obj;
      });

      const hoy = new Date();
      const activas = promociones.filter((p) => esActiva(p, hoy));

      if (activas.length === 0) return;

      const cont = document.getElementById("listaPromociones");
      cont.innerHTML = activas
        .map((p) => {
          const contenido = `
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="text-[10px] font-bold tracking-widest text-pink-300 uppercase bg-pink-500/20 border border-pink-500/30 px-3 py-1 rounded-full shadow-inner">
                🔥 Imperdible
              </span>
              ${p.Link ? '<span class="text-xs text-pink-300 font-medium group-hover:translate-x-1 transition-transform">Ver promo →</span>' : ""}
            </div>

            <h3 class="font-serif text-white font-medium text-xl leading-snug group-hover:text-pink-200 transition-colors">
              ${p.Titulo || ""}
            </h3>

            <p class="text-xs text-indigo-100/80 mt-2 font-light leading-relaxed">
              ${p.Descripcion || ""}
            </p>
          `;

          const claseCard =
            "group block w-full sm:w-80 bg-white/10 backdrop-blur-md border border-white/15 rounded-2xl p-6 hover:border-pink-400/50 hover:bg-white/15 hover:shadow-[0_10px_25px_rgba(236,72,153,0.25)] hover:-translate-y-1 transition-all duration-300 relative overflow-hidden";

          if (p.Link) {
            return `<a href="${p.Link}" target="_blank" class="${claseCard}">${contenido}</a>`;
          }
          return `<div class="${claseCard}">${contenido}</div>`;
        })
        .join("");

      document.getElementById("seccionPromociones").classList.remove("hidden");
    } catch (e) {
      // Si falla la carga de promociones, la sección simplemente se oculta.
    }
  });
</script>
