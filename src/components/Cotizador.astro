---
/* Cotizador.astro - Conexión dinámica con Google Sheets */
---

<section
  id="cotizador"
  class="max-w-4xl mx-auto px-3 sm:px-6 py-8 sm:py-16 scroll-mt-20"
>
  <div class="text-center mb-6 sm:mb-10">
    <span
      class="text-[10px] sm:text-xs font-semibold tracking-widest text-indigo-600 uppercase bg-indigo-50 px-2.5 py-1 rounded-full"
    >
      Calculadora al instante
    </span>
    <h2
      class="text-2xl sm:text-4xl font-serif text-indigo-950 font-medium mt-3"
    >
      Cotiza tu <span class="italic text-indigo-600">Documento o Apunte</span>
    </h2>
    <p
      class="text-slate-500 text-xs sm:text-sm mt-1.5 font-light max-w-md mx-auto leading-relaxed"
    >
      Subí tu archivo, elegí las terminaciones y obtené el presupuesto exacto en
      segundos.
    </p>
  </div>

  <div class="cotizador-card-wrapper">
    <div
      class="cotizador-card bg-white p-4 sm:p-8 rounded-2xl sm:rounded-none shadow-sm border border-indigo-50"
    >
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 sm:gap-8">
        <!-- CONTROLES -->
        <div class="space-y-4 sm:space-y-6">
          <!-- 1. DROPZONE -->
          <div>
            <span
              class="block text-[11px] sm:text-xs font-semibold text-indigo-950 uppercase tracking-wider mb-1.5"
            >
              1. Cargar Documento
            </span>

            <label
              for="pdfInput"
              id="dropzone"
              class="border-2 border-dashed border-indigo-200 hover:border-indigo-400 bg-indigo-50/40 hover:bg-indigo-50 transition-all rounded-xl p-3.5 sm:p-6 text-center cursor-pointer flex flex-col items-center justify-center min-h-[110px] sm:min-h-[140px] select-none"
            >
              <input
                type="file"
                id="pdfInput"
                accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.jpg,.jpeg,.png,.webp,.txt,.odt,.ods"
                class="hidden"
              />
              <span class="text-2xl sm:text-3xl mb-1 pointer-events-none"
                >📄</span
              >
              <p
                id="fileName"
                class="text-xs font-medium text-indigo-950 pointer-events-none break-all px-1"
              >
                Toca o arrastra tu archivo aquí
              </p>
              <p
                id="fileStatus"
                class="text-[10px] sm:text-[11px] text-slate-400 font-light mt-0.5 pointer-events-none"
              >
                PDF, Word, Excel, Imágenes y más
              </p>
            </label>
          </div>

          <!-- 2. MODALIDAD -->
          <div>
            <label
              class="block text-[11px] sm:text-xs font-semibold text-indigo-950 uppercase tracking-wider mb-1.5"
            >
              2. Modalidad de Impresión
            </label>
            <div class="grid grid-cols-2 gap-2">
              <button
                type="button"
                data-type="simple"
                class="opt-impresion active border border-indigo-600 bg-indigo-50/80 text-indigo-950 text-xs py-2 px-2 rounded-lg font-medium transition-all text-center"
              >
                Simple Faz
              </button>
              <button
                type="button"
                data-type="doble"
                class="opt-impresion border border-slate-200 bg-white text-slate-600 text-xs py-2 px-2 rounded-lg font-medium transition-all text-center"
              >
                Doble Faz
              </button>
            </div>
          </div>

          <!-- 3. COLOR -->
          <div>
            <label
              class="block text-[11px] sm:text-xs font-semibold text-indigo-950 uppercase tracking-wider mb-1.5"
            >
              3. Tipo de Color
            </label>
            <div class="grid grid-cols-2 gap-2">
              <button
                type="button"
                data-color="bn"
                class="opt-color active border border-indigo-600 bg-indigo-50/80 text-indigo-950 text-xs py-2 px-2 rounded-lg font-medium transition-all text-center"
              >
                Blanco y Negro
              </button>
              <button
                type="button"
                data-color="color"
                class="opt-color border border-slate-200 bg-white text-slate-600 text-xs py-2 px-2 rounded-lg font-medium transition-all text-center"
              >
                Color
              </button>
            </div>
          </div>

          <!-- 4. ACABADO -->
          <div>
            <label
              class="block text-[11px] sm:text-xs font-semibold text-indigo-950 uppercase tracking-wider mb-1.5"
            >
              4. Terminación / Acabado
            </label>
            <select
              id="selectEncuadernacion"
              class="w-full bg-slate-50 border border-slate-200 text-slate-700 text-xs rounded-xl p-2.5 focus:outline-none font-medium cursor-pointer"
            >
              <option value="ninguno">Sin encuadernar (Suelto)</option>
              <option value="anillado">Anillado / Espiralado</option>
            </select>
          </div>

          <!-- 5. COPIAS -->
          <div>
            <label
              for="inputCopias"
              class="block text-[11px] sm:text-xs font-semibold text-indigo-950 uppercase tracking-wider mb-1.5"
            >
              5. Cantidad de Copias
            </label>
            <input
              type="number"
              id="inputCopias"
              min="1"
              value="1"
              class="w-28 bg-slate-50 border border-slate-200 text-indigo-950 text-xs rounded-xl p-2.5 focus:outline-none font-bold text-center"
            />
          </div>

          <!-- 6. TELÉFONO DE CONTACTO -->
          <div>
            <label
              for="inputTelefono"
              class="block text-[11px] sm:text-xs font-semibold text-indigo-950 uppercase tracking-wider mb-1.5"
            >
              6. Tu WhatsApp (para avisarte del estado)
            </label>
            <input
              type="tel"
              id="inputTelefono"
              placeholder="Ej: 3411234567"
              class="w-full bg-slate-50 border border-slate-200 text-indigo-950 text-xs rounded-xl p-2.5 focus:outline-none font-medium"
            />
          </div>
        </div>

        <!-- RESUMEN -->
        <div
          class="bg-indigo-50/50 rounded-xl p-4 sm:p-6 flex flex-col justify-between border border-indigo-100/60 mt-2 sm:mt-0"
        >
          <div>
            <h3
              class="font-serif font-medium text-indigo-950 text-base mb-3 pb-2 border-b border-indigo-100"
            >
              Resumen del Pedido
            </h3>
            <div class="space-y-2 text-xs font-light text-slate-600">
              <div class="flex justify-between items-center">
                <span>Páginas detectadas:</span>
                <span id="resPaginas" class="font-semibold text-indigo-950"
                  >0 págs</span
                >
              </div>
              <div class="flex justify-between items-center">
                <span>Hojas a utilizar:</span>
                <span id="resHojas" class="font-semibold text-indigo-950"
                  >0 hojas</span
                >
              </div>
              <div class="flex justify-between items-center">
                <span>Costo por impresión:</span>
                <span id="resCostoHoja" class="font-semibold text-indigo-950"
                  >$0</span
                >
              </div>
              <div class="flex justify-between items-center">
                <span>Encuadernación:</span>
                <span
                  id="resEncuadernacion"
                  class="font-semibold text-indigo-950">$0</span
                >
              </div>
            </div>
          </div>

          <div class="mt-5 pt-3 border-t border-indigo-100">
            <div class="flex justify-between items-baseline mb-3">
              <span
                class="text-xs uppercase tracking-wider font-semibold text-slate-500"
                >Total Estimado:</span
              >
              <span
                id="totalPrecio"
                class="text-2xl font-serif font-bold text-indigo-950">$0</span
              >
            </div>

            <button
              id="btnEnviarWhatsApp"
              disabled
              class="w-full bg-slate-300 text-white cursor-not-allowed font-semibold py-3 px-4 rounded-full text-xs tracking-wider transition-all flex items-center justify-center gap-2"
            >
              <span>💬</span> Encargar por WhatsApp
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Librería para lectura de páginas PDF cliente -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"
></script>

<script>
  // @ts-nocheck
  import { supabase } from "../lib/supabase.js";

  // Tablas de precios por defecto en caso de fallo de red
  let tablaPrecios = {
    S01: 150, // Impresión Simple Faz B/N
    S02: 220, // Impresión Simple Faz Color
    S03: 180, // Impresión Doble Faz B/N
    S04: 270, // Impresión Doble Faz Color
    S13: 3000, // Anillado 1 a 9 copias
    S14: 2500, // Anillado 10+ copias
  };

  let tablaPapeles = {
    P01: 12.8, // Hoja Obra 70g (por defecto)
  };

  let estadoCotizador = {
    paginas: 0,
    modalidad: "simple", // 'simple' | 'doble'
    color: "bn", // 'bn' | 'color'
    encuadernacion: "ninguno", // 'ninguno' | 'anillado'
    idPapel: "P01", // Papel base utilizado
    copias: 1,
    nombreArchivo: "",
    archivoUrl: "",
    telefono: "",
    totalCalculado: 0,
  };

  // Cargar lista actualizada desde ambos endpoints
  async function sincronizarPrecios() {
    try {
      const [resServicios, resPapeles] = await Promise.all([
        fetch("/api/precios.json"),
        fetch("/api/precios-papel.json"),
      ]);

      if (resServicios.ok) {
        const dataServicios = await resServicios.json();
        tablaPrecios = { ...tablaPrecios, ...dataServicios };
      }

      if (resPapeles.ok) {
        const dataPapeles = await resPapeles.json();
        tablaPapeles = { ...tablaPapeles, ...dataPapeles };
      }
    } catch (e) {
      console.warn("Utilizando valores locales por omisión.", e);
    }
  }

  // Sube el archivo a Supabase Storage y devuelve la URL pública, o null si falla
  async function subirArchivo(file) {
    if (!supabase) return null;

    try {
      const ext = file.name.split(".").pop();
      const nombreLimpio = file.name.replace(/[^a-zA-Z0-9]/g, "_");
      const path = `pdf_${Date.now()}_${nombreLimpio}.${ext}`;

      const { data: uploadData, error: uploadError } = await supabase.storage
        .from("pdfs-cotizador")
        .upload(path, file, { cacheControl: "3600", upsert: true });

      if (uploadError) {
        alert(
          `Atención: El archivo no se pudo subir a la nube (${uploadError.message}). Volvé a intentar.`,
        );
        return null;
      }

      const { data: publicUrlData } = supabase.storage
        .from("pdfs-cotizador")
        .getPublicUrl(uploadData.path);

      return publicUrlData?.publicUrl || null;
    } catch (e) {
      alert(
        "Atención: El archivo no se pudo subir a la nube. Volvé a intentar.",
      );
      return null;
    }
  }

  function calcularTotal() {
    const {
      paginas,
      modalidad,
      color,
      encuadernacion,
      copias,
      idPapel,
      archivoUrl,
    } = estadoCotizador;

    if (paginas <= 0 || !archivoUrl) {
      document.getElementById("resPaginas").textContent = "0 págs";
      document.getElementById("resHojas").textContent = "0 hojas";
      document.getElementById("resCostoHoja").textContent = "$0";
      document.getElementById("resEncuadernacion").textContent = "$0";
      document.getElementById("totalPrecio").textContent = "$0";

      const btn = document.getElementById("btnEnviarWhatsApp");
      btn.disabled = true;
      btn.className =
        "w-full bg-slate-300 text-white cursor-not-allowed font-semibold py-3 px-4 rounded-full text-xs tracking-wider transition-all flex items-center justify-center gap-2";
      return;
    }

    /// 1. Cálculo de hojas físicas necesarias
    const hojas = modalidad === "doble" ? Math.ceil(paginas / 2) : paginas;

    let costoServicioImpresion = 0;
    if (modalidad === "doble") {
      costoServicioImpresion =
        color === "color" ? tablaPrecios.S04 || 270 : tablaPrecios.S03 || 180;
    } else {
      costoServicioImpresion =
        color === "color" ? tablaPrecios.S02 || 220 : tablaPrecios.S01 || 150;
    }

    // 3. Costo del servicio de impresión
    let costoServicioImpresion = 0;
    if (modalidad === "doble") {
      costoServicioImpresion =
        color === "color" ? tablaPrecios.S04 || 64 : tablaPrecios.S03 || 64;
    } else {
      costoServicioImpresion =
        color === "color" ? tablaPrecios.S02 || 32 : tablaPrecios.S01 || 32;
    }
    const costoTotalServicioUnidad = hojas * costoServicioImpresion;

    // Total de Impresión (Papel + Servicio) por cada juego/copia
    const subtotalImpresionPorCopia = hojas * costoServicioImpresion;

    // 4. Costo de Anillado / Encuadernación por copia
    // Si la cantidad de copias es >= 10 toma S14 ($2.500), de lo contrario S13 ($3.000)
    let costoAnilladoUnitario = 0;
    if (encuadernacion === "anillado") {
      costoAnilladoUnitario =
        copias >= 10 ? tablaPrecios.S14 || 2500 : tablaPrecios.S13 || 3000;
    }

    // 5. Totales generales del pedido
    const costoImpresionTotal = subtotalImpresionPorCopia * copias;
    const costoAnilladoTotal = costoAnilladoUnitario * copias;
    const totalFinal = costoImpresionTotal + costoAnilladoTotal;

    estadoCotizador.totalCalculado = totalFinal;

    // Actualización de la interfaz
    document.getElementById("resPaginas").textContent = `${paginas} págs`;
    document.getElementById("resHojas").textContent = `${hojas} hojas`;
    document.getElementById("resCostoHoja").textContent =
      `$${costoImpresionTotal.toLocaleString("es-AR")}`;
    document.getElementById("resEncuadernacion").textContent =
      `$${costoAnilladoTotal.toLocaleString("es-AR")}`;
    document.getElementById("totalPrecio").textContent =
      `$${totalFinal.toLocaleString("es-AR")}`;

    // Habilitación del botón WhatsApp
    const btn = document.getElementById("btnEnviarWhatsApp");
    btn.disabled = false;
    btn.className =
      "w-full bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-3 px-4 rounded-full text-xs tracking-wider transition-all shadow-md flex items-center justify-center gap-2 cursor-pointer";
  }

  function inicializarEventos() {
    const inputPdf = document.getElementById("pdfInput");
    const selectEncuadernacion = document.getElementById(
      "selectEncuadernacion",
    );
    const inputCopias = document.getElementById("inputCopias");
    const inputTelefono = document.getElementById("inputTelefono");
    const btnWhatsApp = document.getElementById("btnEnviarWhatsApp");

    // Manejo de archivo subido
    inputPdf.addEventListener("change", async (e) => {
      const file = e.target.files[0];
      if (!file) return;

      estadoCotizador.nombreArchivo = file.name;
      estadoCotizador.archivoUrl = "";
      document.getElementById("fileName").textContent = file.name;
      document.getElementById("fileStatus").textContent =
        `${(file.size / (1024 * 1024)).toFixed(2)} MB`;

      if (file.type === "application/pdf") {
        try {
          const arrayBuffer = await file.arrayBuffer();
          if (window.pdfjsLib) {
            window.pdfjsLib.GlobalWorkerOptions.workerSrc =
              "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js";
            const pdf = await window.pdfjsLib.getDocument({ data: arrayBuffer })
              .promise;
            estadoCotizador.paginas = pdf.numPages;
          } else {
            estadoCotizador.paginas = 10;
          }
        } catch (err) {
          estadoCotizador.paginas = 10;
        }
      } else {
        estadoCotizador.paginas = 1;
      }

      // Subida a Supabase Storage
      document.getElementById("fileStatus").textContent =
        "☁️ Subiendo a la nube...";
      const btnMientrasSube = document.getElementById("btnEnviarWhatsApp");
      btnMientrasSube.disabled = true;

      const urlSubida = await subirArchivo(file);
      estadoCotizador.archivoUrl = urlSubida || "";

      if (!urlSubida) {
        document.getElementById("fileStatus").textContent =
          "⚠️ No se pudo subir. Probá subiéndolo de nuevo.";
        calcularTotal();
        return;
      }

      document.getElementById("fileStatus").textContent =
        `${(file.size / (1024 * 1024)).toFixed(2)} MB — subido ✅`;

      calcularTotal();
    });

    // Alternar Modalidad (Simple / Doble)
    document.querySelectorAll(".opt-impresion").forEach((btn) => {
      btn.addEventListener("click", () => {
        document.querySelectorAll(".opt-impresion").forEach((b) => {
          b.classList.remove(
            "active",
            "border-indigo-600",
            "bg-indigo-50/80",
            "text-indigo-950",
          );
          b.classList.add("border-slate-200", "bg-white", "text-slate-600");
        });
        btn.classList.add(
          "active",
          "border-indigo-600",
          "bg-indigo-50/80",
          "text-indigo-950",
        );
        btn.classList.remove("border-slate-200", "bg-white", "text-slate-600");

        estadoCotizador.modalidad = btn.dataset.type;
        calcularTotal();
      });
    });

    // Alternar Color (BN / Color)
    document.querySelectorAll(".opt-color").forEach((btn) => {
      btn.addEventListener("click", () => {
        document.querySelectorAll(".opt-color").forEach((b) => {
          b.classList.remove(
            "active",
            "border-indigo-600",
            "bg-indigo-50/80",
            "text-indigo-950",
          );
          b.classList.add("border-slate-200", "bg-white", "text-slate-600");
        });
        btn.classList.add(
          "active",
          "border-indigo-600",
          "bg-indigo-50/80",
          "text-indigo-950",
        );
        btn.classList.remove("border-slate-200", "bg-white", "text-slate-600");

        estadoCotizador.color = btn.dataset.color;
        calcularTotal();
      });
    });

    // Encuadernación
    selectEncuadernacion.addEventListener("change", (e) => {
      estadoCotizador.encuadernacion = e.target.value;
      calcularTotal();
    });

    // Copias
    inputCopias.addEventListener("input", (e) => {
      const val = parseInt(e.target.value);
      estadoCotizador.copias = isNaN(val) || val < 1 ? 1 : val;
      calcularTotal();
    });

    // Teléfono de contacto
    inputTelefono.addEventListener("input", (e) => {
      estadoCotizador.telefono = e.target.value.replace(/[^0-9]/g, "");
    });

    // Enviar Pedido a WhatsApp
    btnWhatsApp.addEventListener("click", async () => {
      if (estadoCotizador.paginas <= 0 || !estadoCotizador.archivoUrl) return;

      if (estadoCotizador.telefono.length < 8) {
        alert(
          "Ingresá tu número de WhatsApp para poder avisarte del estado de tu pedido.",
        );
        inputTelefono.focus();
        return;
      }

      btnWhatsApp.disabled = true;
      btnWhatsApp.textContent = "⏳ Generando pedido...";

      let codigoPedido = "";

      if (supabase) {
        try {
          const detalle = [
            { label: "Páginas", value: estadoCotizador.paginas },
            {
              label: "Modalidad",
              value:
                estadoCotizador.modalidad === "simple"
                  ? "Simple Faz"
                  : "Doble Faz",
            },
            {
              label: "Tipo",
              value:
                estadoCotizador.color === "color" ? "Color" : "Blanco y Negro",
            },
            {
              label: "Terminación",
              value:
                estadoCotizador.encuadernacion === "anillado"
                  ? "Anillado / Espiralado"
                  : "Sin encuadernar",
            },
            { label: "Copias", value: estadoCotizador.copias },
          ];

          const { data, error } = await supabase
            .from("orders")
            .insert([
              {
                product_title: `Impresión: ${estadoCotizador.nombreArchivo}`,
                subproducts: detalle,
                total_price: estadoCotizador.totalCalculado,
                pdf_url: estadoCotizador.archivoUrl,
                customer_phone: estadoCotizador.telefono,
                status: "Pendiente de Pago",
              },
            ])
            .select("order_code")
            .single();

          if (!error && data) {
            codigoPedido = data.order_code;
          } else if (error) {
            alert(
              `Atención: El pedido no se pudo guardar en el sistema (${error.message}). El mensaje de WhatsApp se va a enviar igual, pero avisá para registrar la orden manualmente.`,
            );
          }
        } catch (e) {
          alert(
            "Atención: El pedido no se pudo guardar en el sistema. El mensaje de WhatsApp se va a enviar igual, pero avisá para registrar la orden manualmente.",
          );
        }
      }

      btnWhatsApp.disabled = false;
      btnWhatsApp.innerHTML = "<span>💬</span> Encargar por WhatsApp";

      const encabezadoCodigo = codigoPedido ? ` *#${codigoPedido}*` : "";
      const lineaSeguimiento = codigoPedido
        ? `\n• *Seguí tu pedido:* https://ideasdelaluna.netlify.app/seguimiento/${codigoPedido}`
        : "";

      const mensaje = `¡Hola! Quisiera encargar la impresión de un documento con el siguiente detalle${encabezadoCodigo}:
• *Archivo:* ${estadoCotizador.nombreArchivo || "Documento"}
• *Páginas:* ${estadoCotizador.paginas}
• *Modalidad:* ${estadoCotizador.modalidad === "simple" ? "Simple Faz" : "Doble Faz"}
• *Tipo:* ${estadoCotizador.color === "color" ? "Color" : "Blanco y Negro"}
• *Terminación:* ${estadoCotizador.encuadernacion === "anillado" ? "Anillado / Espiralado" : "Sin encuadernar"}
• *Copias:* ${estadoCotizador.copias}
• *Total Estimado:* $${estadoCotizador.totalCalculado.toLocaleString("es-AR")}${lineaSeguimiento}`;

      const url = `https://api.whatsapp.com/send?phone=5493412141732&text=${encodeURIComponent(mensaje)}`;
      window.open(url, "_blank");
    });
  }

  document.addEventListener("DOMContentLoaded", async () => {
    await sincronizarPrecios();
    inicializarEventos();
  });
</script>
