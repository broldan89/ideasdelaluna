---
interface SubProduct {
  name: string;
  desc: string;
}

interface Props {
  id: string;
  title: string;
  description: string;
  badge: string;
  imageSrc: string;
  hoverImageSrc: string;
  galleryImages?: string[];
  subProducts?: SubProduct[];
  isProximamente?: boolean;
  proximamenteText?: string;
}

const {
  id,
  title,
  description,
  badge,
  imageSrc,
  hoverImageSrc,
  galleryImages = [],
  subProducts = [],
  isProximamente = false,
  proximamenteText = "En el taller de diseño",
} = Astro.props;

const allImages =
  galleryImages.length > 0
    ? galleryImages
    : [imageSrc, hoverImageSrc].filter(Boolean);
---

<div
  class="w-full bg-[#FAF8FC]/90 backdrop-blur-sm rounded-2xl overflow-hidden border border-[#EBE3F0] shadow-xs hover:shadow-md transition-all duration-300 flex flex-col group transform hover:-translate-y-1 mx-auto"
>
  <div
    class="relative overflow-hidden aspect-[4/3] bg-slate-100 w-full group/img cursor-pointer"
    data-action="open-card-gallery"
    data-title={title}
    data-images={JSON.stringify(allImages)}
  >
    <img
      src={imageSrc}
      alt={title}
      class="w-full h-full object-cover absolute inset-0 z-10 transition-opacity duration-500 group-hover/img:opacity-0"
    />
    <img
      src={hoverImageSrc || imageSrc}
      alt={`${title} detalle`}
      class="w-full h-full object-cover absolute inset-0 z-0 transition-transform duration-500 scale-100 group-hover/img:scale-105"
    />

    <div
      class="absolute top-2.5 left-2.5 right-2.5 flex flex-wrap items-center justify-between gap-1 z-20 pointer-events-none"
    >
      <span
        class="bg-white/95 backdrop-blur-md text-slate-700 text-[9px] sm:text-[10px] font-bold tracking-wider uppercase px-2.5 py-0.5 rounded-full shadow-xs border border-white/40"
      >
        {badge}
      </span>
      {
        isProximamente && (
          <span class="bg-amber-100/95 backdrop-blur-md text-amber-900 border border-amber-200/60 text-[9px] font-semibold tracking-wide px-2 py-0.5 rounded-full shadow-xs">
            Próximamente
          </span>
        )
      }
    </div>

    <div
      class="absolute bottom-2.5 right-2.5 bg-white/95 group-hover/img:bg-pink-600 text-indigo-950 group-hover/img:text-white text-[10px] font-semibold px-3 py-1 rounded-full z-20 shadow-xs backdrop-blur-md transition-all flex items-center gap-1 border border-white/50 pointer-events-none"
    >
      <span>📸</span> Galería
    </div>
  </div>

  <div class="p-4 sm:p-5 flex flex-col flex-grow">
    <button
      type="button"
      data-action="toggle-subproducts"
      data-target={`sub-${id}`}
      class="text-left w-full focus:outline-none group/title cursor-pointer"
    >
      <h3
        class="font-serif text-base sm:text-lg text-indigo-950 font-medium group-hover/title:text-pink-600 transition-colors flex items-center justify-between gap-2"
      >
        <span>{title}</span>
        {
          subProducts.length > 0 && (
            <span class="arrow-icon text-xs text-indigo-400 transition-transform duration-200 shrink-0">
              ▼
            </span>
          )
        }
      </h3>
    </button>

    <p
      class="text-slate-500 text-xs mt-1.5 flex-grow font-light leading-relaxed line-clamp-3 sm:line-clamp-4"
    >
      {description}
    </p>

    {
      subProducts.length > 0 && (
        <div
          id={`sub-${id}`}
          class="hidden mt-3 pt-3 border-t border-slate-100 space-y-2"
        >
          <p class="text-[9px] font-bold text-indigo-600 tracking-wider uppercase">
            ¿Qué incluye?
          </p>
          <div class="grid grid-cols-1 gap-1.5">
            {subProducts.map((sub) => (
              <div class="p-2 bg-slate-50/80 rounded-lg border border-slate-100">
                <h4 class="text-[10px] sm:text-[11px] font-semibold text-slate-800">
                  {sub.name}
                </h4>
                <p class="text-[9px] sm:text-[10px] text-slate-500 mt-0.5 leading-snug">
                  {sub.desc}
                </p>
              </div>
            ))}
          </div>
        </div>
      )
    }

    <div class="mt-4 pt-3 border-t border-slate-100/80">
      {
        isProximamente ? (
          <button
            type="button"
            disabled
            class="w-full text-center bg-slate-100 text-slate-400 text-xs font-medium py-2 rounded-xl cursor-not-allowed"
          >
            🎨 {proximamenteText}
          </button>
        ) : (
          <a
            href={`https://api.whatsapp.com/send?phone=5493412141732&text=${encodeURIComponent("¡Hola! Me interesa obtener más información y cotizar la línea de: " + title)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full text-center block bg-slate-50 hover:bg-pink-600 hover:text-white text-slate-700 text-xs font-semibold py-2.5 rounded-xl transition-all border border-slate-200/60 hover:border-transparent"
            data-product-id={id}
            data-product-name={title}
          >
            COTIZAR ESTA LÍNEA
          </a>
        )
      }
    </div>
  </div>
</div>

<script>
  // @ts-nocheck
  document.addEventListener("DOMContentLoaded", () => {
    document
      .querySelectorAll('[data-action="open-card-gallery"]')
      .forEach((btn) => {
        btn.addEventListener("click", (e) => {
          e.preventDefault();
          const title = btn.dataset.title;
          const images = JSON.parse(btn.dataset.images || "[]");

          if (images.length > 0) {
            // 🔔 Evento: select_content (gallery)
            if (typeof window !== "undefined" && window.dataLayer) {
              window.dataLayer.push({
                event: "select_content",
                content_type: "product_gallery",
                content_id: title,
                content_name: title,
              });
            }

            window.dispatchEvent(
              new CustomEvent("open-gallery", {
                detail: { title, images, index: 0 },
              }),
            );
          }
        });
      });

    document
      .querySelectorAll('[data-action="toggle-subproducts"]')
      .forEach((btn) => {
        btn.addEventListener("click", () => {
          const targetId = btn.dataset.target;
          const targetEl = document.getElementById(targetId);
          const arrow = btn.querySelector(".arrow-icon");

          if (targetEl) {
            const isHidden = targetEl.classList.contains("hidden");
            if (isHidden) {
              targetEl.classList.remove("hidden");
              if (arrow) arrow.style.transform = "rotate(180deg)";
            } else {
              targetEl.classList.add("hidden");
              if (arrow) arrow.style.transform = "rotate(0deg)";
            }
          }
        });
      });

    // 🔔 Evento: click_whatsapp_product (en enlaces "COTIZAR ESTA LÍNEA")
    document
      .querySelectorAll('.product-card a[href*="whatsapp"]')
      .forEach((link) => {
        link.addEventListener("click", function (e) {
          const productId = this.dataset.productId || "unknown";
          const productName = this.dataset.productName || "unknown";
          if (typeof window !== "undefined" && window.dataLayer) {
            window.dataLayer.push({
              event: "click_whatsapp_product",
              product_id: productId,
              product_name: productName,
            });
          }
        });
      });
  });
</script>
