<!-- Ajuste visual del modal para móviles -->
<div
  id="gallery-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/80 backdrop-blur-md p-3 sm:p-4 transition-all duration-300 opacity-0"
>
  <div
    class="relative w-full max-w-3xl bg-[#FAF8FC] rounded-2xl sm:rounded-3xl overflow-hidden shadow-2xl border border-white/20 flex flex-col max-h-[85vh] sm:max-h-[90vh]"
  >
    <!-- HEADER -->
    <div
      class="flex items-center justify-between px-4 sm:px-6 py-3 border-b border-slate-200/60 bg-white/50"
    >
      <div>
        <h3
          id="modal-title"
          class="font-serif text-base sm:text-xl font-medium text-indigo-950 truncate max-w-[200px] sm:max-w-none"
        >
          Galería
        </h3>
        <p class="text-[10px] sm:text-xs text-slate-500 font-light">
          Desliza para ver más opciones
        </p>
      </div>

      <button
        id="close-modal"
        type="button"
        class="w-8 h-8 rounded-full bg-slate-200/60 text-slate-700 flex items-center justify-center text-sm font-bold"
      >
        ✕
      </button>
    </div>

    <!-- IMAGEN Y CONTROLES -->
    <div
      class="relative flex-grow flex items-center justify-center bg-slate-900/5 min-h-[220px] sm:min-h-[420px] overflow-hidden p-2 sm:p-4"
    >
      <img
        id="modal-img"
        src=""
        alt="Trabajo realizado"
        class="max-h-[50vh] sm:max-h-[65vh] w-auto max-w-full object-contain rounded-lg shadow-md"
      />

      <button
        id="prev-slide"
        type="button"
        class="absolute left-2 sm:left-4 top-1/2 -translate-y-1/2 w-9 h-9 sm:w-11 sm:h-11 rounded-full bg-white/80 text-indigo-950 shadow-md flex items-center justify-center text-lg z-10"
        >❮</button
      >
      <button
        id="next-slide"
        type="button"
        class="absolute right-2 sm:right-4 top-1/2 -translate-y-1/2 w-9 h-9 sm:w-11 sm:h-11 rounded-full bg-white/80 text-indigo-950 shadow-md flex items-center justify-center text-lg z-10"
        >❯</button
      >
    </div>

    <!-- DOTS -->
    <div
      id="modal-dots"
      class="flex items-center justify-center gap-2 py-3 bg-white/60"
    >
    </div>
  </div>
</div>
