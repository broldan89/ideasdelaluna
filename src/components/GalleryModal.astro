---
// Componente Modal de Galería de Fotos - Glassmorphism Pastel & Chic
---

<div
  id="gallery-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-indigo-950/30 backdrop-blur-md transition-all duration-300 opacity-0 pointer-events-none"
  aria-hidden="true"
>
  <!-- Contenedor Principal Glassmorphism Claro -->
  <div
    class="relative w-full max-w-4xl bg-white/80 border border-white/60 rounded-3xl p-5 sm:p-7 shadow-[0_20px_50px_rgba(79,70,229,0.15)] backdrop-blur-xl flex flex-col items-center overflow-hidden transform scale-95 transition-all duration-300"
    id="gallery-content"
  >
    <!-- Destellos pastel de fondo -->
    <div
      class="absolute -top-24 -left-24 w-64 h-64 bg-pink-200/40 rounded-full blur-3xl pointer-events-none"
    >
    </div>
    <div
      class="absolute -bottom-24 -right-24 w-64 h-64 bg-indigo-200/40 rounded-full blur-3xl pointer-events-none"
    >
    </div>

    <!-- Encabezado -->
    <div
      class="w-full flex items-center justify-between mb-4 relative z-10 px-1"
    >
      <div>
        <span
          class="text-[10px] font-bold tracking-widest text-indigo-600 uppercase bg-indigo-50/80 border border-indigo-100 px-3 py-1 rounded-full shadow-xs"
        >
          ✨ Detalle de producto
        </span>
        <h3
          id="gallery-title"
          class="font-serif text-indigo-950 text-xl sm:text-2xl font-medium mt-1"
        >
          Galería de fotos
        </h3>
      </div>

      <!-- Botón Cerrar (X) -->
      <button
        id="gallery-close"
        type="button"
        class="text-slate-400 hover:text-indigo-950 bg-slate-100/80 hover:bg-white border border-slate-200/60 w-9 h-9 rounded-full flex items-center justify-center transition-all cursor-pointer shadow-xs"
        aria-label="Cerrar Galería"
      >
        ✕
      </button>
    </div>

    <!-- Visor de Imagen Principal -->
    <div
      class="relative w-full aspect-[4/3] sm:aspect-[16/10] max-h-[60vh] rounded-2xl overflow-hidden bg-slate-50 border border-indigo-50 flex items-center justify-center group relative z-10 shadow-inner"
    >
      <img
        id="gallery-main-img"
        src=""
        alt="Foto ampliada"
        class="w-full h-full object-contain transition-all duration-300"
      />

      <!-- Flechas de navegación -->
      <button
        id="gallery-prev"
        type="button"
        class="absolute left-3 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white text-indigo-950 border border-indigo-100 w-10 h-10 rounded-full flex items-center justify-center transition-all cursor-pointer shadow-md backdrop-blur-sm"
      >
        ❮
      </button>

      <button
        id="gallery-next"
        type="button"
        class="absolute right-3 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white text-indigo-950 border border-indigo-100 w-10 h-10 rounded-full flex items-center justify-center transition-all cursor-pointer shadow-md backdrop-blur-sm"
      >
        ❯
      </button>
    </div>

    <!-- Carrusel de Miniaturas -->
    <div
      id="gallery-thumbs"
      class="flex items-center justify-center gap-3 mt-4 w-full overflow-x-auto py-2 relative z-10 scrollbar-none"
    >
      <!-- Miniaturas inyectadas dinámicamente -->
    </div>
  </div>
</div>

<script>
  // @ts-nocheck
  document.addEventListener("DOMContentLoaded", () => {
    const modal = document.getElementById("gallery-modal");
    const modalContent = document.getElementById("gallery-content");
    const closeBtn = document.getElementById("gallery-close");
    const mainImg = document.getElementById("gallery-main-img");
    const titleEl = document.getElementById("gallery-title");
    const thumbsCont = document.getElementById("gallery-thumbs");
    const prevBtn = document.getElementById("gallery-prev");
    const nextBtn = document.getElementById("gallery-next");

    let currentImages = [];
    let currentIndex = 0;

    function abrirModal(titulo, imagenes, indexInicial = 0) {
      if (!imagenes || imagenes.length === 0) return;

      currentImages = imagenes;
      currentIndex = indexInicial;
      titleEl.textContent = titulo || "Galería de imágenes";

      actualizarVista();

      modal.classList.remove("hidden", "opacity-0", "pointer-events-none");
      modal.classList.add("flex", "opacity-100", "pointer-events-auto");
      modalContent.classList.remove("scale-95");
      modalContent.classList.add("scale-100");

      document.body.style.overflow = "hidden";
    }

    function cerrarModal() {
      modal.classList.remove("opacity-100", "pointer-events-auto");
      modal.classList.add("opacity-0", "pointer-events-none");
      modalContent.classList.remove("scale-100");
      modalContent.classList.add("scale-95");

      setTimeout(() => {
        modal.classList.remove("flex");
        modal.classList.add("hidden");
        document.body.style.overflow = "";
      }, 300);
    }

    function actualizarVista() {
      mainImg.src = currentImages[currentIndex];

      thumbsCont.innerHTML = currentImages
        .map((src, i) => {
          const esActiva = i === currentIndex;
          return `
            <button
              type="button"
              data-index="${i}"
              class="thumb-btn shrink-0 w-14 h-14 sm:w-16 sm:h-16 rounded-xl overflow-hidden border-2 transition-all cursor-pointer ${
                esActiva
                  ? "border-indigo-600 scale-105 shadow-sm"
                  : "border-slate-200 opacity-60 hover:opacity-100"
              }"
            >
              <img src="${src}" class="w-full h-full object-cover" />
            </button>
          `;
        })
        .join("");
    }

    function imagenSiguiente() {
      currentIndex = (currentIndex + 1) % currentImages.length;
      actualizarVista();
    }

    function imagenAnterior() {
      currentIndex =
        (currentIndex - 1 + currentImages.length) % currentImages.length;
      actualizarVista();
    }

    window.addEventListener("open-gallery", (e) => {
      const { title, images, index } = e.detail;
      abrirModal(title, images, index);
    });

    thumbsCont.addEventListener("click", (e) => {
      const btn = e.target.closest(".thumb-btn");
      if (btn) {
        currentIndex = parseInt(btn.dataset.index, 10);
        actualizarVista();
      }
    });

    nextBtn.addEventListener("click", imagenSiguiente);
    prevBtn.addEventListener("click", imagenAnterior);
    closeBtn.addEventListener("click", cerrarModal);

    modal.addEventListener("click", (e) => {
      if (e.target === modal) cerrarModal();
    });

    document.addEventListener("keydown", (e) => {
      if (modal.classList.contains("hidden")) return;
      if (e.key === "Escape") cerrarModal();
      if (e.key === "ArrowRight") imagenSiguiente();
      if (e.key === "ArrowLeft") imagenAnterior();
    });
  });
</script>
