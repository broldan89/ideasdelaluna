---
interface Props {
	title: string;
}

const { title } = Astro.props;
import '../styles/global.css';
import GalleryModal from '../components/GalleryModal.astro';
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Ideas de la Luna - Papelería y soluciones de impresión con alma." />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="logo.png" />
		<title>{title}</title>
		<!-- Fuente estética y moderna -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
	</head>
	
	<body class="fondo-pastel-animado min-h-screen relative">
  	<slot />
	</body>
</html>

<style is:global>
	body {
		font-family: 'Plus Jakarta Sans', sans-serif;
	}
	h1, h2, h3, .font-serif {
		font-family: 'Playfair Display', serif;
	}
	
	/* ANIMACIÓN DE FONDOS PASTELES */
	@keyframes cambioPastel {
		0% {
			background-color: #fdf2f8; /* Rosa pastel */
		}
		33% {
			background-color: #f3e8ff; /* Lavanda pastel */
		}
		66% {
			background-color: #e0f2fe; /* Celeste pastel */
		}
		100% {
			background-color: #fdf2f8; /* Vuelve al Rosa pastel */
		}
	}

	.fondo-pastel-animado {
		animation: cambioPastel 14s ease-in-out infinite;
	}

	body, main {
		transition: background-color 1s ease-in-out;
	}

	/* TRAMA PUNTEADA VISIBLE EN TODO EL SITIO */
	body::before {
		content: "";
		position: fixed;
		top: 0;
		left: 0;
		width: 100vw;
		height: 100vh;
		/* Incrementamos un poco el contraste del punto (opacidad 0.25) */
		background-image: radial-gradient(rgba(79, 70, 229, 0.25) 1.5px, transparent 1.5px);
		background-size: 24px 24px;
		pointer-events: none; /* Sigue permitiendo clicks sin interrupción */
		z-index: 10; /* Eleva los puntos sobre los contenedores del sitio */
	}
</style>