---
interface Props {
	title: string;
}

const { title } = Astro.props;
import '../styles/global.css';
import GalleryModal from '../components/GalleryModal.astro';
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Ideas de la Luna - Papelería y soluciones de impresión con alma." />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
		<!-- Fuente estética y moderna -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
	</head>
	
	<body class="fondo-pastel-animado min-h-screen text-slate-800">
		<!-- El slot es fundamental para que cargue el contenido de index.astro -->
		<slot />
	</body>
</html>

<style is:global>
	body {
		font-family: 'Plus Jakarta Sans', sans-serif;
	}
	h1, h2, h3, .font-serif {
		font-family: 'Playfair Display', serif;
	}
	
	/* TEXTURA DE PAPEL SUTIL */
	.bg-texture {
		background-color: #faf9f6;
		background-image: radial-gradient(#e5e5e5 0.5px, transparent 0.5px), radial-gradient(#e5e5e5 0.5px, #faf9f6 0.5px);
		background-size: 20px 20px;
		background-position: 0 0, 10px 10px;
	}

	/* ANIMACIÓN DE FONDOS PASTELES */
	@keyframes cambioPastel {
		0% {
			background-color: #fdf2f8; /* Rosa pastel */
		}
		33% {
			background-color: #f3e8ff; /* Lavanda pastel */
		}
		66% {
			background-color: #e0f2fe; /* Celeste pastel */
		}
		100% {
			background-color: #fdf2f8; /* Vuelve al Rosa pastel */
		}
	}

	.fondo-pastel-animado {
		animation: cambioPastel 14s ease-in-out infinite;
	}
</style>