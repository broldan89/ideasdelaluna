---
interface Props {
	title: string;
}

const { title } = Astro.props;
import '../styles/global.css';
import GalleryModal from '../components/GalleryModal.astro';
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Ideas de la Luna - Papelería y soluciones de impresión con alma." />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/logo.png" />
		<title>{title}</title>

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
		<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-N7RNFFF620"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-N7RNFFF620');
</script>
	</head>
	
	<body class="fondo-pastel-animado min-h-screen flex flex-col antialiased overflow-x-hidden selection:bg-pink-300 selection:text-slate-800">
		<main class="flex-grow w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6">
			<slot />
		</main>

		<GalleryModal />
	</body>
</html>

<style is:global>
	body {
		font-family: 'Plus Jakarta Sans', sans-serif;
		position: relative;
		z-index: 0;
	}
	h1, h2, h3, .font-serif {
		font-family: 'Playfair Display', serif;
	}
	
	@keyframes cambioPastel {
		0% { background-color: #fdf2f8; }
		33% { background-color: #f3e8ff; }
		66% { background-color: #e0f2fe; }
		100% { background-color: #fdf2f8; }
	}

	.fondo-pastel-animado {
		animation: cambioPastel 14s ease-in-out infinite;
	}

	body, main {
		transition: background-color 1s ease-in-out;
	}

	body::before {
		content: "";
		position: fixed;
		inset: 0;
		background-image: radial-gradient(rgba(99, 102, 241, 0.18) 1.5px, transparent 1.5px);
		background-size: 20px 20px;
		pointer-events: none;
		z-index: -1;
	}

	@media (min-width: 640px) {
		body::before {
			background-size: 24px 24px;
		}
	}
</style>