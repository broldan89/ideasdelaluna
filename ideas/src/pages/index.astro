---
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/TopBar.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Cotizador from '../components/Cotizador.astro';
import ProductCard from '../components/ProductCard.astro';
import Faq from '../components/Faq.astro';
import GalleryModal from '../components/GalleryModal.astro';
---

<Layout title="Ideas de la Luna | Papelería de otro planeta">
  <TopBar />
  <Navbar />
  <Hero />

  <!-- CALCULADORA / COTIZADOR AUTOMÁTICO DE IMPRESIONES -->
  <Cotizador />

  <main class="max-w-7xl mx-auto px-6 py-12 space-y-24">
    
    <!-- SECCIÓN 1: UNIVERSO EMPRENDEDOR -->
    <section id="marcas" class="scroll-mt-24">
      <div class="max-w-xl mb-8">
        <h2 class="text-3xl font-normal text-indigo-950">El Universo <span class="italic text-indigo-600">Emprendedor</span></h2>
        <p class="text-slate-500 text-sm mt-2 font-light">Packaging e identidad 100% personalizada para marcas que quieren dejar una huella imborrable al abrir sus cajas. Haz clic en la foto para ver las opciones disponibles.</p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-5 max-w-fit">
        <ProductCard 
          id="stickers"
          title="Stickers & Etiquetas (Planchas A4)"
          description="Impresión por plancha A4 (mínimo 20 unidades). Papel fotográfico (200g), mate (260g) o material fílmico resistente al agua. Corte troquelado listo para despegar."
          badge="100% Personalizado"
          imageSrc="/catalog/sticker_5.jpeg"
          hoverImageSrc="/catalog/sticker_1.jpeg"
          galleryImages={[
            "/catalog/sticker_5.jpeg",
            "/catalog/sticker_1.jpeg"
          ]}
          subProducts={[
            { name: "Planchas de stickers con logo", desc: "Mínimo 20 unidades. La cantidad por plancha A4 depende del tamaño de tu diseño." },
            { name: "Etiquetas con código QR", desc: "Listas para cobros por transferencia, Mercado Pago o redes sociales." },
            { name: "Material Filmilo Waterproof", desc: "Resistente al agua y humedad, ideal para frascos, vasos o cosmética." }
          ]}
        />
        
        <ProductCard 
          id="tarjetas"
          title="Tarjetas Profesionales & Personales"
          description="Diseño 100% personalizado en medidas estándar (4x9 cm o 5x9 cm). Opción simple o doble faz en papel pesado de alta calidad."
          badge="Contacto"
          imageSrc="/catalog/tarjetas_profesionales.jpeg"
          hoverImageSrc="/catalog/tarjetas_profesionales2.jpeg"
          galleryImages={[
            "/catalog/tarjetas_profesionales.jpeg",
            "/catalog/tarjetas_profesionales2.jpeg"
          ]}
          subProducts={[
            { name: "Tarjetas Estándar (4x9 cm / 5x9 cm)", desc: "Impresión simple o doble faz adaptada a tu identidad visual." },
            { name: "Tarjetas de contacto corporativas", desc: "Presentación impecable con tus redes, datos de pago y QR." },
            { name: "Tarjetas dobles desplegables", desc: "Mayor espacio para mostrar tus servicios o recomendaciones de uso." }
          ]}
        />

        <ProductCard 
          id="packaging"
          title="Presentación & Cierrabolsas"
          description="Detalles gráficos impresos para sellar y dar el toque final a tus paquetes antes de enviarlos."
          badge="Packaging"
          imageSrc="/catalog/sticker_1.jpeg"
          hoverImageSrc="/catalog/sticker_5.jpeg"
          subProducts={[
            { name: "Stickers cierrabolsas", desc: "Formatos rectangulares o circulares para asegurar tus envíos." },
            { name: "Fajas autoadhesivas de cierre", desc: "Diseñadas a medida para envolver cajas o bolsas." },
            { name: "Tarjetas de agradecimiento (5x5 cm)", desc: "Formato estándar cuadrado de 5x5 cm para dar la bienvenida al cliente." }
          ]}
        />

        <ProductCard 
          id="fidelizacion"
          title="Fidelización & Gift Cards"
          description="Tarjetas impresas 100% personalizadas en papel pesado diseñadas para premiar la lealtad e incentivar la recompra."
          badge="Clientes"
          imageSrc="/catalog/tarjetas_profesionales2.jpeg"
          hoverImageSrc="/catalog/tarjetas_profesionales.jpeg"
          subProducts={[
            { name: "Tarjetas 'Gracias por tu compra' (5x5 cm)", desc: "Mensajes cálidos y recomendaciones impresas en formato cuadrado estándar." },
            { name: "Tarjetas de fidelización", desc: "Sistema impreso de puntos o sellos simple o doble faz para premiar clientes." },
            { name: "Gift Cards impresas", desc: "Tarjetas de regalo personalizadas con montos o servicios." }
          ]}
        />

        <ProductCard 
          id="folleteria"
          title="Folletería & Material Promocional"
          description="Volantes, flyers y folletos impresos en alta calidad para difundir tus promociones o catálogo de servicios."
          badge="Difusión"
          imageSrc="/catalog/tarjetas_profesionales.jpeg"
          hoverImageSrc="/catalog/tarjetas_profesionales2.jpeg"
          subProducts={[
            { name: "Flyers A6 / A5 promocionales", desc: "Formatos ideales para incluir en cada entrega o repartir." },
            { name: "Volantes informativos", desc: "Papel liviano o pesado según la necesidad del proyecto." },
            { name: "Cartas o menús desplegables", desc: "Para locales gastronómicos, servicios o catálogos impresos." }
          ]}
        />
      </div>
    </section>

    <!-- SECCIÓN ESPECIAL DESTACADA: ÓRBITA DOCENTE & SEÑOS -->
    <section id="docentes" class="scroll-mt-24 p-8 sm:p-12 rounded-3xl bg-gradient-to-br from-slate-950 via-indigo-950 to-slate-900 text-white shadow-2xl relative overflow-hidden border border-indigo-500/20">
      
      <!-- Resplandores de luz de fondo -->
      <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-purple-500/15 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -left-20 -top-20 w-80 h-80 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <!-- Encabezado de la sección -->
      <div class="max-w-2xl mb-12 relative z-10">
        <span class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-widest px-3.5 py-1 rounded-full bg-amber-400/10 text-amber-300 border border-amber-400/30 mb-3 shadow-inner">
          <span>✨</span> Espacio Exclusivo
        </span>
        <h2 class="text-3xl sm:text-4xl font-serif font-normal text-white tracking-wide">
          Órbita <span class="italic text-amber-300">Docente</span>
        </h2>
        <p class="text-indigo-200/80 text-sm mt-3 font-light leading-relaxed">
          Diseñado con amor para maestras y educadores. Herramientas físicas e imprimibles en PDF para organizar el aula, calificar con ternura e inspirar todos los días.
        </p>
      </div>
      
      <!-- Grilla de Tarjetas Cristalinas (Glassmorphism) -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 relative z-10">
        
        <!-- TARJETA 1 -->
        <div class="bg-white/10 backdrop-blur-md rounded-2xl p-4 border border-white/15 hover:border-amber-300/40 transition-all duration-300 flex flex-col justify-between group hover:-translate-y-1 shadow-lg">
          <div>
            <div class="relative overflow-hidden rounded-xl aspect-[4/3] mb-4">
              <span class="absolute top-2.5 left-2.5 z-10 text-[10px] font-bold uppercase tracking-wider bg-black/60 backdrop-blur-md text-amber-300 px-2.5 py-1 rounded-md border border-amber-300/20">
                Impreso
              </span>
              <img src="/catalog/cuaderno.jpeg" alt="Planificadores" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            </div>
            <h3 class="text-lg font-serif font-medium text-white mb-2">Planificadores & Agendas</h3>
            <p class="text-indigo-200/70 text-xs font-light leading-relaxed mb-4">
              Organización integral con asistencia, notas y grilla de clases. Tapa dura personalizada.
            </p>
          </div>
          <a href="#contacto" class="w-full text-center py-2.5 px-4 rounded-xl bg-amber-300/10 hover:bg-amber-300/20 text-amber-300 border border-amber-300/30 text-xs font-semibold tracking-wider uppercase transition-all">
            Cotizar esta línea
          </a>
        </div>

        <!-- TARJETA 2 -->
        <div class="bg-white/10 backdrop-blur-md rounded-2xl p-4 border border-white/15 hover:border-amber-300/40 transition-all duration-300 flex flex-col justify-between group hover:-translate-y-1 shadow-lg">
          <div>
            <div class="relative overflow-hidden rounded-xl aspect-[4/3] mb-4">
              <span class="absolute top-2.5 left-2.5 z-10 text-[10px] font-bold uppercase tracking-wider bg-black/60 backdrop-blur-md text-amber-300 px-2.5 py-1 rounded-md border border-amber-300/20">
                Impreso
              </span>
              <img src="/catalog/sticker_5.jpeg" alt="Stickers motivacionales" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            </div>
            <h3 class="text-lg font-serif font-medium text-white mb-2">Stickers Motivacionales</h3>
            <p class="text-indigo-200/70 text-xs font-light leading-relaxed mb-4">
              Planchas A4 impresas con mensajes hermosos para evaluar cuadernos con ternura.
            </p>
          </div>
          <a href="#contacto" class="w-full text-center py-2.5 px-4 rounded-xl bg-amber-300/10 hover:bg-amber-300/20 text-amber-300 border border-amber-300/30 text-xs font-semibold tracking-wider uppercase transition-all">
            Cotizar esta línea
          </a>
        </div>

        <!-- TARJETA 3: DESCARGABLES PDF -->
<div class="bg-white/10 backdrop-blur-md rounded-2xl p-4 border border-white/15 hover:border-amber-300/40 transition-all duration-300 flex flex-col justify-between group hover:-translate-y-1 shadow-lg">
  <div>
    <div class="relative overflow-hidden rounded-xl aspect-[4/3] mb-4">
      <div class="absolute top-2.5 left-2.5 z-10 flex flex-col gap-1.5">
        <span class="text-[10px] font-bold uppercase tracking-wider bg-amber-400 text-slate-950 px-2.5 py-1 rounded-md">
          ⚡ Descarga PDF
        </span>
        <span class="text-[9px] font-semibold tracking-wide bg-slate-900/80 backdrop-blur-md text-amber-200 border border-amber-300/30 px-2 py-0.5 rounded-md w-fit">
          Próximamente
        </span>
      </div>
      <img src="/catalog/libreta.jpeg" alt="Recursos PDF" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-90" />
    </div>
    
    <h3 class="text-lg font-serif font-medium text-white mb-2">Recursos Digitales en PDF</h3>
    <p class="text-indigo-200/70 text-xs font-light leading-relaxed mb-4">
      Archivos listos para descargar e imprimir. Efemérides, carteles de aula y fichas por grado.
    </p>
  </div>

  <!-- BOTÓN DESHABILITADO / EN PREPARACIÓN -->
  <button 
    disabled 
    type="button" 
    class="w-full text-center py-2.5 px-4 rounded-xl bg-white/10 text-indigo-200/60 border border-white/10 text-xs font-medium transition-all cursor-not-allowed select-none flex items-center justify-center gap-2"
  >
    <span>🎨</span> En el taller de diseño
  </button>
</div>

      </div>
    </section>

    <!-- SECCIÓN 3: PARA EVENTOS -->
    <section id="eventos" class="scroll-mt-24">
      <div class="max-w-xl mb-8">
        <h2 class="text-3xl font-normal text-indigo-950">Fases de <span class="italic text-indigo-600">Celebración</span></h2>
        <p class="text-slate-500 text-sm mt-2 font-light">Papelería fina y detalles completamente personalizados para eventos que merecen ser recordados para siempre.</p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-5 max-w-fit">
        <ProductCard 
          id="invitaciones"
          title="Invitaciones Especiales"
          description="Diseños 100% personalizados en papeles de alta calidad para bodas, XV años y cumpleaños."
          badge="Premium"
          imageSrc="/catalog/invitaciones.jpeg"
          hoverImageSrc="/catalog/invitaciones.jpeg"
          subProducts={[
            { name: "Tarjetas de Invitación", desc: "Impresión en papeles especiales, simple o doble faz." },
            { name: "Sobres artesanales", desc: "Con o sin liner personalizado impreso en el interior." }
          ]}
        />
        
        <ProductCard 
          id="souvenirs"
          title="Tags & Detalles"
          description="Pequeños complementos que hacen la diferencia: indicadores de sitio, menús impresos y tarjetas de recuerdo."
          badge="Eventos"
          imageSrc="https://images.unsplash.com/photo-1513151233558-d860c5398git176?q=80&w=600"
          hoverImageSrc="https://images.unsplash.com/photo-1542435503-956c469947f6?q=80&w=600"
        />
      </div>
    </section>

    <!-- SECCIÓN 4: LÍNEA PROPIA -->
    <section id="tienda" class="scroll-mt-24 mb-12">
      <div class="max-w-xl mb-8">
        <h2 class="text-3xl font-normal text-indigo-950">La Tienda de la <span class="italic text-indigo-600">Luna</span></h2>
        <p class="text-slate-500 text-sm mt-2 font-light">Nuestra línea exclusiva de papelería de diseño lista para usar, organizar tus días o hacer un regalo especial.</p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-5 max-w-fit">
        <ProductCard 
          id="cuadernos"
          title="Cuadernos Artesanales"
          description="Anillados con tapa dura laminada. Hojas punteadas, rayadas o lisas para organizarte como quieras."
          badge="Línea Propia"
          imageSrc="/catalog/cuaderno.jpeg"
          hoverImageSrc="/catalog/cuaderno.jpeg"
          subProducts={[
            { name: "Cuadernos A5 Anillados", desc: "Tapa dura laminada, cierre elástico y sobre interno." },
            { name: "Bitácoras de viaje", desc: "Encuadernación flexible ideal para trasladar." }
          ]}
        />
        
        <ProductCard 
          id="planners"
          title="Agendas & Planners"
          description="Organizadores perpetuos y blocs de notas semanales para estructurar tus metas día a día."
          badge="Diseño"
          imageSrc="/catalog/libreta.jpeg"
          hoverImageSrc="/catalog/libreta.jpeg"
          subProducts={[
            { name: "Agendas Personalizadas", desc: "Tapa dura laminada, cierre elástico y organizador mensual." },
            { name: "Planners Semanales de escritorio", desc: "Formato anillado o en bloc para escritorio." }
          ]}
        />
      </div>
    </section>
  </main>

  <!-- SECCIÓN PREGUNTAS FRECUENTES -->
  <Faq />

  <!-- FOOTER CON SOMBRA DE PAPEL SOBREPUESTO -->
  <div class="paper-footer-wrapper relative z-20">
    
    <!-- SEPARADOR ESTILO PAPEL RASGADO -->
    <div class="w-full overflow-hidden leading-[0] rotate-180 bg-transparent -mb-1">
      <svg viewBox="0 0 1200 120" preserveAspectRatio="none" class="relative block w-full h-12 fill-white/95">
        <path d="M0,0 L1200,0 L1200,20 L1180,45 L1150,25 L1100,55 L1060,30 L1020,50 L980,20 L940,45 L900,15 L850,50 L800,25 L750,55 L700,30 L650,50 L600,20 L550,45 L500,15 L450,55 L400,25 L350,50 L300,20 L250,45 L200,15 L150,55 L100,30 L50,50 L0,20 Z"></path>
      </svg>
    </div>

    <!-- FOOTER LIMPIO E INTEGRADO -->
    <footer id="contacto" class="bg-white/95 backdrop-blur-md text-indigo-950 pb-16 pt-4 px-6 relative">
      <div class="max-w-4xl mx-auto text-center flex flex-col items-center">
        
        <!-- LOGO INTEGRADO -->
        <div class="mb-5 flex justify-center">
          <img 
            src="/logo.png" 
            alt="Ideas de la Luna Logo" 
            class="h-20 w-auto object-contain transition-transform duration-300 hover:scale-105 opacity-90" 
          />
        </div>

        <!-- TÍTULO Y DESCRIPCIÓN -->
        <h2 class="text-3xl font-serif mb-2 text-indigo-950 font-medium tracking-wide">
          ¿Tenés una idea fuera de órbita?
        </h2>
        <p class="text-slate-500 text-sm max-w-sm mx-auto font-light mb-8 leading-relaxed">
          Hablemos de tu proyecto y creemos algo mágico juntos.
        </p>
        
        <!-- BOTONES DE CONTACTO -->
        <div class="flex flex-col sm:flex-row justify-center items-center gap-4 w-full sm:w-auto">
          
          <!-- BOTÓN WHATSAPP -->
          <a 
            href="https://api.whatsapp.com/send?phone=5493412141732&text=Hola!%20Vi%20tu%20web%20y%20me%20gustar%C3%ADa%20hacerte%20una%20consulta." 
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center bg-[#10B981] hover:bg-[#059669] text-white font-semibold px-8 py-3.5 rounded-full shadow-sm hover:shadow-md transition-all text-sm tracking-wide gap-2.5 hover:-translate-y-0.5"
          >
            <span class="text-base">💬</span>
            Escríbenos por WhatsApp
          </a>

          <!-- BOTÓN INSTAGRAM -->
          <a 
            href="https://www.instagram.com/ideas.de.la.luna/" 
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center bg-gradient-to-r from-[#A855F7] to-[#EC4899] hover:opacity-95 text-white font-semibold px-8 py-3.5 rounded-full shadow-sm hover:shadow-md transition-all text-sm tracking-wide gap-2.5 hover:-translate-y-0.5"
          >
            <span class="text-base">📸</span>
            Seguinos en Instagram
          </a>

        </div>

        <!-- COPYRIGHT -->
        <p class="text-xs text-slate-400 mt-14 font-light">
          © 2026 Ideas de la Luna. Todos los derechos reservados.
        </p>
      </div>
    </footer>

  </div>

  <!-- CÓDIGO DEL MODAL DE RECURSOS DIGITALES -->
  <div id="pdf-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-slate-950/80 backdrop-blur-sm transition-opacity duration-300">
    <div class="bg-slate-900 border border-indigo-500/30 rounded-3xl p-6 sm:p-8 max-w-xl w-full text-white shadow-2xl relative overflow-hidden">
      
      <!-- Botón Cerrar (X) -->
      <button id="close-modal" class="absolute top-4 right-4 text-slate-400 hover:text-white bg-white/5 hover:bg-white/10 w-8 h-8 rounded-full flex items-center justify-center transition-all cursor-pointer">
        ✕
      </button>

      <!-- Encabezado del Modal -->
      <div class="mb-6">
        <span class="text-xs font-semibold uppercase tracking-widest text-amber-300 bg-amber-400/10 px-3 py-1 rounded-full border border-amber-400/20">
          ⚡ Descarga Inmediata
        </span>
        <h3 class="text-2xl font-serif font-normal mt-3 text-white">Catálogo de Recursos PDF</h3>
        <p class="text-indigo-200/70 text-xs mt-1 font-light">Elegí el kit imprimible que necesitas para tu aula.</p>
      </div>

      <!-- Lista de Productos Digitales -->
      <div class="space-y-3.5 max-h-[60vh] overflow-y-auto pr-1">
        
        <!-- ITEM 1 -->
        <div class="p-4 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-between gap-4 hover:border-amber-300/30 transition-all">
          <div>
            <h4 class="font-medium text-sm text-white">Kit Efemérides & Actos Escolares</h4>
            <p class="text-xs text-indigo-200/60 mt-0.5">Láminas, guirnaldas y fichas de actividades en alta resolución.</p>
          </div>
          <a 
            href="https://api.whatsapp.com/send?phone=5493412141732&text=Hola!%20Me%20interesa%20adquirir%20el%20Kit%20Efem%C3%A9rides%20en%20PDF." 
            target="_blank" 
            class="shrink-0 bg-amber-300 hover:bg-amber-200 text-slate-950 text-xs font-bold px-3.5 py-2 rounded-xl transition-all"
          >
            Solicitar
          </a>
        </div>

        <!-- ITEM 2 -->
        <div class="p-4 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-between gap-4 hover:border-amber-300/30 transition-all">
          <div>
            <h4 class="font-medium text-sm text-white">Kit Organización de Aula (Inicial / Primaria)</h4>
            <p class="text-xs text-indigo-200/60 mt-0.5">Calendarios, carteles de clima, cumpleaños y abecedarios.</p>
          </div>
          <a 
            href="https://api.whatsapp.com/send?phone=5493412141732&text=Hola!%20Me%20interesa%20adquirir%20el%20Kit%20Organizaci%C3%B3n%20de%20Aula%20en%20PDF." 
            target="_blank" 
            class="shrink-0 bg-amber-300 hover:bg-amber-200 text-slate-950 text-xs font-bold px-3.5 py-2 rounded-xl transition-all"
          >
            Solicitar
          </a>
        </div>

        <!-- ITEM 3: RECURSO GRATUITO / FREEBIE -->
        <div class="p-4 rounded-2xl bg-amber-400/10 border border-amber-400/20 flex items-center justify-between gap-4">
          <div>
            <span class="text-[10px] uppercase tracking-wider font-bold text-amber-300">Regalo de Bienvenida 🎁</span>
            <h4 class="font-medium text-sm text-white mt-0.5">Plantilla de Seguimiento Pedagógico</h4>
            <p class="text-xs text-indigo-200/60 mt-0.5">Ficha de muestra lista para imprimir en A4.</p>
          </div>
          <a 
            href="/downloads/muestra-docente-ideas-de-la-luna.pdf" 
            download 
            class="shrink-0 bg-white/10 hover:bg-white/20 text-white border border-white/20 text-xs font-semibold px-3.5 py-2 rounded-xl transition-all"
          >
            Descargar Gratis
          </a>
        </div>

      </div>

    </div>
  </div>

  <GalleryModal />
</Layout>

<script>
  const openBtn = document.getElementById('btn-open-pdf-modal');
  const closeBtn = document.getElementById('close-modal');
  const modal = document.getElementById('pdf-modal');

  if (openBtn && closeBtn && modal) {
    openBtn.addEventListener('click', (e) => {
      e.preventDefault();
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    });

    closeBtn.addEventListener('click', () => {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    });

    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }
    });
  }
</script>

<style>
  /* Sombra profunda tipo capa de papel flotante para todo el footer */
  .paper-footer-wrapper {
    filter: 
      drop-shadow(0px -10px 18px rgba(35, 25, 60, 0.12)) 
      drop-shadow(0px -2px 6px rgba(35, 25, 60, 0.08));
  }
</style>