---
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/TopBar.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Cotizador from '../components/Cotizador.astro';
import ProductCard from '../components/ProductCard.astro';
import Faq from '../components/Faq.astro';
---

<Layout title="Ideas de la Luna | Papelería de otro planeta">
  <TopBar />
  <Navbar />

  <main class="relative overflow-x-hidden perspective-container">
    <div class="orbit-card opacity-0 scale-95 translate-y-6 transition-all duration-500 ease-out">
      <Hero />
    </div>

    <div class="orbit-card opacity-0 rotate-x-3 translate-y-12 scale-95 transition-all duration-500 ease-out my-8">
      <Cotizador />
    </div>

    <div class="max-w-6xl mx-auto space-y-20 sm:space-y-28 py-8 sm:py-12 px-4 sm:px-6">
      
      <!-- SECCIÓN MARCAS -->
      <section id="marcas" class="scroll-mt-24 orbit-card opacity-0 rotate-x-3 translate-y-12 scale-95 transition-all duration-500 ease-out">
        <div class="max-w-xl mb-6 sm:mb-8">
          <h2 class="text-2xl sm:text-3xl font-normal text-indigo-950">
            El Universo <span class="italic text-indigo-600">Emprendedor</span>
          </h2>
          <p class="text-slate-500 text-sm mt-2 font-light leading-relaxed">
            Packaging e identidad para marcas que quieren dejar una huella imborrable al abrir sus cajas. Haz clic en la foto para ver las opciones disponibles.
          </p>
        </div>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 w-full">
          <!-- Existente 1 -->
          <ProductCard 
            id="stickers"
            title="Stickers & Etiquetas"
            description="En plancha o troquelados individuales. Papel brillante, mate o vinilo resistente al agua."
            badge="Identidad"
            imageSrc="/catalog/sticker_5.jpeg"
            hoverImageSrc="/catalog/sticker_1.jpeg"
            galleryImages={[
              "/catalog/sticker_5.jpeg",
              "/catalog/sticker_1.jpeg",
              "/catalog/tarjetas_profesionales.jpeg"
            ]}
            subProducts={[
              { name: "Planchas A4 troqueladas", desc: "Ideales para cerrar bolsas y rotular cajas rápidamente." },
              { name: "Stickers individuales (Die-cut)", desc: "Cortados uno a uno con la forma de tu logo." },
              { name: "Etiquetas transparentes", desc: "Vinilo premium invisible, ideal para frascos o cosmética." }
            ]}
          />
          
          <!-- Existente 2 -->
          <ProductCard 
            id="tarjetas"
            title="Tarjetas Profesionales"
            description="Papel pesado de alta calidad (300g) con terminaciones mate suaves al tacto para conectar con tus clientes."
            badge="Packaging"
            imageSrc="/catalog/tarjetasPersonales_1.png"
            hoverImageSrc="/catalog/tarjetas_profesionales2.jpeg"
            galleryImages={[
              "/catalog/tarjetas_profesionales.jpeg",
              "/catalog/tarjetas_profesionales2.jpeg"
            ]}
            subProducts={[
              { name: "Tarjetas Personales", desc: "Ideales para emprendedores y profesionales." },
              { name: "Tags colgantes con hilo", desc: "Para ropa o productos artesanales, perforadas y listas." }
            ]}
          />

          <!-- Nueva 1 -->
          <ProductCard
            id="brand-tags"
            title="Etiquetas Colgantes & Tags"
            description="Tags personalizados con perforación para prendas, regalos o calzado. Variedad de gramajes y acabados."
            badge="Branding"
            imageSrc="/catalog/tarjetas_profesionales.jpeg"
            hoverImageSrc="/catalog/tarjetas_profesionales2.jpeg"
            galleryImages={[
              "/catalog/tarjetas_profesionales.jpeg",
              "/catalog/tarjetas_profesionales2.jpeg"
            ]}
            subProducts={[
              { name: "Tag Clásico Ilustración", desc: "Papel ilustración 300g con perforación estándar para cordón." },
              { name: "Tag Kraft Ecológico", desc: "Papel kraft sustentable con estética rústica y natural." },
              { name: "Tag con Troquel Especial", desc: "Formas circulares, con bordes redondeados o cortes personalizados." }
            ]}
          />

          <!-- Nueva 2 -->
          <ProductCard
            id="brand-thanks"
            title="Tarjetas de Agradecimiento & Cuidados"
            description="Tarjetas de fidelización, instrucciones de cuidado o notas de agradecimiento para incluir en tus envíos."
            badge="Packaging"
            imageSrc="/catalog/tarjetasPersonales_1.png"
            hoverImageSrc="/catalog/tarjetas_profesionales2.jpeg"
            galleryImages={[
              "/catalog/tarjetasPersonales_1.png",
              "/catalog/tarjetas_profesionales2.jpeg"
            ]}
            subProducts={[
              { name: "Tarjeta de Agradecimiento A6", desc: "Impresión frente y dorso en papel mate o satinado." },
              { name: "Tarjeta con QR / Redes", desc: "Optimizada con códigos QR directos a tus tiendas o catálogo." },
              { name: "Guías de Cuidado de Producto", desc: "Formatos pequeños para prendas, accesorios o papelería." }
            ]}
          />

          <!-- Nueva 3 -->
          <ProductCard
            id="brand-fajas"
            title="Fajas de Cierre & Fajas Papel"
            description="Fajas impresas en papel para envolver prendas, cerrar cajas o empaques de regalo con elegancia."
            badge="Empaque"
            imageSrc="/catalog/sticker_1.jpeg"
            hoverImageSrc="/catalog/sticker_5.jpeg"
            galleryImages={[
              "/catalog/sticker_1.jpeg",
              "/catalog/sticker_5.jpeg"
            ]}
            subProducts={[
              { name: "Faja Adhesiva Satinada", desc: "Sticker alargado ideal para sellado seguro de cajas." },
              { name: "Faja de Papel Seda / Obra", desc: "Tira de papel para abrazar productos textiles o calzado." }
            ]}
          />

          <!-- Nueva 4 -->
          <ProductCard
            id="brand-seda"
            title="Papel Manteca y Seda Personalizado"
            description="Hojas de papel de seda o papel manteca impreso a 1 o 2 colores con el patrón de tu logotipo."
            badge="Premium"
            imageSrc="/catalog/sticker_5.jpeg"
            hoverImageSrc="/catalog/sticker_1.jpeg"
            galleryImages={[
              "/catalog/sticker_5.jpeg",
              "/catalog/sticker_1.jpeg"
            ]}
            subProducts={[
              { name: "Papel Seda Patrón Tramado", desc: "Envoltorio interior delicado para cajas de ropa y calzado." },
              { name: "Papel Manteca Anti-grasa", desc: "Ideal para presentaciones de repostería o gastropackaging." }
            ]}
          />
        </div>
      </section>

      <!-- SECCIÓN EVENTOS -->
      <section id="eventos" class="scroll-mt-24 orbit-card opacity-0 rotate-x-3 translate-y-12 scale-95 transition-all duration-500 ease-out">
        <div class="max-w-xl mb-6 sm:mb-8">
          <h2 class="text-2xl sm:text-3xl font-normal text-indigo-950">
            Fases de <span class="italic text-indigo-600">Celebración</span>
          </h2>
          <p class="text-slate-500 text-sm mt-2 font-light leading-relaxed">
            Papelería fina y detalles completamente personalizados para eventos que merecen ser recordados para siempre.
          </p>
        </div>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 w-full">
          <!-- Existente 1 -->
          <ProductCard 
            id="invitaciones"
            title="Invitaciones Especiales"
            description="Diseños únicos en papeles texturados con detalles en foil dorado o plata metalizado."
            badge="Premium"
            imageSrc="/catalog/invitaciones.jpeg"
            hoverImageSrc="/catalog/invitaciones.jpeg"
            subProducts={[
              { name: "Tarjetas de Invitación", desc: "Impresión en papeles especiales, texturados o vegetales de alta calidad." },
              { name: "Sobres artesanales", desc: "Con o sin liner personalizado impreso en el interior." }
            ]}
          />
          
          <!-- Existente 2 -->
          <ProductCard 
            id="souvenirs"
            title="Tags & Detalles"
            description="Pequeños complementos que hacen la diferencia: indicadores de sitio, menús impresos y etiquetas colgantes."
            badge="Eventos"
            imageSrc="/catalog/tags_1.jpeg"
            hoverImageSrc="https://images.unsplash.com/photo-1542435503-956c469947f6?q=80&w=600"
          />

          <!-- Nueva 1 -->
          <ProductCard
            id="event-carteleria"
            title="Carteles de Bienvenida & Seating Plan"
            description="Cartelería rígida e impresa para recepción de invitados, organigramas de mesas o menús gigantes."
            badge="Ambientación"
            imageSrc="/catalog/invitaciones.jpeg"
            hoverImageSrc="/catalog/tags_1.jpeg"
            galleryImages={[
              "/catalog/invitaciones.jpeg",
              "/catalog/tags_1.jpeg"
            ]}
            subProducts={[
              { name: "Cartel Montado en Foam Board", desc: "Rígido, liviano y listo para colocar en atriles." },
              { name: "Seating Plan de Mesas", desc: "Diseño organizado por sectores o números de mesa." },
              { name: "Carteles Indicadores", desc: "Flechas, frascos o indicaciones de barra e ingreso." }
            ]}
          />

          <!-- Nueva 2 -->
          <ProductCard
            id="event-menus"
            title="Menús de Mesa & Números de Sector"
            description="Cartas individuales, menús por mesa e identificadores de platos o mesas de dulces."
            badge="Mesa Especial"
            imageSrc="/catalog/tags_1.jpeg"
            hoverImageSrc="/catalog/invitaciones.jpeg"
            galleryImages={[
              "/catalog/tags_1.jpeg",
              "/catalog/invitaciones.jpeg"
            ]}
            subProducts={[
              { name: "Menú Individual Alargado", desc: "Diseño elegante en papel acartonado con detalles especiales." },
              { name: "Número de Mesa Carpa", desc: "Soporte autoportante impreso frente y dorso." },
              { name: "Tags para Copas o Bebidas", desc: "Detalles personalizados para sorbetes o identificación." }
            ]}
          />

          <!-- Nueva 3 -->
          <ProductCard
            id="event-souvenirs"
            title="Tags & Envoltorios para Souvenirs"
            description="Kits de papelería diseñados para coordinar los regalos y recuerdos del evento."
            badge="Recuerdos"
            imageSrc="/catalog/tags_1.jpeg"
            hoverImageSrc="/catalog/invitaciones.jpeg"
            galleryImages={[
              "/catalog/tags_1.jpeg",
              "/catalog/invitaciones.jpeg"
            ]}
            subProducts={[
              { name: "Tags Calados para Souvenir", desc: "Con perforación e hilo de yute o cinta bebé." },
              { name: "Cajitas Kraft Armables", desc: "Para golosinas, velas o detalles gastronómicos." },
              { name: "Stickers de Cierre de Bolsa", desc: "Adhesivos redondos o rectangulares personalizados." }
            ]}
          />

          <!-- Nueva 4 -->
          <ProductCard
            id="event-firmas"
            title="Libro de Firmas & Mensajes"
            description="Álbumes y libros artesanales con encuadernación especial para que los invitados dejen sus dedicatorias."
            badge="Artesanal"
            imageSrc="/catalog/invitaciones.jpeg"
            hoverImageSrc="/catalog/tags_1.jpeg"
            galleryImages={[
              "/catalog/invitaciones.jpeg",
              "/catalog/tags_1.jpeg"
            ]}
            subProducts={[
              { name: "Libro Tapa Dura con Espiral", desc: "Hojas de alto gramaje aptas para fotos e insumos pegados." },
              { name: "Libro Cosido a Mano", desc: "Encuadernación artesanal con tapas enteladas o laminadas." }
            ]}
          />
        </div>
      </section>

      <!-- SECCIÓN TIENDA -->
      <section id="tienda" class="scroll-mt-24 orbit-card opacity-0 rotate-x-3 translate-y-12 scale-95 transition-all duration-500 ease-out">
        <div class="max-w-xl mb-6 sm:mb-8">
          <h2 class="text-2xl sm:text-3xl font-normal text-indigo-950">
            La Tienda de la <span class="italic text-indigo-600">Luna</span>
          </h2>
          <p class="text-slate-500 text-sm mt-2 font-light leading-relaxed">
            Nuestra línea exclusiva de papelería de diseño lista para usar, organizar tus días o hacer un regalo especial.
          </p>
        </div>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 w-full">
          <!-- Existente 1 -->
          <ProductCard 
            id="cuadernos"
            title="Cuadernos Artesanales"
            description="Anillados o con costura expuesta a mano. Hojas punticuladas ideales para bullet journal o bocetos."
            badge="Línea Propia"
            imageSrc="/catalog/cuaderno.jpeg"
            hoverImageSrc="/catalog/cuaderno.jpeg"
            subProducts={[
              { name: "Cuadernos A5 Anillados", desc: "Tapa dura laminada, cierre elástico y sobre interno." },
              { name: "Bitácoras de viaje", desc: "Encuadernación flexible y lomo cosido a la vista." }
            ]}
          />
          
          <!-- Existente 2 -->
          <ProductCard 
            id="planners"
            title="Agendas & Planners"
            description="Organizadores perpetuos y blocs de notas semanales para despejar la mente y estructurar tus metas."
            badge="Diseño"
            imageSrc="/catalog/libreta.jpeg"
            hoverImageSrc="/catalog/libreta.jpeg"
            galleryImages={[
              "/catalog/sticker_5.jpeg",
              "/catalog/sticker_1.jpeg",
              "/catalog/tarjetas_profesionales.jpeg"
            ]}
            subProducts={[
              { name: "Agendas Personalizadas", desc: "Tapa dura laminada, cierre elástico y sobre interno." },
              { name: "Bitácoras de viaje", desc: "Encuadernación flexible y lomo cosido a la vista." }
            ]}
          />

          <!-- Nueva 1 -->
          <ProductCard
            id="shop-planners"
            title="Planners de Escritorio & Bloques de Notas"
            description="Organizadores semanales o mensuales anillados o blocks bloc de notas arrancables."
            badge="Organización"
            imageSrc="/catalog/libreta.jpeg"
            hoverImageSrc="/catalog/cuaderno.jpeg"
            galleryImages={[
              "/catalog/libreta.jpeg",
              "/catalog/cuaderno.jpeg"
            ]}
            subProducts={[
              { name: "Planner Semanal A4 Acolchado", desc: "Block de 50 hojas abrochadas o encoladas para escritorio." },
              { name: "Organizadores Diarios To-Do", desc: "Formato alargado con listas de tareas y hábitos." }
            ]}
          />

          <!-- Nueva 2 -->
          <ProductCard
            id="shop-recetarios"
            title="Recetarios & Bitácoras de Viaje"
            description="Cuadernos temáticos diseñados para registrar recetas familiares, itinerarios o recuerdos."
            badge="Edición Especial"
            imageSrc="/catalog/cuaderno.jpeg"
            hoverImageSrc="/catalog/libreta.jpeg"
            galleryImages={[
              "/catalog/cuaderno.jpeg",
              "/catalog/libreta.jpeg"
            ]}
            subProducts={[
              { name: "Recetario Tapa Dura Anillado", desc: "Con divisiones por tipo de plato y bolsillo interno." },
              { name: "Bitácora de Viajes", desc: "Páginas mixtas para escribir, pegar pasajes y recuerdos." }
            ]}
          />

          <!-- Nueva 3 -->
          <ProductCard
            id="shop-laminas"
            title="Láminas Ilustradas & Prints A4/A3"
            description="Impresiones de alta resolución en papeles de gran gramaje con arte propio o ilustraciones personalizadas."
            badge="Decoración"
            imageSrc="/catalog/libreta.jpeg"
            hoverImageSrc="/catalog/cuaderno.jpeg"
            galleryImages={[
              "/catalog/libreta.jpeg",
              "/catalog/cuaderno.jpeg"
            ]}
            subProducts={[
              { name: "Lámina Ilustración Texturada", desc: "Impresión sobre papel obra o fotográfico mate de 240g." },
              { name: "Set de Láminas Temáticas", desc: "Combinaciones de 3 láminas para cuadros de pared." }
            ]}
          />

          <!-- Nueva 4 -->
          <ProductCard
            id="shop-memopads"
            title="Blocks de Notas & Notitas Adhesivas"
            description="Papelería complementaria para escritorios, agendas y cuadernos."
            badge="Papelería"
            imageSrc="/catalog/cuaderno.jpeg"
            hoverImageSrc="/catalog/libreta.jpeg"
            galleryImages={[
              "/catalog/cuaderno.jpeg",
              "/catalog/libreta.jpeg"
            ]}
            subProducts={[
              { name: "Block Memopad 10x10cm", desc: "50 hojas de papel de alto gramaje arrancables." },
              { name: "Mini Sticky Notes Ilustradas", desc: "Banderitas y notas adhesivas con diseños ilustrados." }
            ]}
          />
        </div>
      </section>
    </div>

    <div class="orbit-card opacity-0 rotate-x-3 translate-y-12 scale-95 transition-all duration-500 ease-out my-12">
      <Faq />
    </div>

    <div class="paper-footer-wrapper relative z-20 mt-12 sm:mt-16">
      <div class="w-full overflow-hidden leading-[0] rotate-180 bg-transparent -mb-1">
        <svg viewBox="0 0 1200 120" preserveAspectRatio="none" class="relative block w-full h-8 sm:h-12 fill-white/95">
          <path d="M0,0 L1200,0 L1200,20 L1180,45 L1150,25 L1100,55 L1060,30 L1020,50 L980,20 L940,45 L900,15 L850,50 L800,25 L750,55 L700,30 L650,50 L600,20 L550,45 L500,15 L450,55 L400,25 L350,50 L300,20 L250,45 L200,15 L150,55 L100,30 L50,50 L0,20 Z"></path>
        </svg>
      </div>

      <footer id="contacto" class="bg-white/95 backdrop-blur-md text-indigo-950 pb-12 pt-4 px-4 sm:px-6 relative">
        <div class="max-w-4xl mx-auto text-center flex flex-col items-center">
          
          <div class="mb-4 sm:mb-5 flex justify-center">
            <img 
              src="/logo.png" 
              alt="Ideas de la Luna Logo" 
              class="h-16 sm:h-20 w-auto object-contain transition-transform duration-300 hover:scale-105 opacity-90" 
            />
          </div>

          <h2 class="text-2xl sm:text-3xl font-serif mb-2 text-indigo-950 font-medium tracking-wide">
            ¿Tenés una idea fuera de órbita?
          </h2>
          <p class="text-slate-500 text-xs sm:text-sm max-w-sm mx-auto font-light mb-6 sm:mb-8 leading-relaxed">
            Hablemos de tu proyecto y creemos algo mágico juntos.
          </p>
          
          <div class="flex flex-col sm:flex-row justify-center items-center gap-3 sm:gap-4 w-full sm:w-auto">
            <a 
              href="https://api.whatsapp.com/send?phone=5493412141732&text=Hola!%20Vi%20tu%20web%20y%20me%20gustar%C3%ADa%20hacerte%20una%20consulta." 
              target="_blank"
              rel="noopener noreferrer"
              class="w-full sm:w-auto inline-flex items-center justify-center bg-[#10B981] hover:bg-[#059669] text-white font-semibold px-6 sm:px-8 py-3.5 rounded-full shadow-sm hover:shadow-md transition-all text-sm tracking-wide gap-2.5"
            >
              <span class="text-base">💬</span>
              Escríbenos por WhatsApp
            </a>

            <a 
              href="https://www.instagram.com/ideas.de.la.luna/" 
              target="_blank"
              rel="noopener noreferrer"
              class="w-full sm:w-auto inline-flex items-center justify-center bg-gradient-to-r from-[#A855F7] to-[#EC4899] hover:opacity-95 text-white font-semibold px-6 sm:px-8 py-3.5 rounded-full shadow-sm hover:shadow-md transition-all text-sm tracking-wide gap-2.5"
            >
              <span class="text-base">📸</span>
              Seguinos en Instagram
            </a>
          </div>

          <p class="text-xs text-slate-400 mt-10 sm:mt-14 font-light">
            © 2026 Ideas de la Luna. Todos los derechos reservados.
          </p>
        </div>
      </footer>
    </div>
  </main>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('a[href*="whatsapp.com"]').forEach(button => {
      button.addEventListener('click', (e) => {
        const card = button.closest('.product-card');
        const productName = card ? card.querySelector('h3')?.innerText : 'Consulta General';
        const sectionId = button.closest('section')?.id || 'general';

        if (typeof gtag === 'function') {
          gtag('event', 'product_inquiry', {
            product_name: productName,
            section: sectionId,
            event_category: 'engagement',
            event_label: `WhatsApp - ${productName}`
          });
        }
      });
    });
  });
</script>

<style>
  .perspective-container {
    perspective: 1200px;
  }
  
  .rotate-x-3 {
    transform: perspective(1200px) rotateX(4deg) translateY(3rem) scale(0.96);
  }

  .rotate-x-0 {
    transform: perspective(1200px) rotateX(0deg) translateY(0) scale(1);
  }

  .paper-footer-wrapper {
    filter: 
      drop-shadow(0px -10px 18px rgba(35, 25, 60, 0.12)) 
      drop-shadow(0px -2px 6px rgba(35, 25, 60, 0.08));
  }
</style>