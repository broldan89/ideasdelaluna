---
interface SubProduct {
  name: string;
  desc: string;
}

interface Props {
  id: string;
  title: string;
  description: string;
  badge: string;
  imageSrc: string;
  hoverImageSrc: string;
  galleryImages?: string[];
  subProducts?: SubProduct[];
  isProximamente?: boolean; // <-- Controla si el producto está en preparación
  proximamenteText?: string; // <-- Mensaje personalizado opcional
}

const { 
  id, 
  title, 
  description, 
  badge, 
  imageSrc, 
  hoverImageSrc, 
  galleryImages = [], 
  subProducts = [],
  isProximamente = false,
  proximamenteText = "En el taller de diseño"
} = Astro.props;

const allImages = galleryImages.length > 0 ? galleryImages : [imageSrc, hoverImageSrc].filter(Boolean);
---

<div class="bg-[#FAF8FC]/90 backdrop-blur-sm rounded-2xl overflow-hidden border border-[#EBE3F0] shadow-[0_4px_15px_rgba(100,70,150,0.03)] hover:shadow-md transition-all duration-300 flex flex-col group transform hover:-translate-y-1 w-full max-w-[320px]">
  
  <!-- CONTENEDOR DE LA IMAGEN CON BOTÓN DE GALERÍA -->
  <div class="relative overflow-hidden aspect-[16/10] bg-slate-100 w-full group/img">
    <img 
      src={imageSrc} 
      alt={title} 
      class="w-full h-full object-cover absolute inset-0 z-10 transition-opacity duration-500 group-hover/img:opacity-0"
    />
    <img 
      src={hoverImageSrc || imageSrc} 
      alt={`${title} detalle`} 
      class="w-full h-full object-cover absolute inset-0 z-0 transition-transform duration-500 scale-100 group-hover/img:scale-105"
    />
    
    <div class="absolute top-3 left-3 flex flex-col gap-1 z-20">
      <span class="bg-white/90 backdrop-blur-md text-slate-700 text-[9px] font-bold tracking-wider uppercase px-2 py-0.5 rounded-full shadow-sm w-fit">
        {badge}
      </span>
      {isProximamente && (
        <span class="bg-amber-100/90 backdrop-blur-md text-amber-900 border border-amber-200/60 text-[9px] font-semibold tracking-wide px-2 py-0.5 rounded-full shadow-sm w-fit">
          Próximamente
        </span>
      )}
    </div>

    <!-- BOTÓN PARA ABRIR CARRUSEL -->
    <button 
      id={`gallery-btn-${id}`}
      type="button"
      class="absolute bottom-3 right-3 bg-white/90 hover:bg-indigo-600 text-indigo-950 hover:text-white text-[10px] font-semibold px-3 py-1.5 rounded-full z-20 shadow-md backdrop-blur-md transition-all duration-300 flex items-center gap-1.5 hover:scale-105"
    >
      <span>📸</span> Ver Galería
    </button>
  </div>
  
  <div class="p-4 flex flex-col flex-grow">
    <!-- TÍTULO QUE DESPLIEGA LOS SUB-PRODUCTOS EN LA TARJETA -->
    <button id={`toggle-btn-${id}`} class="text-left w-full focus:outline-none group/title">
      <h3 class="font-serif text-lg text-indigo-950 font-medium group-hover/title:text-indigo-600 transition-colors flex items-center justify-between">
        {title}
        {subProducts.length > 0 && (
          <span class="text-xs text-indigo-400 group-hover/title:translate-y-0.5 transition-transform">▼</span>
        )}
      </h3>
    </button>

    <p class="text-slate-500 text-xs mt-1.5 flex-grow font-light leading-relaxed">{description}</p>
    
    <!-- SUB-CATÁLOGO DESPLEGABLE -->
    {subProducts.length > 0 && (
      <div id={`sub-${id}`} class="hidden mt-4 pt-3 border-t border-slate-100 space-y-2 animate-fade-in">
        <p class="text-[10px] font-bold text-indigo-600 tracking-wider uppercase">¿Qué incluye esta línea?</p>
        <div class="grid grid-cols-1 gap-1.5">
          {subProducts.map((sub) => (
            <div class="p-2 bg-slate-50 rounded-lg border border-slate-100 hover:border-indigo-100 transition-colors">
              <h4 class="text-[11px] font-semibold text-slate-800">{sub.name}</h4>
              <p class="text-[10px] text-slate-500 mt-0.5">{sub.desc}</p>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- ACCIÓN PRINCIPAL / BOTÓN -->
    <div class="mt-4 pt-3 border-t border-slate-50">
      {isProximamente ? (
        <button 
          type="button"
          disabled 
          class="w-full text-center bg-slate-100 border border-slate-200/80 text-slate-400 text-xs font-medium py-2.5 rounded-lg cursor-not-allowed select-none flex items-center justify-center gap-1.5"
        >
          <span>🎨</span> {proximamenteText}
        </button>
      ) : (
        <a 
          href={`https://api.whatsapp.com/send?phone=5493412141732&text=${encodeURIComponent('¡Hola! Me interesa obtener más información y cotizar la línea de: ' + title)}`} 
          target="_blank"
          rel="noopener noreferrer"
          class="w-full text-center block bg-slate-50 hover:bg-indigo-600 hover:text-white text-slate-700 text-xs font-semibold py-2.5 rounded-lg transition-all tracking-wider"
        >
          COTIZAR ESTA LÍNEA
        </a>
      )}
    </div>
  </div>
</div>

<script define:vars={{ id, title, allImages }}>
  const galleryBtn = document.getElementById(`gallery-btn-${id}`);
  const toggleBtn = document.getElementById(`toggle-btn-${id}`);
  const subMenu = document.getElementById(`sub-${id}`);

  galleryBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    window.dispatchEvent(new CustomEvent('open-gallery', {
      detail: { title, images: allImages }
    }));
  });

  toggleBtn?.addEventListener('click', () => {
    if (subMenu) {
      subMenu.classList.toggle('hidden');
    }
  });
</script>

<style>
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-5px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in {
    animation: fadeIn 0.3s ease-out forwards;
  }
</style>