---
const faqs = [
  {
    q: "¿Con cuánta anticipación debo realizar mi pedido?",
    a: "Al ser productos artesanales y personalizados, recomendamos realizar el pedido con al menos 7 a 10 días hábiles de anticipación. Para eventos grandes, 20 días es lo ideal."
  },
  {
    q: "¿Cómo les envío mi logo o diseño?",
    a: "Una vez realizada la consulta o pedido vía WhatsApp, nos puedes enviar tus archivos en formato PDF, AI, PNG o JPG de alta calidad por mail o chat."
  },
  {
    q: "¿Hacen envíos a todo el país?",
    a: "¡Sí! Enviamos a toda la Argentina a través de Correo Argentino y cadetería local según tu zona."
  },
  {
    q: "¿Tienen un mínimo de compra para stickers o papelería?",
    a: "No exigimos mínimos gigantescos; trabajamos desde planchas individuales A4 para emprendimientos que recién empiezan."
  }
];

// Generación de microdatos JSON-LD para SEO en Google
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};
---

<section id="faq" class="max-w-3xl mx-auto px-4 sm:px-6 py-12 scroll-mt-24">
  <div class="text-center mb-8 sm:mb-10">
    <h2 class="text-2xl sm:text-3xl font-serif text-indigo-950 font-medium">
      Preguntas <span class="italic text-indigo-600">Frecuentes</span>
    </h2>
    <p class="text-slate-500 text-xs sm:text-sm mt-2 font-light">
      Todo lo que necesitas saber antes de despegar tu proyecto con nosotros.
    </p>
  </div>

  <div class="space-y-3">
    {faqs.map((faq, index) => (
      <div class="border border-indigo-100/80 rounded-2xl bg-white/70 backdrop-blur-sm overflow-hidden shadow-sm transition-all duration-200">
        <button 
          type="button"
          class="faq-btn w-full px-5 sm:px-6 py-4 text-left font-serif text-indigo-950 font-medium text-sm sm:text-base flex justify-between items-center gap-4 hover:text-indigo-600 transition-colors focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:ring-offset-1 rounded-2xl"
          data-target={`faq-ans-${index}`}
          aria-expanded="false"
          aria-controls={`faq-ans-${index}`}
        >
          <span>{faq.q}</span>
          <span class="text-indigo-400 text-xs sm:text-sm font-sans transition-transform duration-300 icon shrink-0" aria-hidden="true">▼</span>
        </button>
        <div 
          id={`faq-ans-${index}`} 
          class="hidden px-5 sm:px-6 pb-4 text-slate-600 text-xs sm:text-sm font-light leading-relaxed border-t border-slate-100/60 pt-3"
        >
          {faq.a}
        </div>
      </div>
    ))}
  </div>
</section>

<!-- Script de Datos Estructurados para SEO -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.faq-btn');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-target');
      if (!targetId) return;
      
      const content = document.getElementById(targetId);
      const icon = btn.querySelector<HTMLElement>('.icon');
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';

      // Cerrar otros acordeones abiertos (opcional para mantener orden)
      buttons.forEach(otherBtn => {
        if (otherBtn !== btn) {
          otherBtn.setAttribute('aria-expanded', 'false');
          const otherTargetId = otherBtn.getAttribute('data-target');
          if (otherTargetId) {
            const otherContent = document.getElementById(otherTargetId);
            const otherIcon = otherBtn.querySelector<HTMLElement>('.icon');
            otherContent?.classList.add('hidden');
            if (otherIcon) otherIcon.style.transform = 'rotate(0deg)';
          }
        }
      });

      // Toggle del acordeón actual
      if (content) {
        content.classList.toggle('hidden');
        btn.setAttribute('aria-expanded', (!isExpanded).toString());
        
        if (icon) {
          icon.style.transform = !isExpanded ? 'rotate(180deg)' : 'rotate(0deg)';
        }
      }
    });
  });
</script>