---
---

<header class="sticky top-0 z-50 w-full backdrop-blur-md bg-white/70 border-b border-indigo-100/50 transition-all">
  <div class="max-w-7xl mx-auto px-6 md:px-12 py-3 grid grid-cols-3 items-center">
    
    <!-- 1. COLUMNA IZQUIERDA: LOGO CON IMAGEN/SVG -->
    <div class="flex items-center justify-start">
      <a href="/" class="flex items-center gap-2.5 group">
        <!-- Ícono / Logo de la marca -->
        <img 
          src="logo.png" 
          alt="Ideas de la Luna Logo" 
          class="w-7 h-7 object-contain transition-transform group-hover:rotate-12"
        />
        <span class="font-serif text-lg font-medium text-indigo-950 tracking-tight">
          Ideas de la <span class="italic text-indigo-600">Luna</span>
        </span>
      </a>
    </div>

    <!-- 2. COLUMNA CENTRAL: MENÚ SIMÉTRICO Y CENTRADO -->
    <nav class="flex justify-center items-center gap-6 sm:gap-8 text-xs font-semibold uppercase tracking-widest text-slate-600">
      <a href="#marcas" class="hover:text-indigo-600 transition-colors">Marcas</a>
      <a href="#eventos" class="hover:text-indigo-600 transition-colors">Eventos</a>
      <a href="#tienda" class="hover:text-indigo-600 transition-colors">Tienda</a>
      <a href="#faq" class="hover:text-indigo-600 transition-colors">FAQ</a>
    </nav>

    <!-- 3. COLUMNA DERECHA: BOTÓN CONTACTO -->
    <div class="flex items-center justify-end">
      <a 
        href="#contacto" 
        class="bg-indigo-950 hover:bg-indigo-900 text-white text-xs font-medium py-2.5 px-6 rounded-full transition-all shadow-sm hover:shadow-md hover:-translate-y-0.5"
      >
        Contacto
      </a>
    </div>

  </div>
</header>

<style>
  /* Wrapper sticky con la sombra que proyecta el papel rasgado del Navbar hacia abajo */
  .paper-navbar-wrapper {
    filter: 
      drop-shadow(0px 8px 12px rgba(45, 35, 66, 0.08)) 
      drop-shadow(0px 2px 4px rgba(45, 35, 66, 0.04));
  }

  /* Corte trozado de papel ÚNICAMENTE en el borde inferior del Navbar */
  .paper-navbar {
    clip-path: polygon(
      0% 0%, 
      100% 0%, 
      100% calc(100% - 4px), 
      97% 100%, 94% calc(100% - 3px), 91% 100%, 88% calc(100% - 2px), 85% 100%, 82% calc(100% - 4px), 
      79% 100%, 76% calc(100% - 2px), 73% 100%, 70% calc(100% - 3px), 67% 100%, 64% calc(100% - 1px), 
      61% 100%, 58% calc(100% - 3px), 55% 100%, 52% calc(100% - 2px), 49% 100%, 46% calc(100% - 4px), 
      43% 100%, 40% calc(100% - 2px), 37% 100%, 34% calc(100% - 3px), 31% 100%, 28% calc(100% - 1px), 
      25% 100%, 22% calc(100% - 3px), 19% 100%, 16% calc(100% - 2px), 13% 100%, 10% calc(100% - 4px), 
      7% 100%, 4% calc(100% - 2px), 0% 100%
    );
  }
</style>